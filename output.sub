(require-unqualified "values.sub")
(require rt "runtime.sub")
(require scheme "scheme.sub")
(require-unqualified std/test/test)

(provide expect-output expect-output-file)

(define (test-output [text datum] [message datum] [thunk datum]) -> datum
  (compare-output! (captured thunk) (datum->string text) (datum->string message))
  (cast datum 0))
(#%fact test-output '(foreign free))

(define (test-output-file [module datum] [file datum] [message datum] [thunk datum]) -> datum
  (compare-output-file! (captured thunk) (datum->string module) (datum->string file) (datum->string message))
  (cast datum 0))
(#%fact test-output-file '(foreign free))

(define (captured [thunk datum]) -> string
  (let ([b (new 0 (make-buffer))] [before (ptr buffer) 0])
    (rt:port-flush (rt:stdout-port))
    (set! before (output-to! b))
    (drop (rt:call-closure thunk 0 (cast datum 0) (cast datum 0) (cast datum 0) (cast datum 0)))
    (rt:port-flush (rt:stdout-port))
    (output-to! before)
    (buffer-string b)))

(begin-for-syntax
  (require-unqualified compiler/macros)

  (define (expect-output-form [s datum]) -> datum
    (syntax-match s
      [(_ text body ...) #`(test-output #,text #,(output-text s text) (scheme:lambda () #,@body))]
      [_ (raise-syntax-error 'expect-output "expected (expect-output \"text\" body ...)" s)]))

  (define (expect-output-file-form [s datum]) -> datum
    (syntax-match s
      [(_ file body ...)
       #`(test-output-file #,(text-at s (string->datum (symbol->string (syntax-source s)))) #,file #,(output-text s file)
                           (scheme:lambda () #,@body))]
      [_ (raise-syntax-error 'expect-output-file "expected (expect-output-file \"path\" body ...)" s)]))

  (define (text-at [s datum] [d datum]) -> datum (datum->syntax s d s))

  (define (output-text [s datum] [first datum]) -> datum
    (text-at s (format "~a:~a: (~a ~s ...)" `(,(syntax-source s) ,(syntax-line s) ,(syntax-e (car (syntax->list s))) ,(syntax->datum first))))))

(define-syntax expect-output expect-output-form)
(define-syntax expect-output-file expect-output-file-form)
