;; syntax-rules for Scheme: pattern macros compiled into Substrate transformers.

(require macros compiler/macros _ ... ?)
(require v "values.sub" quote)
(begin-for-syntax
  (require-unqualified macros compiler/macros))

(provide syntax-rules define-rules)

(begin-for-syntax
  (define temps i32 0)

  (define (temp [base datum]) -> datum
    (+= temps 1)
    (datum->syntax #'here (string->symbol (format-message "~a~a" `(,base ,(make-integer temps)))) 0))

  (define (temps-for [l datum] [base datum]) -> datum
    (if (null? l) nil (cons (temp base) (temps-for (cdr l) base))))

  (define (rules-only [s datum]) -> datum (raise-syntax-error 0 "allowed only in define-syntax" s))

  (define (ellipsis? [x datum]) -> bool (and (identifier? x) (free-identifier=? x #'...)))
  (define (wildcard? [x datum]) -> bool (and (identifier? x) (free-identifier=? x #'_)))

  (define (literal? [x datum] [literals datum]) -> bool
    (while (pair? literals)
      (if (free-identifier=? x (car literals)) (return #t))
      (set! literals (cdr literals)))
    #f)

  (define (quoted? [x datum]) -> bool
    (let ([l (syntax->list x)])
      (and l (== (length l) 2) (identifier? (car l)) (free-identifier=? (car l) #'quote))))

  (define (rule-pattern [p datum] [literals datum]) -> datum
    (cond [(identifier? p)
           (cond [(wildcard? p) #'_]
                 [(ellipsis? p) #'...]
                 [(free-identifier=? p #'?)
                  (raise-syntax-error 'syntax-rules "a pattern of syntax-rules has no checks" p)]
                 [(literal? p literals) #`(quote-syntax #,p)]
                 [else p])]
          [(quoted? p) #`(quote #,(cadr (syntax->list p)))]
          [(pair? (syntax-e p)) (syntax-rewrap p (rule-chain (syntax-e p) literals))]
          [else p]))

  (define (rule-chain [l datum] [literals datum]) -> datum
    (cond [(syntax? l) (rule-pattern l literals)]
          [(pair? l) (cons (rule-pattern (car l) literals) (rule-chain (cdr l) literals))]
          [else l]))

  (define (pattern-variables [p datum] [literals datum] [depth i32]) -> datum
    (cond [(identifier? p)
           (if (or (wildcard? p) (ellipsis? p) (literal? p literals)) nil `((,p . ,(make-integer depth))))]
          [(quoted? p) nil]
          [(pair? (syntax-e p)) (chain-variables (syntax-e p) literals depth)]
          [else nil]))

  (define (chain-variables [l datum] [literals datum] [depth i32]) -> datum
    (cond [(syntax? l) (pattern-variables l literals depth)]
          [(not (pair? l)) nil]
          [(and (pair? (cdr l)) (ellipsis? (car (cdr l))))
           (append (pattern-variables (car l) literals (+ depth 1)) (chain-variables (cdr (cdr l)) literals depth))]
          [else (append (pattern-variables (car l) literals depth) (chain-variables (cdr l) literals depth))]))

  (define (variable-of [x datum] [vars datum]) -> datum
    (while (pair? vars)
      (if (== (syntax-e (car (car vars))) (syntax-e x)) (return (car vars)))
      (set! vars (cdr vars)))
    0)

  (define (depth-of [v datum]) -> i64 (integer-value (cdr v)))

  (define (distinct [vars datum]) -> datum
    (let ([l vars])
      (while (pair? l)
        (let ([v (variable-of (car (car l)) (cdr l))])
          (if v (raise-syntax-error 'syntax-rules "this pattern variable appears twice in its pattern" (car v))))
        (set! l (cdr l))))
    vars)

  (define (template-variables [t datum] [vars datum] [repeated bool] [acc datum]) -> datum
    (cond [(identifier? t)
           (let ([v (variable-of t vars)])
             (if (and v (or (not repeated) (> (depth-of v) 0)) (not (memq v acc))) (cons v acc) acc))]
          [(syntax? t) (template-variables (syntax-e t) vars repeated acc)]
          [(pair? t) (template-variables (cdr t) vars repeated (template-variables (car t) vars repeated acc))]
          [else acc]))

  (define (template-code [t datum] [vars datum]) -> datum
    (cond [(identifier? t)
           (let ([v (variable-of t vars)])
             (cond [(not v) #`(quote-syntax #,t)]
                   [(> (depth-of v) 0)
                    (raise-syntax-error 'syntax-rules "this pattern variable matched under ..., so ... must follow it" t)]
                   [else (car v)]))]
          [(null? (template-variables t vars #f nil)) #`(quote-syntax #,t)]
          [else #`(syntax-rewrap (quote-syntax #,t) #,(chain-code (syntax-e t) vars))]))

  (define (chain-code [l datum] [vars datum]) -> datum
    (cond [(syntax? l) (template-code l vars)]
          [(null? l) #'nil]
          [(and (pair? (cdr l)) (ellipsis? (car (cdr l))))
           #`(append #,(repeat-code (car l) vars) #,(chain-code (cdr (cdr l)) vars))]
          [else #`(cons #,(template-code (car l) vars) #,(chain-code (cdr l) vars))]))

  (define (repeat-code [t datum] [vars datum]) -> datum
    (let ([rs (template-variables t vars #t nil)])
      (if (null? rs) (raise-syntax-error 'syntax-rules "no pattern variable before this ... matched under one" t))
      (let ([acc (temp '"acc")] [ls (temps-for rs '"l")])
        #`(let ([#,acc datum nil] #,@(list-bindings ls rs))
            (while (pair? #,(car ls))
              (let (#,@(element-bindings rs ls))
                (set! #,acc (cons #,(template-code t (shallower vars rs)) #,acc)))
              #,@(list-steps ls))
            (reverse #,acc)))))

  (define (list-bindings [ls datum] [rs datum]) -> datum
    (if (null? ls) nil (cons #`[#,(car ls) datum #,(car (car rs))] (list-bindings (cdr ls) (cdr rs)))))

  (define (element-bindings [rs datum] [ls datum]) -> datum
    (if (null? rs) nil (cons #`[#,(car (car rs)) datum (car #,(car ls))] (element-bindings (cdr rs) (cdr ls)))))

  (define (list-steps [ls datum]) -> datum
    (if (null? ls) nil (cons #`(set! #,(car ls) (cdr #,(car ls))) (list-steps (cdr ls)))))

  (define (shallower [vars datum] [rs datum]) -> datum
    (cond [(null? vars) nil]
          [(memq (car vars) rs)
           (cons (cons (car (car vars)) (make-integer (- (depth-of (car vars)) 1))) (shallower (cdr vars) rs))]
          [else (cons (car vars) (shallower (cdr vars) rs))]))

  (define (rule-clauses [cs datum] [literals datum]) -> datum
    (if (null? cs)
        nil
        (cons (syntax-match (car cs)
                [(pattern template)
                 (syntax-match pattern
                   [(_ . rest)
                    #`[#,(syntax-rewrap pattern (cons #'_ (rule-chain rest literals)))
                       #,(template-code template (distinct (chain-variables rest literals 0)))]]
                   [_ (raise-syntax-error 'syntax-rules "expected a pattern (name pattern ...)" pattern)])]
                [c (raise-syntax-error 'syntax-rules "expected a clause: [pattern template]" c)])
              (rule-clauses (cdr cs) literals))))

  (define (define-rules-form [s datum]) -> datum
    (syntax-match s
      [(_ name ((? identifier? literal) ...))
       (let ([t (temp '"rules")])
         #`(begin
             (begin-for-syntax
               (define (#,t [s datum]) -> datum (raise-syntax-error 0 "bad syntax: this macro has no patterns" s)))
             (define-syntax #,name #,t)))]
      [(_ name ((? identifier? literal) ...) clause ...)
       (let ([t (temp '"rules")])
         #`(begin
             (begin-for-syntax
               (define (#,t [s datum]) -> datum (syntax-match s #,@(rule-clauses clause literal))))
             (define-syntax #,name #,t)))]
      [_ (raise-syntax-error 'syntax-rules "expected (syntax-rules (literal ...) [pattern template] ...)" s)])))

(define-syntax syntax-rules rules-only)
(define-syntax define-rules define-rules-form)
