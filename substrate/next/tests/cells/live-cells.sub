;; Substrate on cells frees what it is done with (next/cells/lower.sub):
;; each value has owners, counted in its cell, and a program drops a
;; value where its last owner is done with it. So once a computation's
;; results are printed and dropped, no more cells of the heap are in use
;; than before it: each check prints the difference in (live-cells), 0.
(require-unqualified substrate "../../cells/substrate.sub")

(define (check name thunk)
  (let ([before (live-cells)])
    (thunk)
    (display name) (display ": ") (display (- (live-cells) before)) (newline)))

;; A thunk made where check is called would be freed inside it, as its
;; last owner, check, is done with it: each thunk is a definition.
(define (locals-10) (locals 10))

;; Lists: built, walked, mapped, filtered, folded, sorted, reversed,
;; appended, and dropped.
(define (lists)
  (let* ([xs (let loop ([i 0] [acc '()]) (if (= i 200) acc (loop (+ i 1) (cons i acc))))]
         [ys (map (lambda (x) (* x x)) xs)]
         [zs (filter even? ys)]
         [total (foldl + 0 zs)]
         [sorted (sort (reverse xs) <)])
    (display (list (length xs) (length zs) total (car sorted) (last sorted) (length (append xs ys zs))))
    (newline)))

;; Closures: counters sharing a boxed variable, functions returning
;; functions, and a closure that outlives the call that made it.
(define (make-counter)
  (let ([count 0])
    (lambda () (set! count (+ count 1)) count)))

(define (compose f g) (lambda (x) (f (g x))))

(define (closures)
  (let ([c (make-counter)] [d (make-counter)])
    (c) (c) (d)
    (display (list (c) (d) ((compose (lambda (x) (+ x 1)) (lambda (x) (* x 2))) 20)))
    (newline)))

;; Local functions: a named let, a loop assigning a captured variable, a
;; let-bound lambda called twice, and mutual recursion between local
;; functions, each called directly.
(define (locals n)
  (let ([count 0])
    (let loop ([i 0]) (when (< i n) (set! count (+ count i)) (loop (+ i 1))))
    (let ([double (lambda (y) (* 2 y))])
      (letrec ([ev? (lambda (k) (if (= k 0) #t (od? (- k 1))))]
               [od? (lambda (k) (if (= k 0) #f (ev? (- k 1))))])
        (display (list count (double (double n)) (ev? n) (od? n)))
        (newline)))))

;; Strings, symbols and characters: new strings made and dropped.
(define (strings)
  (let* ([s (string-append "hello" ", " "world")]
         [parts (map (lambda (c) (string c)) (string->list s))]
         [back (apply string-append parts)])
    (display (list (string-utf-8-length s) (string=? s back) (symbol->string 'sym) (string->symbol "made")))
    (newline)))

;; Vectors, boxes and byte strings.
(define (vectors)
  (let ([v (make-vector 5 '(shared))] [b (box '(a b))])
    (vector-set! v 0 (list 1 2 3))
    (set-box! b (vector-ref v 0))
    (display (list (vector->list (vector-copy v 0 2)) (unbox b) (bytes->list (bytes 1 2 3)) (vector-length v)))
    (newline)))

;; Hash tables: set, updated, removed from, walked, and dropped.
(define (tables)
  (let ([t (make-hash)] [e (make-hasheq)])
    (hash-set! t "one" (list 1))
    (hash-set! t "two" (list 2))
    (hash-set! t "one" (list 1 1))
    (hash-update! t "two" (lambda (v) (cons 2 v)))
    (hash-set! e 'a 1)
    (hash-remove! e 'a)
    (display (list (hash-ref t "one") (hash-ref t "two") (hash-count e) (sort (hash-keys t) string<?)))
    (newline)
    (hash-clear! t)))

;; Structs: made, read, set, matched, and dropped.
(struct point (x [y #:mutable]))

(define (structs)
  (let ([p (point (list 1) (list 2))])
    (set-point-y! p (list 3 4))
    (display (list (point-x p) (point-y p) (point? p) (match p [(point a b) (append a b)])))
    (newline)))

;; Integers past the fixnum range and flonums are cells: arithmetic and
;; reading make them, and they are dropped.
(define (numbers)
  (let loop ([i 0] [big 1] [sum 0])
    (if (< i 38)
        (loop (+ i 1) (* big 3) (+ sum (* big 2)))
        (begin (display (list (> big 1000000000000) (quotient sum big) (string->number "2.5")
                              (number->string (string->number "1e3"))))
               (newline)))))

;; apply, rest arguments, and many arguments: lists made for calls and
;; dropped.
(define (many a b c d e f) (list a b c d e f))
(define (rest-args . xs) (length xs))

(define (calls)
  (display (list (apply many 1 2 3 4 '(5 6)) (rest-args (list 1) (list 2)) (apply + (list 1 2 3))))
  (newline))

;; Exceptions: a handler takes the raised value, and the thunk's own
;; values are dropped.
(define (exceptions)
  (display (with-handlers ([pair? (lambda (v) (car v))]) (raise (list 'raised))))
  (newline))

;; Compile time: a macro, Substrate code the expander runs in the heap,
;; makes lists, strings, closures and a table and drops them, and expands
;; to the cells left in use after it, 0.
(begin-for-syntax (require-unqualified substrate "../../cells/substrate.sub"))
(define-syntax (compile-time stx)
  (let ([before (live-cells)])
    (let* ([xs (let loop ([i 0] [acc '()]) (if (= i 100) acc (loop (+ i 1) (cons i acc))))]
           [t (make-hasheq)])
      (for-each (lambda (x) (hash-set! t x (list (number->string x) (lambda () x)))) xs)
      (hash-clear! t))
    (datum->syntax stx (list 'quote (- (live-cells) before)) stx)))
(define (at-compile-time) (display (compile-time)) (newline))

(define (main)
  (check "lists" lists)
  (check "closures" closures)
  (check "locals" locals-10)
  (check "strings" strings)
  (check "vectors" vectors)
  (check "tables" tables)
  (check "structs" structs)
  (check "numbers" numbers)
  (check "calls" calls)
  (check "exceptions" exceptions)
  (check "compile time" at-compile-time))
