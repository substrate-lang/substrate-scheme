;; A parameter a function only reads is borrowed without being marked
;; (next/cells/lower.sub, infer-module!): its callers keep their values
;; through the call and the body drops nothing, so walking a list counts
;; nothing; and a parameter stays owned where the body stores, returns,
;; captures or assigns its value, or a tail call gives it a value that
;; is not read where it is. Each check prints a result and the difference
;; in (live-cells) after it, 0: nothing leaks and nothing is freed twice
;; either way. The flags come from the functions' facts.
(require-unqualified substrate "../../cells/substrate.sub")
(require-unqualified more "fixtures/borrowed-more.sub")

(define (check name thunk)
  (let ([before (live-cells)])
    (display name) (display ": ") (display (thunk))
    (display " ") (display (- (live-cells) before)) (newline)))

;; Read only: l is borrowed.
(define (sum l) (if (null? l) 0 (+ (car l) (sum (cdr l)))))
(define (summing) (sum (list 1 2 3 4)))

;; Recursion over a list: a is borrowed, b owned, consed onto.
(define (rev-onto a b) (if (null? a) b (rev-onto (cdr a) (cons (car a) b))))
(define (reversing) (rev-onto (list 1 2 3) '()))

;; Stored: x is owned.
(define kept '())
(define (keep! x) (set! kept (cons x kept)) (length kept))
(define (keeping) (let ([n (keep! (list 7))]) (set! kept '()) n))

;; Returned, captured, assigned: owned.
(define (same x) x)
(define (adder n) (lambda (x) (+ x n)))
(define (bump x) (set! x (cons 0 x)) (length x))
(define (returning) (same (list 5)))
(define (capturing) ((adder 3) 4))
(define (assigning) (bump (list 1 2)))

;; A tail call giving a value made for it: to a function that cannot
;; come back to this one, no matter, the value dropped after the call
;; (count-all stays borrowed); in a loop, the parameter stays owned,
;; so that the call is a tail call still (b of rev-onto, above).
(define (count-all l) (if (null? l) 0 (+ 1 (count-all (cdr l)))))
(define (count-twice l) (count-all (append l l)))
(define (tail) (count-twice (list 1 2 3)))

;; Through a closure, apply and map: the value's code drops the
;; borrowed argument after the call.
(define (applying) (apply sum (list (list 1 2 3))))
(define (mapping) (map sum (list (list 1) (list 2 3))))

;; A global given to a borrowed parameter is read where it is.
(define g (list 1 2 3 4))
(define (of-global) (sum g))

;; A case-lambda's first clause is the function.
(define measure (case-lambda [(l) (sum l)] [(l m) (+ (sum l) (sum m))]))
(define (measuring) (list (measure (list 1 2) (list 3)) (measure (list 4))))

;; A call giving a borrowed parameter a value made for it, after an
;; operand that calls a closure the value's making uses for the last
;; time: the operands run in order still, the closure alive through
;; both (lower.sub, rw-call).
(define (joined s f as) (foldl (lambda (a acc) (list acc a s)) f as))
(define (ordered e env)
  (let ([r (lambda (x) (+ x env))])
    (match e [(f arg ...) (joined 's (r f) (map r arg))] [_ 'no])))
(define (in-order) (ordered (list 1 2 3) 10))

;; Another module's functions, their flags from their facts.
(define (across) (list (total (list 1 2 3)) (pair-up (list 1) 2)))

;; (borrows f): the flags f's fact gives, 1 for a borrowed parameter.
(begin-for-syntax
  (require k kernel)
  (func (borrows-form [stx i32]) -> i32
    (let ([fs (k:syntax-local-facts (k:cadr (k:syntax->list stx)))])
      (block done
        (loop next
          (br-if done (i32.eqz (k:pair? fs)))
          (let ([v (k:syntax->datum (k:caddr (k:car fs)))])
            (if (if (k:pair? v) (i32.eq (k:car v) 'substrate-function) 0)
                (return (k:datum->syntax stx (k:cons 'quote (k:cons (k:cdr v) '())) stx))))
          (set! fs (k:cdr fs))
          (br next)))
      (k:datum->syntax stx '(quote none) stx))))
(define-syntax borrows borrows-form)
(define (flags)
  (list (borrows sum) (borrows rev-onto) (borrows keep!) (borrows same) (borrows adder) (borrows bump)
        (borrows count-all) (borrows measure) (borrows total) (borrows pair-up)))

(define (main)
  (check "sum" summing)
  (check "rev-onto" reversing)
  (check "keep!" keeping)
  (check "same" returning)
  (check "adder" capturing)
  (check "bump" assigning)
  (check "tail" tail)
  (check "apply" applying)
  (check "map" mapping)
  (check "global" of-global)
  (check "case-lambda" measuring)
  (check "order" in-order)
  (check "across" across)
  (check "flags" flags))
