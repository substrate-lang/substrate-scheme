;; Compile-time code runs at once, in source order (spec 3.1): a and c,
;; calls of an instantiated function on quoted data, which the expander
;; makes itself, and the begin-for-syntax between them, which it compiles.
(require-unqualified substrate "../../substrate/substrate.sub")
(begin-for-syntax
  (require k kernel)
  (global order (mut i32) '())
  (func (note [x i32]) -> i32 (set! order (k:cons x order)) x)
  (func (order-of [stx i32]) -> i32
    (k:datum->syntax stx (k:cons 'quote (k:cons (k:reverse order) '())) stx)))
(define-syntax a (note 'a))
(begin-for-syntax (drop (note 'b)))
(define-syntax c (note 'c))
(define-syntax order order-of)

(define (run) (write (order)) (newline))
(func (main) (run))
