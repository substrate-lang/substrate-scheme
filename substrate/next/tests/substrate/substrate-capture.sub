;; A Substrate lambda in a kernel function captures a variable, a Substrate
;; value (a fixnum here, made of the i32 parameter) it also assigns: its
;; calls share it, in a box (next/substrate/lower.sub).
(require-unqualified substrate "../../substrate/substrate.sub")
(func (count-from [n i32]) -> i32 (let ([v (fixnum n)]) (lambda () (set! v (+ v v)) v)))
(define (run) (let ([c (count-from (i32.const 3))]) (c) (display (c)) (newline)))
(func (main) (run))
