;; A Substrate lambda in a kernel function captures a parameter of another
;; type than eqref, an i32 it also assigns: the kernel boxes it (spec 5.3).
(require-unqualified substrate "../../substrate/substrate.sub")
(func (count-from [n i32]) -> eqref (lambda () (set! n (i32.add n n)) (ref.i31 n)))
(define (run) (let ([c (count-from (i32.const 3))]) (c) (display (c)) (newline)))
(func (main) (run))
