;; quote and quasiquote (next/substrate/data.sub) in kernel code, on
;; Substrate's data, as tests/quote.sub, but that data has no syntax
;; objects: a template nests, and quoted symbols are interned.
(require d "../../substrate/data.sub" quote quasiquote)
(require print "../../../lib/print.sub" write-int newline)
(require sub "../../substrate/substrate.sub" write)

(func (main)
  (write '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f ())) (newline)
  (let ([xs '(a b)] [n (d:fixnum 7)])
    (write `(list ,@xs ,n (nested ,(d:car xs)) end)) (newline)
    (write `(1 `(2 ,(3 ,n)))) (newline)
    (write `(dotted . ,n)) (newline))
  (write-int (ref.eq 'abc (d:string->symbol (d:symbol->string 'abc)))) (newline)
  (write-int (d:length '(1 2 3))) (newline)
  (write (d:append '(1 2) '(3))) (newline)
  (write (d:reverse '(1 2 3))) (newline)
  (write (d:symbol-append 'foo- 'bar)) (newline)
  (write '"λ unicode ✓") (newline)
  (write-int (d:string-length '"λ")) (newline))
