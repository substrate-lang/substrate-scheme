;; Quoted fixnums, #f, '() and #t are constant expressions (spec 5.2), so
;; immutable globals can hold them, as tests/quoted-constants.sub. Other
;; quoted data (next/substrate/data.sub's quote) is made when the module
;; starts, so its global must be mutable.
(require d "../../substrate/data.sub" quote)
(require print "../../../lib/print.sub" newline)
(require sub "../../substrate/substrate.sub" write)

(global empty eqref '())
(global yes eqref '#t)
(global no eqref '#f)
(global five eqref '5)
(global built (mut eqref) '(1 2))

(func (main)
  (write (d:cons five (d:cons yes (d:cons no empty)))) (print:newline)
  (write built) (print:newline))
