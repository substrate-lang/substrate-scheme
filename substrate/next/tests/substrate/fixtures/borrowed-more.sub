;; Functions another module calls (borrowed.sub): total reads its
;; parameter, so it is inferred borrowed (next/substrate/lower.sub), which
;; the function's fact tells the caller; pair-up keeps both of its.
(require-unqualified substrate "../../../substrate/substrate.sub")
(provide total pair-up)

(define (total l) (if (null? l) 0 (+ (car l) (total (cdr l)))))
(define (pair-up x y) (cons x y))
