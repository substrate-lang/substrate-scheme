;; Fixture: pattern macros, exported to other modules. (while test body
;; ...) loops; (for x in list body ...) walks a list, checking its in by
;; binding.
(require-unqualified substrate "../../../substrate/substrate.sub")
(provide while for in)

(define-syntax while
  (syntax-rules ()
    [(_ test body ...) (let loop () (when test body ... (loop)))]))

;; in is compared by binding, and is no form of its own.
(define-syntax in (syntax-rules ()))

(define-syntax for
  (syntax-rules (in)
    [(_ x in list body ...) (for-each (lambda (x) body ...) list)]))
