;; Quoted data (next/substrate/data.sub's quote) is made when the module
;; starts, as tests/quoted-data.sub: each kind of datum survives, and equal
;; symbols are one reference.
(require d "../../substrate/data.sub" quote)
(require print "../../../lib/print.sub" write-int newline)
(require sub "../../substrate/substrate.sub" write)

(func (show [x eqref]) (write x) (print:newline))

(func (main)
  (show '(a "b" #\c -7 1073741824 -9223372036854775808 18446744073709551615 (#t #f ()) 2.5))
  (show '(lambda (x) (f x "s" 3)))
  (print:write-int (ref.eq 'same 'same)) (print:newline)
  (print:write-int (f64.eq (d:flonum-value '2.5) 2.5)) (print:newline))
