;; Closures in Substrate (next/substrate/substrate.sub): capturing, shared assigned
;; variables (boxes), higher-order functions, named let loops in constant
;; stack, nested lambdas, mutual recursion, and set!, whose value is #f.
;; A lambda works anywhere, also in a kernel function, where it captures
;; variables holding Substrate values.
(require-unqualified substrate "../../substrate/substrate.sub")

(define (make-adder n) (lambda (x) (+ x n)))

(define (make-counter)
  (let ([count 0])
    (lambda () (set! count (+ count 1)) count)))

(define (map-list f xs)
  (if (null? xs) '() (cons (f (car xs)) (map-list f (cdr xs)))))

(define (sum-to n)
  (let loop ([i 1] [acc 0])
    (if (> i n) acc (loop (+ i 1) (+ acc i)))))

(define (curry3 a) (lambda (b) (lambda (c) (+ a (* b c)))))

;; n, a fixnum, is in the closure; the assigned m is boxed.
(func (adder-of [n i32]) -> i32 (lambda (x) (+ x n)))
(func (adder-of-fixnum [v i32]) -> i32 (adder-of v))
(func (counter-from [m i32]) -> i32 (lambda () (set! m (+ m 1)) m))

(define (is-even? n) (if (= n 0) #t (is-odd? (- n 1))))
(define (is-odd? n) (if (= n 0) #f (is-even? (- n 1))))

(define (run)
  (display ((make-adder 3) 4)) (newline)
  (let ([c (make-counter)] [d (make-counter)])
    (c) (c) (d)
    (display (cons (c) (cons (d) '()))) (newline))
  (display (map-list (lambda (x) (* x x)) '(1 2 3 4))) (newline)
  (display (sum-to 100000)) (newline)
  (display (((curry3 1) 2) 3)) (newline)
  (display (is-even? 10)) (newline)
  (let ([x 1]) (display (cons (set! x 2) (cons x (quote ()))))) (newline)
  (display ((adder-of-fixnum 5) 10)) (newline)
  (let ([c (counter-from 10)]) (c) (display (c))) (newline))

(func (main) (run))
