;; Strings and symbols: appending, conversions, interning, format. Untuned.
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(define (count-digits s)
  (let loop ([cs (string->list s)] [n 0])
    (cond [(null? cs) n]
          [(char-numeric? (car cs)) (loop (cdr cs) (+ n 1))]
          [else (loop (cdr cs) n)])))
(define (main)
  (let loop ([i 0] [total 0] [syms '()])
    (if (< i 100000)
        (let* ([s (string-append "item-" (number->string i) ":" (symbol->string 'value))]
               [t (format "~a/~s" s (remainder i 7))])
          (loop (+ i 1) (+ total (count-digits t) (string-utf-8-length s))
                (if (= (remainder i 1000) 0) (cons (string->symbol s) syms) syms)))
        (begin (display (list total (length syms) (car syms))) (newline)))))
