;; Closures, structs and hash tables: counters, composed functions, a
;; struct per step, a table of counts, in loops.
(require-unqualified substrate "../../lib/substrate/substrate.sub")

(struct pt (x y))

(define (make-counter)
  (let ([count 0])
    (lambda () (set! count (+ count 1)) count)))

(define (compose f g) (lambda (x) (f (g x))))

(define (step i table)
  (let* ([p (pt i (* i 2))]
         [k (remainder (pt-x p) 97)]
         [f (compose (lambda (x) (+ x (pt-y p))) (lambda (x) (* x 3)))])
    (hash-update! table k (lambda (v) (+ v (f 1))) 0)
    (pt-y p)))

(define (main)
  (let ([c (make-counter)] [table (make-hasheq)])
    (let loop ([i 0] [acc 0])
      (if (< i 300000)
          (loop (+ i 1) (+ acc (step i table) (c)))
          (begin (display (list acc (hash-count table) (hash-ref table 5))) (newline))))))
