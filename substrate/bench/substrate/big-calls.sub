;; Closure calls.
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(define (make-adder n) (lambda (x) (+ x n)))
(define (main)
  (let ([f (make-adder 3)])
    (let loop ([i 0] [acc 0])
      (if (< i 10000000)
          (loop (+ i 1) (f acc))
          (begin (display acc) (newline))))))
