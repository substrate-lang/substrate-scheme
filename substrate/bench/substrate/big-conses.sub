;; Lists made and dropped: cons and free per element.
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(define (range n) (let loop ([i (- n 1)] [acc '()]) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (main)
  (let loop ([i 0] [acc 0])
    (if (< i 1500)
        (loop (+ i 1) (+ acc (length (range 20000))))
        (begin (display acc) (newline)))))
