;; Lists made once and walked many times.
(require-unqualified scheme "../../lib/scheme/scheme.sub")
(define (range n) (let loop ([i (- n 1)] [acc '()]) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (sum l) (let loop ([l l] [n 0]) (if (pair? l) (loop (cdr l) (+ n (car l))) n)))
(define (main)
  (let ([xs (range 20000)])
    (let loop ([i 0] [acc 0])
      (if (< i 1500)
          (loop (+ i 1) (+ acc (sum xs)))
          (begin (display acc) (newline))))))
