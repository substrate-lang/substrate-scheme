;; Lifecycle: permanent.
;;
;; Small blocks of memory for the nodes of languages written in the C-like
;; Lisp: Substrate's values (lib/substrate/values.sub) and Bend's terms
;; (lib/bend/runtime.sub) both come from here.
;;
;; Blocks of up to 256 bytes are kept on free lists, one for each size in
;; 4-byte words, and new ones are cut from 64 KiB chunks taken with sbrk.
;; Larger blocks come from malloc. A block is at least 8 bytes. A free
;; block is linked through its second word, so its first word, which a
;; language may use as a header, is left as it was. Blocks of an even
;; number of words are 8-byte aligned, for 64-bit fields.
;;
;;   (node-alloc n)     n bytes. Inline (spec 5.2), so when the list for
;;                      its size is not empty, a call is a few loads and a
;;                      store in the caller's code.
;;   (node-free p n)    gives back the n bytes at p, from node-alloc;
;;                      inline
;;   (nodes-live)       how many blocks are handed out and not given back:
;;                      what a program can leak
;;   (node-pop k), (node-push p k)
;;                      the same for a size of k words, 2 to 64, known
;;                      when the caller is compiled; inline
;;   (node-words n)     the size in words that n bytes take
;;   node-lists         the lists' heads, an array of addresses indexed by
;;                      size in words, for a language that inlines a fast
;;                      path of its own
(require-unqualified lang "lang.sub")
(require-unqualified runtime "runtime.sub")

(provide node-alloc node-free node-pop node-push nodes-live node-words node-lists)

(memory from lang)
(table from lang)

(define chunk-size u32 65536)

;; The heads of the free lists, by size in words: an address, or 0.
(define node-lists (array u32 65))
;; Where the next block is cut from, and the end of its chunk.
(define node-next u32 0)
(define node-end u32 0)
;; Blocks cut from chunks, and blocks from malloc not yet given back.
(define nodes-cut u32 0)
(define nodes-large u32 0)

(define (node-words [n u32]) #:inline -> u32
  (let ([k (>> (+ n 3) 2)]) (if (< k 2) 2 k)))

;; A block of k words, 2 to 64, and one given back: what node-alloc and
;; node-free do once they know the size. A caller that knows its sizes
;; when it is compiled calls these with the size in words.
(define (node-pop [k u32]) #:inline -> (ptr void)
  (let ([h (@ node-lists k)])
    (if (!= h 0)
        (begin
          (set! (@ node-lists k) (@ (cast (ptr u32) h) 1))
          (cast (ptr void) h))
        (node-cut k))))

(define (node-push [p (ptr void)] [k u32]) #:inline
  (let ([q (cast (ptr u32) p)])
    (set! (@ q 1) (@ node-lists k))
    (set! (@ node-lists k) (cast u32 q))))

(define (node-alloc [n u32]) #:inline -> (ptr void)
  (let ([k (node-words n)])
    (if (<= k 64) (node-pop k) (node-large n))))

(define (node-free [p (ptr void)] [n u32]) #:inline
  (let ([k (node-words n)])
    (if (<= k 64) (node-push p k) (node-free-large p))))

;; A block of k words cut from the chunk, when its list is empty.
(define (node-cut [k u32]) -> (ptr void)
  (let ([size (<< k 2)])
    (when (== (bit-and k 1) 0) (set! node-next (bit-and (+ node-next 7) 4294967288)))
    (when (> (+ node-next size) node-end)
      (set! node-next (cast u32 (sbrk (cast i32 chunk-size))))
      (when (== node-next 0) (return (cast (ptr void) 0)))
      (set! node-end (+ node-next chunk-size)))
    (let ([p node-next])
      (+= node-next size)
      (+= nodes-cut 1)
      (cast (ptr void) p))))

(define (node-large [n u32]) -> (ptr void)
  (+= nodes-large 1)
  (malloc n))

(define (node-free-large [p (ptr void)])
  (-= nodes-large 1)
  (free p))

(define (nodes-live) -> u32
  (let ([n (+ nodes-cut nodes-large)])
    (for ([k u32 2]) (<= k 64) (+= k 1)
      (let ([p (@ node-lists k)])
        (while (!= p 0)
          (-= n 1)
          (set! p (@ (cast (ptr u32) p) 1)))))
    n))
