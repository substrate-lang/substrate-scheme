(substrate-define (vector-length v) (k:fixnum (array.len (vector-arg v '"vector-length"))))
(substrate-define (vector-ref v k)
  (let ([a (vector-arg v '"vector-ref")])
    (array.get vector a (index k (array.len a) '"vector-ref"))))
(substrate-define (vector-set! v k x)
