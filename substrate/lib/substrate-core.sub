;; ---- vectors ----

(func (not-a-vector [v eqref] [who eqref]) -> (ref vector) (drop (wrong-type who '"a vector" v)) (unreachable))
(func (vector-arg [v eqref] [who eqref]) #:inline -> (ref vector)
  (if (ref.test (ref vector) v) (ref.cast (ref vector) v) (not-a-vector v who)))

;; Index k of an array of n elements, for function who.
(func (index [k eqref] [n i32] [who eqref]) -> i32
  (let ([i (count k who)])
    (if (i32.ge_u i n) (drop (index-error who k)))
    i))

;; Bounds start and end of an array of n elements: 0 <= start <= end <= n.
(func (bound [k eqref] [n i32] [who eqref]) -> i32
  (let ([i (count k who)])
    (if (i32.gt_u i n) (drop (index-error who k)))
    i))

(func (list->vector* [l eqref] [who eqref]) -> eqref
  (let* ([n (k:length (list-arg l who))] [v (array.new vector (ref.null eq) n)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (array.set vector v i (k:car l))
        (set! l (k:cdr l))
        (set! i (i32.add i 1))
        (br next)))
    v))

(func (vector-copy* [v eqref] [s eqref] [e eqref] [who eqref]) -> eqref
  (let* ([a (vector-arg v who)]
         [end (if (ref.is_null e) (array.len a) (bound e (array.len a) who))]
         [start (if (ref.is_null s) 0 (bound s end who))]
         [r (array.new vector (ref.null eq) (i32.sub end start))])
    (array.copy vector vector r 0 a start (i32.sub end start))
    r))

(substrate-define (vector? x) (bool (ref.test (ref vector) x)))
(substrate-define (vector . xs) (list->vector* xs '"vector"))
(substrate-define make-vector
