;; ---- byte strings ----

(func (not-bytes [v eqref] [who eqref]) -> (ref bytes) (drop (wrong-type who '"a byte string" v)) (unreachable))
(func (bytes-arg [v eqref] [who eqref]) #:inline -> (ref bytes)
  (if (ref.test (ref bytes) v) (ref.cast (ref bytes) v) (not-bytes v who)))

(func (byte-arg [b eqref] [who eqref]) -> i32
  (let ([x (int-value b who)])
    (if (i64.gt_u x 255) (drop (wrong-type who '"a byte" b)))
    (i32.wrap_i64 x)))

(func (bytes-copy* [v eqref] [s eqref] [e eqref] [who eqref]) -> eqref
  (let* ([a (bytes-arg v who)]
         [end (if (ref.is_null e) (array.len a) (bound e (array.len a) who))]
         [start (if (ref.is_null s) 0 (bound s end who))]
         [r (array.new bytes 0 (i32.sub end start))])
    (array.copy bytes bytes r 0 a start (i32.sub end start))
    r))

;; Copy from's bytes start to end into to, from index at.
(func (bytes-copy!* [to eqref] [at eqref] [from eqref] [s eqref] [e eqref]) -> eqref
  (let* ([who '"bytes-copy!"]
         [t (bytes-arg to who)]
         [f (bytes-arg from who)]
         [end (if (ref.is_null e) (array.len f) (bound e (array.len f) who))]
         [start (if (ref.is_null s) 0 (bound s end who))]
         [i (bound at (array.len t) who)])
    (if (i32.gt_u (i32.sub end start) (i32.sub (array.len t) i)) (return (index-error who at)))
    (array.copy bytes bytes t i f start (i32.sub end start))
    '#f))

(func (bytes-append-all [l eqref]) -> eqref
  (let ([n 0] [p l] [r (array.new bytes 0 0)] [i 0] [b (array.new bytes 0 0)])
    (block done
      (loop next
        (br-if done (i32.eqz (k:pair? p)))
        (set! n (i32.add n (array.len (bytes-arg (k:car p) '"bytes-append"))))
        (set! p (k:cdr p))
        (br next)))
    (set! r (array.new bytes 0 n))
    (block done
      (loop next
        (br-if done (i32.eqz (k:pair? l)))
        (set! b (ref.cast (ref bytes) (k:car l)))
        (array.copy bytes bytes r i b 0 (array.len b))
        (set! i (i32.add i (array.len b)))
        (set! l (k:cdr l))
        (br next)))
    r))

(substrate-define (bytes? x) (bool (ref.test (ref bytes) x)))
(substrate-define (bytes . bs)
  (let* ([n (k:length bs)] [r (array.new bytes 0 n)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (array.set bytes r i (byte-arg (k:car bs) '"bytes"))
        (set! bs (k:cdr bs))
        (set! i (i32.add i 1))
        (br next)))
    r))
(substrate-define make-bytes
  (substrate-case-lambda
    [(n) (array.new bytes 0 (count n '"make-bytes"))]
    [(n fill) (array.new bytes (byte-arg fill '"make-bytes") (count n '"make-bytes"))]))
(substrate-define (bytes-length v) (k:fixnum (array.len (bytes-arg v '"bytes-length"))))
(substrate-define (bytes-ref v k)
  (let ([a (bytes-arg v '"bytes-ref")])
    (k:fixnum (array.get_u bytes a (index k (array.len a) '"bytes-ref")))))
(substrate-define (bytes-set! v k b)
  (let ([a (bytes-arg v '"bytes-set!")])
    (array.set bytes a (index k (array.len a) '"bytes-set!") (byte-arg b '"bytes-set!"))
    '#f))
(substrate-define (bytes-copy v) (bytes-copy* v '#f '#f '"bytes-copy"))
(substrate-define subbytes
  (substrate-case-lambda
    [(v start) (bytes-copy* v start '#f '"subbytes")]
    [(v start end) (bytes-copy* v start end '"subbytes")]))
(substrate-define (bytes->list v)
  (let* ([a (bytes-arg v '"bytes->list")] [i (array.len a)] [l '()])
    (block done
      (loop next
        (br-if done (i32.eqz i))
        (set! i (i32.sub i 1))
        (set! l (k:cons (k:fixnum (array.get_u bytes a i)) l))
        (br next)))
    l))
(substrate-define (list->bytes l) (apply-list bytes (list-arg l '"list->bytes")))
(substrate-define bytes-copy!
  (substrate-case-lambda
    [(to at from) (bytes-copy!* to at from '#f '#f)]
    [(to at from start) (bytes-copy!* to at from start '#f)]
    [(to at from start end) (bytes-copy!* to at from start end)]))
(substrate-define (bytes-append . vs) (bytes-append-all vs))

;; ---- structs ----
;;
;; (struct name (field ...) option ...). Each declaration makes a
;; descriptor, a struct-type naming the struct and its fields, and its own
;; wasm struct type, a subtype of structure. A struct's kind is its
;; descriptor, not its wasm type: wasm compares types by structure, so two
;; declarations with the same fields have the same one. Each struct keeps a
;; hash of its own, so it can be a key of an eq? hash table.

(global hash-counter (mut i32) 0)

;; The next struct's hash: a count, spread over the i32s (Fibonacci
;; hashing).
(func (fresh-hash) -> i32
  (set! hash-counter (i32.add hash-counter 1))
  (i32.mul hash-counter -1640531535))

(func (structure-of? [v eqref] [d eqref]) -> i32
  (if (i32.eqz (ref.test (ref structure) v)) (return 0))
  (ref.eq (struct.get structure type (ref.cast (ref structure) v)) d))

;; v, which must be a struct of descriptor d, for function who.
(func (structure-arg [v eqref] [d eqref] [who eqref]) -> (ref structure)
  (if (i32.eqz (structure-of? v d))
      (drop (wrong-type who
                        (k:string-append '"a " (k:symbol->string (struct.get struct-type name (ref.cast (ref struct-type) d))))
                        v)))
  (ref.cast (ref structure) v))

;; ---- hash tables ----
;;
;; A hash table compares keys with eq? (kind 0), eqv? (1) or equal? (2).
;; WasmGC gives no identity hash, so a key of an eq? or eqv? table must
;; carry its own: symbols keep their name's, structs one of their own,
;; keywords hash by name, and numbers, characters, #t, #f and () by value.
;; Other values can only be keys of equal? tables (make-hash), which hash
;; strings, pairs, vectors and byte strings by their contents. Walks go
;; through buckets in order, so they are deterministic.

(func (mix [x i32]) -> i32
  (let ([h (i32.mul (i32.xor x (i32.shr_u x 16)) -2048144789)])
    (i32.xor h (i32.shr_u h 13))))

(func (mix64 [x i64]) -> i32 (mix (i32.xor (i32.wrap_i64 x) (i32.wrap_i64 (i64.shr_u x 32)))))

(func (key-hash [k eqref] [kind i32] [who eqref]) -> i32
  (if (ref.is_null k) (return 0))
  (if (k:fixnum? k) (return (mix (k:fixnum-value k))))
  (if (k:symbol? k) (return (k:symbol-hash k)))
  (if (k:keyword? k) (return (contents-hash (k:keyword->string k) 16 who)))
  (if (ref.test (ref structure) k) (return (struct.get structure hash (ref.cast (ref structure) k))))
  (if (ref.eq k '#t) (return 1))
  (if (k:null? k) (return 2))
  (if (k:char? k) (return (mix (i32.add (k:char->integer k) 1114112))))
  (if (k:integer? k) (return (mix64 (k:integer-value k))))
  (if (k:flonum? k) (return (mix64 (i64.reinterpret_f64 (k:flonum-value k)))))
  (if (i32.eq kind 2) (return (contents-hash k 16 who)))
  (drop (wrong-type who '"a key with a hash (a symbol, keyword, struct, number, character, boolean or ()); make-hash takes others" k))
  0)

;; The hash of k by its contents, looking at up to limit parts of it.
(func (contents-hash [k eqref] [limit i32] [who eqref]) -> i32
  (if (k:string? k)
      (let ([h -2128831035] [i 0] [n (k:string-length k)])
        (block done
          (loop next
            (br-if done (i32.ge_u i n))
            (set! h (i32.mul (i32.xor h (k:string-byte k i)) 16777619))
            (set! i (i32.add i 1))
            (br next)))
        (return h)))
  (if (k:pair? k)
      (let ([h 3] [n 0])
        (block done
          (loop next
            (br-if done (i32.eqz (k:pair? k)))
            (br-if done (i32.ge_u n limit))
            (set! h (i32.add (i32.mul h 31) (key-hash (k:car k) 2 who)))
            (set! k (k:cdr k))
            (set! n (i32.add n 1))
            (br next)))
        (return (mix h))))
  (if (ref.test (ref vector) k)
      (let ([a (ref.cast (ref vector) k)] [h 5] [i 0])
        (block done
          (loop next
            (br-if done (i32.ge_u i (array.len a)))
            (br-if done (i32.ge_u i limit))
            (set! h (i32.add (i32.mul h 31) (key-hash (array.get vector a i) 2 who)))
            (set! i (i32.add i 1))
            (br next)))
        (return (mix h))))
  (if (ref.test (ref bytes) k)
      (let ([a (ref.cast (ref bytes) k)] [h 7] [i 0])
        (block done
          (loop next
            (br-if done (i32.ge_u i (array.len a)))
            (set! h (i32.mul (i32.xor h (array.get_u bytes a i)) 16777619))
            (set! i (i32.add i 1))
            (br next)))
        (return h)))
  (drop (wrong-type who '"a key with a hash or contents to hash" k))
  0)

(func (make-table [kind i32]) -> eqref
  (struct.new hashtable kind 0 (array.new buckets (ref.null entry) 16)))

(func (not-a-table [t eqref] [who eqref]) -> (ref hashtable) (drop (wrong-type who '"a hash table" t)) (unreachable))
(func (table-arg [t eqref] [who eqref]) #:inline -> (ref hashtable)
  (if (ref.test (ref hashtable) t) (ref.cast (ref hashtable) t) (not-a-table t who)))

(func (bucket-of [t (ref hashtable)] [h i32]) -> i32
  (i32.and h (i32.sub (array.len (struct.get hashtable buckets t)) 1)))

;; The entry for key k, whose hash is h, or null.
(func (find-entry [t (ref hashtable)] [k eqref] [h i32]) -> (ref null entry)
  (let ([e (ref null entry) (array.get buckets (struct.get hashtable buckets t) (bucket-of t h))]
        [kind (struct.get hashtable kind t)])
    (block done
      (loop next
        (br-if done (ref.is_null e))
        (if (i32.eq (struct.get entry hash e) h)
            (if (same k (struct.get entry key e) kind) (return e)))
        (set! e (struct.get entry next e))
        (br next)))
    (ref.null entry)))

;; Add an entry, doubling the buckets when there are twice as many entries.
(func (add-entry [t (ref hashtable)] [k eqref] [h i32] [v eqref])
  (if (i32.ge_u (struct.get hashtable count t) (i32.shl (array.len (struct.get hashtable buckets t)) 1))
      (rehash t (i32.shl (array.len (struct.get hashtable buckets t)) 1)))
  (let* ([bs (struct.get hashtable buckets t)] [i (bucket-of t h)])
    (array.set buckets bs i (struct.new entry k h v (array.get buckets bs i)))
    (struct.set hashtable count t (i32.add (struct.get hashtable count t) 1))))

(func (rehash [t (ref hashtable)] [n i32])
  (let ([old (struct.get hashtable buckets t)] [new (array.new buckets (ref.null entry) n)] [i 0]
        [e (ref null entry) (ref.null entry)] [next (ref null entry) (ref.null entry)] [j 0])
    (block done
      (loop buckets-loop
        (br-if done (i32.ge_u i (array.len old)))
        (set! e (array.get buckets old i))
        (block chain-done
          (loop chain
            (br-if chain-done (ref.is_null e))
            (set! next (struct.get entry next e))
            (set! j (i32.and (struct.get entry hash e) (i32.sub n 1)))
            (struct.set entry next e (array.get buckets new j))
            (array.set buckets new j e)
            (set! e next)
            (br chain)))
        (set! i (i32.add i 1))
        (br buckets-loop)))
    (struct.set hashtable buckets t new)))

(func (remove-entry [t (ref hashtable)] [k eqref] [h i32])
  (let* ([bs (struct.get hashtable buckets t)] [i (bucket-of t h)] [kind (struct.get hashtable kind t)]
         [e (ref null entry) (array.get buckets bs i)] [prev (ref null entry) (ref.null entry)])
    (block done
      (loop next
        (br-if done (ref.is_null e))
        (if (i32.eq (struct.get entry hash e) h)
            (if (same k (struct.get entry key e) kind)
                (begin
                  (if (ref.is_null prev)
                      (array.set buckets bs i (struct.get entry next e))
                      (struct.set entry next prev (struct.get entry next e)))
                  (struct.set hashtable count t (i32.sub (struct.get hashtable count t) 1))
                  (return))))
        (set! prev e)
        (set! e (struct.get entry next e))
        (br next)))))

;; The table's entries in order: each key (part 0), value (1), or both as a
;; pair (2), in a list.
(func (table-walk [t (ref hashtable)] [part i32]) -> eqref
  (let ([bs (struct.get hashtable buckets t)] [i (array.len (struct.get hashtable buckets t))]
        [e (ref null entry) (ref.null entry)] [acc '()] [chain '()])
    (block done
      (loop next
        (br-if done (i32.eqz i))
        (set! i (i32.sub i 1))
        (set! e (array.get buckets bs i))
        (set! chain '())
        (block chain-done
          (loop walk
            (br-if chain-done (ref.is_null e))
            (set! chain (k:cons (if (i32.eqz part) (struct.get entry key e)
                                    (if (i32.eq part 1) (struct.get entry value e)
                                        (k:cons (struct.get entry key e) (struct.get entry value e))))
                                chain))
            (set! e (struct.get entry next e))
            (br walk)))
        (set! acc (k:append (k:reverse chain) acc))
        (br next)))
    acc))

;; A table of kind, filled from the pairs of alist assocs.
(func (make-table-from [kind i32] [assocs eqref] [who eqref]) -> eqref
  (let ([t (make-table kind)] [l (list-arg assocs who)] [p eqref '#f])
    (block done
      (loop next
        (br-if done (i32.eqz (k:pair? l)))
        (set! p (pair-arg (k:car l) who))
        (drop (hash-set* (ref.cast (ref hashtable) t) (k:car p) (k:cdr p) who))
        (set! l (k:cdr l))
        (br next)))
    t))

(func (hash-set* [x (ref hashtable)] [k eqref] [v eqref] [who eqref]) -> eqref
  (let* ([h (key-hash k (struct.get hashtable kind x) who)] [e (find-entry x k h)])
    (if (ref.is_null e) (add-entry x k h v) (struct.set entry value e v))
    '#f))

(func (no-key-error [who eqref] [k eqref]) -> eqref
  (let ([p (new-port -1)])
    (out-who p who)
    (out-string p '": no value found for key " 0)
    (out-datum p k 0)
    (fail-with p)))

;; The failure argument, when a key is missing, is called if it is a
;; procedure and returned otherwise; with none, a missing key is an error.
(func (hash-ref* [t eqref] [k eqref] [failure eqref] [has-failure i32] [who eqref]) -> eqref
  (let* ([x (table-arg t who)]
         [e (find-entry x k (key-hash k (struct.get hashtable kind x) who))])
    (if (i32.eqz (ref.is_null e)) (return (struct.get entry value e)))
    (if (i32.eqz has-failure) (return (no-key-error who k)))
    (if (ref.test (ref closure) failure) (app failure) failure)))

(substrate-define make-hasheq
  (substrate-case-lambda [() (make-table 0)] [(assocs) (make-table-from 0 assocs '"make-hasheq")]))
(substrate-define make-hasheqv
  (substrate-case-lambda [() (make-table 1)] [(assocs) (make-table-from 1 assocs '"make-hasheqv")]))
(substrate-define make-hash
  (substrate-case-lambda [() (make-table 2)] [(assocs) (make-table-from 2 assocs '"make-hash")]))
(substrate-define (hash? x) (bool (ref.test (ref hashtable) x)))
(substrate-define (hash-count t) (k:fixnum (struct.get hashtable count (table-arg t '"hash-count"))))

(substrate-define hash-ref
  (substrate-case-lambda
    [(t k failure) (hash-ref* t k failure 1 '"hash-ref")]
    [(t k) (hash-ref* t k '#f 0 '"hash-ref")]))

(substrate-define (hash-has-key? t k)
  (let ([x (table-arg t '"hash-has-key?")])
    (bool (i32.eqz (ref.is_null (find-entry x k (key-hash k (struct.get hashtable kind x) '"hash-has-key?")))))))

(substrate-define (hash-set! t k v) (hash-set* (table-arg t '"hash-set!") k v '"hash-set!"))

;; Set k's value to (updater value), value being k's value or, if it has
;; none, failure's result, as for hash-ref. updater may change the table.
(func (hash-update* [t eqref] [k eqref] [updater eqref] [failure eqref] [has-failure i32]) -> eqref
  (let* ([who '"hash-update!"]
         [x (table-arg t who)]
         [v (app updater (hash-ref* x k failure has-failure who))])
    (hash-set* x k v who)))

(substrate-define hash-update!
  (substrate-case-lambda
    [(t k updater) (hash-update* t k updater '#f 0)]
    [(t k updater failure) (hash-update* t k updater failure 1)]))

(substrate-define (hash-remove! t k)
  (let ([x (table-arg t '"hash-remove!")])
    (remove-entry x k (key-hash k (struct.get hashtable kind x) '"hash-remove!"))
    '#f))

(substrate-define (hash-clear! t)
  (let ([x (table-arg t '"hash-clear!")])
    (struct.set hashtable buckets x (array.new buckets (ref.null entry) 16))
    (struct.set hashtable count x 0)
    '#f))

(substrate-define (hash-keys t) (table-walk (table-arg t '"hash-keys") 0))
(substrate-define (hash-values t) (table-walk (table-arg t '"hash-values") 1))
(substrate-define (hash->list t) (table-walk (table-arg t '"hash->list") 2))

;; (f key value) for each entry.
(substrate-define (hash-for-each t f)
  (let ([l (table-walk (table-arg t '"hash-for-each") 2)])
    (block done
      (loop next
        (br-if done (i32.eqz (k:pair? l)))
        (drop (app f (k:car (k:car l)) (k:cdr (k:car l))))
        (set! l (k:cdr l))
        (br next)))
    '#f))

;; ---- exceptions ----
;;
;; See run-time errors, above. with-handlers (lib/substrate.sub) calls
;; call-with-handlers.

(substrate-define (raise v) (raise* v))

;; thunk's value. If it raises a value that one of preds is true of, the
;; value, once thunk has been left, of the procedure at the same place in
;; procs, called with it.
(substrate-define (call-with-handlers preds procs thunk)
  (let ([outer handlers])
    (set! handlers (k:cons preds outer))
    (try ([catch-ref k:exn (v e) (set! handlers outer) (handle v preds procs e)]
          [catch-all-ref (e) (set! handlers outer) (throw-ref e)])
      (let ([r (app thunk)])
        (set! handlers outer)
        r))))

;; The value of the handler for v, or else exception e, whose value v is,
;; thrown again.
(func (handle [v eqref] [preds eqref] [hs eqref] [e exnref]) -> eqref
  (block none
    (loop next
      (br-if none (i32.eqz (k:pair? preds)))
      (if (i32.eqz (ref.is_null (app (k:car preds) v))) (return (app (k:car hs) v)))
      (set! preds (k:cdr preds))
      (set! hs (k:cdr hs))
      (br next)))
  (throw-ref e))

;; thunk's value, with pre called before it and post after it, also when
;; an exception leaves it.
(substrate-define (dynamic-wind pre thunk post)
  (app pre)
  (let ([r (try ([catch-all-ref (e) (app post) (throw-ref e)])
             (app thunk))])
    (app post)
    r))

;; Is v an exception: what error or a function's check raises, or a
;; syntax error?
(substrate-define (exn? v) (bool (i32.or (ref.test (ref exception) v) (k:syntax-error? v))))
(substrate-define (exn-message v)
  (if (ref.test (ref exception) v) (return (struct.get exception message (ref.cast (ref exception) v))))
  (if (k:syntax-error? v) (return (k:syntax-error-message v)))
  (wrong-type '"exn-message" '"an exception" v))
(substrate-define (syntax-error? v) (bool (k:syntax-error? v)))

;; ---- syntax ----
;;
;; The kernel module's functions (spec 2.3) as Substrate functions, for
;; macros written in Substrate: predicates give #t or #f.

(func (not-syntax [x eqref] [who eqref]) -> eqref (wrong-type who '"a syntax object" x))
(func (syntax-arg [x eqref] [who eqref]) #:inline -> eqref (if (k:syntax? x) x (not-syntax x who)))

(substrate-define (syntax? x) (bool (k:syntax? x)))
(substrate-define (identifier? x) (bool (k:identifier? x)))
(substrate-define (syntax-e x) (k:syntax-e (syntax-arg x '"syntax-e")))
(substrate-define (syntax->list x) (k:syntax->list x))
(substrate-define (syntax->datum x) (k:syntax->datum x))
(substrate-define datum->syntax
  (substrate-case-lambda
    [(ctx d) (k:datum->syntax ctx d '#f)]
    [(ctx d loc) (k:datum->syntax ctx d loc)]))
(substrate-define (syntax-rewrap x e) (k:syntax-rewrap (syntax-arg x '"syntax-rewrap") e))
;; (syntax-property x key) reads a property, and
;; (syntax-property x key value) returns a copy of x with it set.
(substrate-define syntax-property
  (substrate-case-lambda
    [(x key) (k:syntax-property (syntax-arg x '"syntax-property") key)]
    [(x key value) (k:syntax-property-set (syntax-arg x '"syntax-property") key value)]))
(substrate-define (free-identifier=? a b) (bool (k:free-identifier=? a b)))
(substrate-define (syntax-local-value id) (k:syntax-local-value id))
(substrate-define (identifier-binding-kind id) (k:identifier-binding-kind id))
(substrate-define (local-expand x) (k:local-expand x))
(substrate-define (syntax-local-lift-definition form) (k:syntax-local-lift-definition form))
(substrate-define raise-syntax-error
  (substrate-case-lambda
    [(name message) (k:raise-syntax-error name message '#f) '#f]
    [(name message x) (k:raise-syntax-error name message x) '#f]))

;; ---- output and errors ----
;;
;; write, display, newline, write-byte and write-bytes write to the
;; standard output, or to the port they are given: a bytes port, from
;; open-output-bytes, keeps what is written to it, for get-output-bytes.

(func (not-a-port [v eqref] [who eqref]) -> (ref port) (drop (wrong-type who '"an output port" v)) (unreachable))
(func (port-arg [v eqref] [who eqref]) #:inline -> (ref port)
  (if (ref.test (ref port) v) (ref.cast (ref port) v) (not-a-port v who)))

(func (write* [x eqref] [p (ref port)] [display i32]) -> eqref
  (out-datum p x display)
  (flush p)
  '#f)

(substrate-define write
  (substrate-case-lambda
    [(x) (write* x stdout 0)]
    [(x p) (write* x (port-arg p '"write") 0)]))
(substrate-define display
  (substrate-case-lambda
    [(x) (write* x stdout 1)]
    [(x p) (write* x (port-arg p '"display") 1)]))
(substrate-define newline
  (substrate-case-lambda
    [() (write* '#\newline stdout 1)]
    [(p) (write* '#\newline (port-arg p '"newline") 1)]))

(func (write-byte* [b eqref] [p (ref port)]) -> eqref
  (out-byte p (byte-arg b '"write-byte"))
  (flush p)
  '#f)

(func (write-bytes* [v eqref] [p (ref port)]) -> eqref
  (let ([a (bytes-arg v '"write-bytes")])
    (out-byte-range p a 0 (array.len a))
    (flush p)
    '#f))

(substrate-define write-byte
  (substrate-case-lambda
    [(b p) (write-byte* b (port-arg p '"write-byte"))]
    [(b) (write-byte* b stdout)]))
(substrate-define write-bytes
  (substrate-case-lambda
    [(v p) (write-bytes* v (port-arg p '"write-bytes"))]
    [(v) (write-bytes* v stdout)]))

(substrate-define (open-output-bytes) (new-port -1))
(substrate-define (get-output-bytes p) (port-bytes (port-arg p '"get-output-bytes")))
;; The number of bytes written to bytes port p.
(substrate-define (file-position p) (k:fixnum (struct.get port length (port-arg p '"file-position"))))
;; (proc port) with a new bytes port; what it writes there, as bytes.
(substrate-define (call-with-output-bytes proc)
  (let ([p (new-port -1)])
    (drop (app proc p))
    (port-bytes p)))

(func (format-error [who eqref] [what eqref]) -> eqref
  (let ([p (new-port -1)])
    (out-who p who)
    (out-string p '": " 0)
    (out-string p what 0)
    (fail-with p)))

;; Write format string form with args to p: ~a displays the next argument,
;; ~s, ~v and ~e write it, ~% and ~n are newlines, and ~~ is ~.
(func (out-format [p (ref port)] [who eqref] [form eqref] [args eqref])
  (let ([n (k:string-length (string-arg form who))] [i 0] [b 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (set! b (k:string-byte form i))
        (if (i32.ne b 126)
            (begin (out-byte p b) (set! i (i32.add i 1)) (br next)))
        (if (i32.ge_u (i32.add i 1) n) (drop (format-error who '"the format string ends in ~")))
        (set! b (k:string-byte form (i32.add i 1)))
        (if (i32.or (i32.eq b 126) (i32.or (i32.eq b 37) (i32.or (i32.eq b 110) (i32.eq b 78))))
            (out-byte p (if (i32.eq b 126) 126 10))
            (begin
              (if (i32.eqz (k:pair? args))
                  (drop (format-error who '"the format string takes more arguments than it was given")))
              (if (i32.or (i32.eq b 97) (i32.eq b 65))
                  (out-datum p (k:car args) 1)
                  (if (i32.or (i32.or (i32.eq b 115) (i32.eq b 83))
                              (i32.or (i32.or (i32.eq b 118) (i32.eq b 86)) (i32.or (i32.eq b 101) (i32.eq b 69))))
                      (out-datum p (k:car args) 0)
                      (drop (format-error who '"the format string has an unknown directive"))))
              (set! args (k:cdr args))))
        (set! i (i32.add i 2))
        (br next)))
    (if (k:pair? args) (drop (format-error who '"the format string takes fewer arguments than it was given")))))

(substrate-define (format form . args)
  (let ([p (new-port -1)])
    (out-format p '"format" form args)
    (port-string p)))

(substrate-define (printf form . args) (out-format stdout '"printf" form args) (flush stdout) '#f)

;; printf to stderr.
(substrate-define (eprintf form . args) (out-format stderr '"eprintf" form args) (flush stderr) '#f)

;; (error 'sym) stops with "error: sym"; (error "message" v ...) with the
;; message, then each v written; (error 'who "format" v ...) with "who: "
;; and the format string filled in, as format does.
(substrate-define (error first . rest)
  (let ([p (new-port -1)])
    (if (i32.and (k:symbol? first) (k:null? rest))
        (begin (out-string p '"error: " 0) (out-datum p first 1))
        (if (k:symbol? first)
            (begin
              (out-datum p first 1)
              (out-string p '": " 0)
              (out-format p '"error" (k:car rest) (k:cdr rest)))
            (begin
              (out-datum p first 1)
              (block done
                (loop next
                  (br-if done (i32.eqz (k:pair? rest)))
                  (out-byte p 32)
                  (out-datum p (k:car rest) 0)
                  (set! rest (k:cdr rest))
                  (br next))))))
    (fail-with p)))

;; ---- the host: files, the command line, instantiating code -------------------------
;;
;; Paths, file contents and code cross to the host (spec 4) through this
;; memory, from scratch up, grown as needed.

(import host-arg-count "host" "arg_count" (-> i32))
(import host-arg "host" "arg" (i32 i32 i32 -> i32))
(import host-read-file "host" "read_file" (i32 i32 i32 i32 -> i32))
(import host-write-file "host" "write_file" (i32 i32 i32 i32 -> i32))
(import host-instantiate "host" "instantiate" (i32 i32 i32 i32 i32 i32 -> i32))
(import host-exit "host" "exit" (i32 ->))
(import host-error-message "host" "error_message" (i32 i32 -> i32))

(global scratch i32 65536)

;; Room for n bytes at scratch.
(func (scratch-reserve [n i32])
  (let ([have (i32.mul (memory.size) 65536)] [end (i32.add scratch n)])
    (if (i32.gt_u end have)
        (drop (memory.grow (i32.div_u (i32.add (i32.sub end have) 65535) 65536))))))

;; String s's bytes, at address at.
(func (store-string [s eqref] [at i32])
  (let ([n (k:string-length s)] [i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (i32.store8 (i32.add at i) (k:string-byte s i))
        (set! i (i32.add i 1))
        (br next)))))

;; The first n bytes of a, at address at.
(func (store-bytes [a (ref bytes)] [n i32] [at i32])
  (let ([i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (i32.store8 (i32.add at i) (array.get_u bytes a i))
        (set! i (i32.add i 1))
        (br next)))))

;; The n bytes of memory at address at, written to p.
(func (out-memory [p (ref port)] [at i32] [n i32])
  (let ([i 0])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (out-byte p (i32.load8_u (i32.add at i)))
        (set! i (i32.add i 1))
        (br next)))))

;; The host's message for its last failure, written to p.
(func (host-message [p (ref port)])
  (scratch-reserve 4096)
  (out-memory p scratch (host-error-message scratch 4096)))

;; Stop with "who: " and the host's message for its last failure.
(func (host-error [who eqref]) -> eqref
  (let ([p (new-port -1)])
    (out-who p who)
    (out-string p '": " 0)
    (host-message p)
    (fail-with p)))

;; The bytes of the file path names, for function who.
(func (read-file [path eqref] [who eqref]) -> (ref bytes)
  (let* ([s (string-arg path who)] [pl (k:string-length s)] [at (i32.add scratch pl)] [n 0] [p (new-port -1)])
    (scratch-reserve pl)
    (store-string s scratch)
    (set! n (host-read-file scratch pl at 0))
    (if (i32.lt_s n 0) (drop (host-error who)))
    (scratch-reserve (i32.add pl n))
    (if (i32.ne (host-read-file scratch pl at n) n) (drop (host-error who)))
    (out-memory p at n)
    (port-bytes p)))

(substrate-define (file->bytes path) (read-file path '"file->bytes"))

;; Can the file path names be read?
(substrate-define (file-exists? path)
  (let* ([p (string-arg path '"file-exists?")] [pl (k:string-length p)])
    (scratch-reserve pl)
    (store-string p scratch)
    (bool (i32.ge_s (host-read-file scratch pl (i32.add scratch pl) 0) 0))))

;; The file's bytes as a string; it is an error if they are not UTF-8.
(substrate-define (file->string path)
  (bytes->string* (read-file path '"file->string") '#f '#f '#f '"file->string"))

;; (display-to-file v path): write v, as display does, to the file path
;; names, creating or replacing it.
(substrate-define (display-to-file v path)
  (let* ([s (string-arg path '"display-to-file")] [pl (k:string-length s)] [p (new-port -1)] [n 0])
    (out-datum p v 1)
    (set! n (struct.get port length p))
    (scratch-reserve (i32.add pl n))
    (store-string s scratch)
    (store-bytes (struct.get port bytes p) n (i32.add scratch pl))
    (if (i32.lt_s (host-write-file scratch pl (i32.add scratch pl) n) 0) (drop (host-error '"display-to-file")))
    '#f))

;; The program's command-line arguments, as a vector of strings.
(substrate-define (current-command-line-arguments)
  (let* ([n (host-arg-count)] [v (array.new vector (ref.null eq) n)] [i 0] [len 0] [p (new-port -1)]
         [s eqref '#f])
    (block done
      (loop next
        (br-if done (i32.ge_u i n))
        (set! len (host-arg i scratch 0))
        (scratch-reserve len)
        (drop (host-arg i scratch len))
        (struct.set port length p 0)
        (out-memory p scratch len)
        (set! s (port-string p))
        (if (ref.is_null s) (drop (format-error '"current-command-line-arguments" '"a command-line argument is not UTF-8")))
        (array.set vector v i s)
        (set! i (i32.add i 1))
        (br next)))
    v))

;; (instantiate name code [imports]): compile and instantiate the wasm
;; module in byte string code as the instance named name: the host's
;; instantiate hook (spec 4). imports is an alist from the module names the
;; code imports from to the instances those imports link to; an import from
;; a module it does not name links to the instance of that name. #f, or
;; the host's message if it fails.
(func (instantiate* [name eqref] [code eqref] [imports eqref]) -> eqref
  (let* ([s (string-arg name '"instantiate")] [nl (k:string-length s)] [a (bytes-arg code '"instantiate")]
         [l (list-arg imports '"instantiate")] [m (new-port -1)] [at 0] [p (new-port -1)])
    ;; The map for the host: each module name, then its instance's, each
    ;; followed by a zero byte.
    (block done
      (loop next
        (br-if done (i32.eqz (k:pair? l)))
        (let ([e (pair-arg (k:car l) '"instantiate")])
          (out-string m (string-arg (k:car e) '"instantiate") 0)
          (out-byte m 0)
          (out-string m (string-arg (k:cdr e) '"instantiate") 0)
          (out-byte m 0))
        (set! l (k:cdr l))
        (br next)))
    (set! at (i32.add scratch (i32.add nl (array.len a))))
    (scratch-reserve (i32.add (i32.add nl (array.len a)) (struct.get port length m)))
    (store-string s scratch)
    (store-bytes a (array.len a) (i32.add scratch nl))
    (store-bytes (struct.get port bytes m) (struct.get port length m) at)
    (if (i32.eqz (host-instantiate scratch nl (i32.add scratch nl) (array.len a) at (struct.get port length m)))
        (return '#f))
    (host-message p)
    (port-string p)))

(substrate-define instantiate
  (substrate-case-lambda
    [(name code imports) (instantiate* name code imports)]
    [(name code) (instantiate* name code '())]))

;; The status (exit v) ends the program with: v if it is an integer from 1
;; to 255, and otherwise 0.
(func (exit-status [v eqref]) -> i32
  (if (i32.eqz (k:fixnum? v)) (return 0))
  (let ([n (k:fixnum-value v)])
    (if (i32.and (i32.ge_s n 1) (i32.le_s n 255)) n 0)))

(substrate-define exit
  (substrate-case-lambda
    [() (host-exit 0) '#f]
    [(v) (host-exit (exit-status v)) '#f]))
