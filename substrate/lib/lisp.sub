;; ---- functions -------------------------------------------------------------------------

(lisp-define (cons a d) (s:cons a d))
(lisp-define (car p) (s:car p))
(lisp-define (cdr p) (s:cdr p))
(lisp-define (pair? x) (bool (s:pair? x)))
(lisp-define (null? x) (bool (s:null? x)))
(lisp-define (list? x) (bool (s:list? x)))
(lisp-define (length l) (s:fixnum (s:length l)))
(lisp-define (append a b) (s:append a b))
(lisp-define (reverse l) (s:reverse l))
(lisp-define (eq? a b) (bool (ref.eq a b)))
(lisp-define (not x) (bool (ref.is_null x)))

(lisp-define (+ a b) (add a b))
(lisp-define (- a b) (sub a b))
(lisp-define (* a b) (mul a b))
(lisp-define (quotient a b) (quo a b))
(lisp-define (remainder a b) (rem a b))
(lisp-define (< a b) (bool (i64.lt_s (int-value a) (int-value b))))
(lisp-define (> a b) (bool (i64.gt_s (int-value a) (int-value b))))
(lisp-define (<= a b) (bool (i64.le_s (int-value a) (int-value b))))
(lisp-define (>= a b) (bool (i64.ge_s (int-value a) (int-value b))))
(lisp-define (= a b) (bool (i64.eq (int-value a) (int-value b))))
(lisp-define (zero? a) (bool (i64.eqz (int-value a))))

(lisp-define (display x) (write-datum x) '#f)
(lisp-define (newline) (print:newline) '#f)
(lisp-define (error msg) (fail-string msg) '#f)
