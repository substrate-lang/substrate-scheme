(func (call-with-output-bytes* [proc i32]) -> i32
  (let ([p (rt:new-port -1)])
    (drop-value (try ([catch rt:exn (v) (drop-value p) (throw rt:exn v)])
                  (rt:call-closure proc 1 (dup-value p) 0 0 0)))
    (let ([r (rt:port-bytes p)])
      (drop-value p)
      r)))
(#%fact call-with-output-bytes* '(foreign owned))
(#%fact call-with-output-bytes* '(raises))

(substrate-define (call-with-output-bytes proc) #:borrow (proc) (call-with-output-bytes* proc))

