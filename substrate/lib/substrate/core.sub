(substrate-define make-hasheq
  (substrate-case-lambda [() (rt:make-hash-table 0)] [(assocs) (rt:make-table-from 0 assocs '"make-hasheq")]))
(substrate-define make-hasheqv
  (substrate-case-lambda [() (rt:make-hash-table 1)] [(assocs) (rt:make-table-from 1 assocs '"make-hasheqv")]))
