  (substrate-case-lambda [() (rt:make-hash-table 2)] [(assocs) (rt:make-table-from 2 assocs '"make-hash")]))
(substrate-define (hash? x) #:free #:borrow (x) (bool (rt:table? x)))
(substrate-define (hash-count t) #:free #:borrow (t) (fix (rt:hash-count t '"hash-count")))

(substrate-define hash-ref #:borrow (t k failure)
  (substrate-case-lambda
    [(t k failure) (rt:hash-ref-value t k failure 1 '"hash-ref")]
    [(t k) (rt:hash-ref-value t k '#f 0 '"hash-ref")]))

(substrate-define (hash-has-key? t k) #:free #:borrow (t k) (bool (rt:hash-has-key? t k '"hash-has-key?")))
(substrate-define (hash-set! t k v) #:borrow (t) (rt:hash-set-value! t k v '"hash-set!") '#f)

;; updater may change the table.
(func (hash-update* [t i32] [k i32] [updater i32] [failure i32] [has-failure i32]) -> i32
  (rt:hash-update-value! t (dup-value k) updater failure has-failure '"hash-update!")
  '#f)
(#%fact hash-update* '(foreign owned))
(#%fact hash-update* '(raises))

(substrate-define hash-update! #:borrow (t k updater)
  (substrate-case-lambda
    [(t k updater) (hash-update* t k updater '#f 0)]
    [(t k updater failure) (hash-update* t k updater failure 1)]))

(substrate-define (hash-remove! t k) #:borrow (t k) (rt:hash-remove! t k '"hash-remove!") '#f)
(substrate-define (hash-clear! t) #:borrow (t) (rt:hash-clear! t '"hash-clear!") '#f)
(substrate-define (hash-keys t) #:borrow (t) (rt:table-walk t 0 '"hash-keys"))
(substrate-define (hash-values t) #:borrow (t) (rt:table-walk t 1 '"hash-values"))
(substrate-define (hash->list t) #:borrow (t) (rt:table-walk t 2 '"hash->list"))

(func (hash-for-each* [t i32] [f i32]) -> i32
  (let ([l (rt:table-walk t 2 '"hash-for-each")] [p 0])
    (set! p l)
    (try ([catch rt:exn (v) (drop-value l) (throw rt:exn v)])
      (block done
        (loop next
          (br-if done (i32.eqz (v:pair-cell? p)))
          (drop-value (rt:call-closure f 2 (dup-value (v:pair-car (v:pair-car p))) (dup-value (v:pair-cdr (v:pair-car p))) 0 0))
          (set! p (v:pair-cdr p))
          (br next))))
    (drop-value l)
    '#f))
(#%fact hash-for-each* '(foreign owned))
(#%fact hash-for-each* '(raises))

(substrate-define (hash-for-each t f) #:borrow (t f) (hash-for-each* t f))

