    [(s) (rt:parse-number (rt:string-arg s '"string->number") (i64.const 10))]
    [(s radix) (rt:parse-number (rt:string-arg s '"string->number") (rt:radix-value radix '"string->number"))]))

;; ---- characters ----

(substrate-define (char? x) #:free #:inline #:borrow (x) (bool (v:char-datum? x)))
(substrate-define (char->integer c) #:free #:borrow (c) (fix (rt:char-arg c '"char->integer")))
(substrate-define (integer->char n) #:borrow (n)
  (let ([x (rt:int-value n '"integer->char")])
    (if (i32.or (i64.gt_u x (i64.const 1114111)) (i32.and (i64.ge_u x (i64.const 55296)) (i64.le_u x (i64.const 57343))))
        (return (rt:wrong-type '"integer->char" '"a Unicode scalar value" n)))
    (v:integer->char (i32.wrap_i64 x))))
(substrate-define char=? #:free #:borrow (a b)
  (substrate-case-lambda [(a b) (bool (rt:char-compare 4 a b))] [(a . more) (chain 1 4 a more)]))
(substrate-define char<? #:free #:borrow (a b)
  (substrate-case-lambda [(a b) (bool (rt:char-compare 0 a b))] [(a . more) (chain 1 0 a more)]))
(substrate-define char>? #:free #:borrow (a b)
  (substrate-case-lambda [(a b) (bool (rt:char-compare 1 a b))] [(a . more) (chain 1 1 a more)]))
(substrate-define char<=? #:free #:borrow (a b)
  (substrate-case-lambda [(a b) (bool (rt:char-compare 2 a b))] [(a . more) (chain 1 2 a more)]))
(substrate-define char>=? #:free #:borrow (a b)
  (substrate-case-lambda [(a b) (bool (rt:char-compare 3 a b))] [(a . more) (chain 1 3 a more)]))

(func (ascii-letter? [c i32]) -> i32
  (i32.or (i32.and (i32.ge_u c 65) (i32.le_u c 90)) (i32.and (i32.ge_u c 97) (i32.le_u c 122))))
(#%fact ascii-letter? '(foreign raw))

(substrate-define (char-alphabetic? c) #:free #:borrow (c) (bool (ascii-letter? (rt:char-arg c '"char-alphabetic?"))))
(substrate-define (char-numeric? c) #:free #:borrow (c)
  (let ([x (rt:char-arg c '"char-numeric?")]) (bool (i32.and (i32.ge_u x 48) (i32.le_u x 57)))))
(substrate-define (char-whitespace? c) #:free #:borrow (c)
  (let ([x (rt:char-arg c '"char-whitespace?")])
    (bool (i32.or (i32.eq x 32) (i32.and (i32.ge_u x 9) (i32.le_u x 13))))))
(substrate-define (char-upcase c) #:borrow (c)
  (let ([x (rt:char-arg c '"char-upcase")])
    (if (i32.and (i32.ge_u x 97) (i32.le_u x 122)) (v:integer->char (i32.sub x 32)) c)))
(substrate-define (char-downcase c) #:borrow (c)
  (let ([x (rt:char-arg c '"char-downcase")])
    (if (i32.and (i32.ge_u x 65) (i32.le_u x 90)) (v:integer->char (i32.add x 32)) c)))
(substrate-define (char-utf-8-length c) #:free #:borrow (c) (fix (rt:utf8-length (rt:char-arg c '"char-utf-8-length"))))

