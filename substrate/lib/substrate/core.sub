                  0)))

(substrate-define (string? x) #:free #:inline #:borrow (x) (bool (v:node-tagged? x 5)))
(substrate-define (symbol? x) #:free #:inline #:borrow (x) (bool (v:node-tagged? x 3)))
(substrate-define string=? #:free #:borrow (a b)
