;; Strings in Substrate (lib/substrate.sub) are immutable UTF-8,
;; indexed by byte: "aλb€c😀" is 12 bytes, and λ starts at byte 1.
(require-unqualified substrate "../lib/substrate.sub")

(define (run)
  (let ([s "aλb€c😀"])
    (write (list (string-length s) (string-byte s 1) (string-char s 1) (string-char s 4)
                 (char-utf8-length #\😀)))
    (newline)
    (write (list (substring s 1 4) (string-copy s 3) (string->list s) (string->list s 4 8)))
    (newline)
    (write (list (list->string (list #\x #\λ)) (string #\a #\b) (utf8->string (bytevector 104 105))
                 (string->utf8 s 1 3) (string-append "λ" "€")))
    (newline)))

(func (main) (run))
