;; match (lib/substrate.sub): the patterns of syntax-match on any value,
;; and struct patterns, for a struct defined here or in another module,
;; required at phase 0 or at phase 1.
(require-unqualified substrate "../lib/substrate.sub")
(require p "fixtures/pt.sub" pt pt-x)
(begin-for-syntax
  (require-unqualified substrate "../lib/substrate.sub")
  (require p "fixtures/pt.sub" pt pt-x)
  ;; At compile time, with the fixture required at phase 1.
  (display (match (pt 5 6) [(pt a b) (list a (pt-x (pt b b)))])) (newline))

(struct leaf (v))
(struct node (l r))

(define (sum t)
  (match t
    [(leaf v) v]
    [(node l r) (+ (sum l) (sum r))]))

(define (describe x)
  (match x
    [1 "one"]
    ["s" "the string s"]
    [#\c "the character c"]
    [#:kw "the keyword kw"]
    ['sym "the symbol sym"]
    [(pt a b) (format "a point ~a ~a" a b)]
    [(? string? s) (format "a string ~a" s)]
    [(a b) (format "two ~a ~a" a b)]
    [(a . rest) (format "head ~a tail ~a" a rest)]
    [_ "other"]))

(define (main)
  (write (sum (node (leaf 1) (node (leaf 2) (leaf 3))))) (newline)
  (for-each (lambda (x) (display (describe x)) (newline))
            (list 1 "s" #\c '#:kw 'sym (pt 3 4) "hello" '(1 2) '(1 2 3) 5))
  (write (match '(1 2 3 4) [(a b ... c) (list a b c)])) (newline)
  (write (match (list (pt 1 2) (pt 3 4)) [((pt x _) ...) x])) (newline)
  (write (map pt '(1 2) '(3 4))) (newline)
  (write (pt-x (apply pt '(7 8)))) (newline))
