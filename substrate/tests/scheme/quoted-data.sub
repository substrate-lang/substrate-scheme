;; Quoted data is made when the module starts; each kind survives; equal symbols are one.
(require kd "../../lib/scheme/values.sub" flonum-value quote)
(require print "../../compiler/print.sub" write-int newline)
(require sub "../../lib/scheme/scheme.sub" write)
(memory from kd)

(func (show [x i32]) (write x) (print:newline))

(func (main)
  (show '(a "b" #\c -7 1073741824 -9223372036854775808 18446744073709551615 (#t #f ()) 2.5))
  (show '(lambda (x) (f x "s" 3)))
  (print:write-int (i32.eq 'same 'same)) (print:newline)
  (print:write-int (f64.eq (kd:flonum-value '2.5) 2.5)) (print:newline))
