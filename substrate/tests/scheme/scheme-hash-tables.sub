;; Hash tables: eq? and equal? tables, growing, and defaults for missing keys.
(language scheme "../../lib/scheme/scheme.sub")

(struct point (x y))

(define (run)
  (let ([t (make-hasheq)] [p (point 1 2)])
    (hash-set! t 'a 1)
    (hash-set! t p 'point)
    (do ([i 0 (+ i 1)]) ((= i 100)) (hash-set! t i (* i i)))
    (hash-update! t 'a (lambda (x) (+ x 1)) 0)
    (hash-update! t 'b (lambda (x) (+ x 1)) 0)
    (hash-remove! t 5)
    (write (list (hash-ref t 'a) (hash-ref t 'b) (hash-ref t p)
                 (hash-ref t 42) (hash-ref t (point 1 2) 'absent) (hash-ref t 'c (lambda () 'computed))
                 (hash-has-key? t 5) (hash-count t)))
    (newline))
  (let ([e (make-hash (list (cons "key" 1)))] [v (make-hasheqv)])
    (hash-set! e '(1 2) 2)
    (hash-set! e (vector 1 "x") 3)
    (write (list (hash-ref e (string-append "k" "ey")) (hash-ref e (list 1 2))
                 (hash-ref e (vector 1 "x")) (hash->list e)))
    (newline)
    (hash-set! v 9223372036854775807 'big)
    (hash-set! v #\λ 'lambda)
    (hash-set! v '#:key 'keyword)
    (write (list (hash-ref v 9223372036854775807) (hash-ref v (integer->char 955))
                 (hash-ref v (string->keyword "key")) (hash-keys v) (hash-values v) v))
    (newline)
    (hash-clear! v)
    (write (hash-count v))
    (newline)))

(define (main) (run))
