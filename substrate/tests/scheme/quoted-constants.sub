;; Quoted data in kernel globals, made when the module starts, so the globals are mutable.
(require print "../../compiler/substrate.sub" newline)
(require sub "../../lib/scheme/scheme.sub" write cons quote)
(memory from sub)

(global empty (mut i32) '())
(global yes (mut i32) '#t)
(global no (mut i32) '#f)
(global five (mut i32) '5)
(global built (mut i32) '(1 2))

(func (main)
  (write (cons five (cons yes (cons no empty)))) (print:newline)
  (write built) (print:newline))
