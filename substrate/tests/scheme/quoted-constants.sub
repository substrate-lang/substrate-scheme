;; Quoted data in wasm globals, made when the module starts, so the globals are mutable.
(require scheme "../../lib/scheme/scheme.sub" write cons quote)
(require wasm "../../compiler/wasm.sub")
(wasm:memory from scheme)

(wasm:global empty (mut i32) '())
(wasm:global yes (mut i32) '#t)
(wasm:global no (mut i32) '#f)
(wasm:global five (mut i32) '5)
(wasm:global built (mut i32) '(1 2))

(define (main)
  (write (cons five (cons yes (cons no empty)))) (newline)
  (write built) (newline))
