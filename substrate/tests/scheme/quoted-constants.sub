;; Quoted data in wasm globals, made when the module starts, so the globals are mutable.
(require scheme "../../lib/scheme/scheme.sub" write cons quote)
(memory from scheme)

(global empty (mut i32) '())
(global yes (mut i32) '#t)
(global no (mut i32) '#f)
(global five (mut i32) '5)
(global built (mut i32) '(1 2))

(func (main)
  (write (cons five (cons yes (cons no empty)))) (newline)
  (write built) (newline))
