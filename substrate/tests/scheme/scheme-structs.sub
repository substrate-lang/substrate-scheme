;; Structs: same fields but different descriptors, and mutators for #:mutable fields.
(language scheme "../../lib/scheme/scheme.sub")

(struct point ([x #:mutable] y))
(struct vec2 (x y))
(struct node (value next) #:mutable)

(define (run)
  (let ([p (point 1 2)] [v (vec2 1 2)] [n (node 'a #f)])
    (set-point-x! p 10)
    (write (list p (point? p) (point? v) (vec2? v) (point? 5) (point-x p) (point-y p)))
    (newline)
    (write (list (eq? p p) (eqv? p (point 10 2)) (equal? p (point 10 2))))
    (newline)
    (set-node-next! n (node 'b #f))
    (set-node-value! n 'c)
    (write (list (node-value n) (node-value (node-next n)) (node-next (node-next n))))
    (newline))
  (let ([t (tagged 'a 1)])
    (set-tagged-hash! t 2)
    (write (list (tagged-type t) (tagged-hash t) (tagged? t)))
    (newline)))

(struct tagged (type [hash #:mutable]))

(func (main) (run))
