;; dynamic-wind runs its after thunk for an exception that isn't Scheme's, a wasm tag's.
(language scheme "../../lib/scheme/scheme.sub")
(require wasm "../../compiler/wasm.sub")
(wasm:tag foreign ())
(define (fail) (wasm:throw foreign) #f)
(dynamic-wind (lambda () #f) fail (lambda () (display "the after thunk ran") (newline)))
