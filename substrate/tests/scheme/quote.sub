;; quote and quasiquote in kernel code on Scheme's data: nesting, interned symbols.
(require d "../../lib/scheme/values.sub" quote quasiquote fixnum car string->symbol symbol->string length append reverse symbol-append string-length)
(require print "../../compiler/print.sub" write-int newline)
(require sub "../../lib/scheme/scheme.sub" write)
(memory from d)

(func (main)
  (write '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f ())) (newline)
  (let ([xs '(a b)] [n (d:fixnum 7)])
    (write `(list ,@xs ,n (nested ,(d:car xs)) end)) (newline)
    (write `(1 `(2 ,(3 ,n)))) (newline)
    (write `(dotted . ,n)) (newline))
  (write-int (i32.eq 'abc (d:string->symbol (d:symbol->string 'abc)))) (newline)
  (write-int (d:length '(1 2 3))) (newline)
  (write (d:append '(1 2) '(3))) (newline)
  (write (d:reverse '(1 2 3))) (newline)
  (write (d:symbol-append 'foo- 'bar)) (newline)
  (write '"λ unicode ✓") (newline)
  (write-int (d:string-length '"λ")) (newline))
