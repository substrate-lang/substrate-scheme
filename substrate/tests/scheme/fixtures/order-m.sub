;; One of two modules required in either order: a macro in C at phase 1, and a literal.
(require-unqualified scheme "../../../lib/scheme/scheme.sub")
(provide m-twice m-tag m-datum)
(define-syntax m-twice (syntax-rules () [(_ e) (let ([t e]) (list t t 'm))]))
(struct m-tag (v))
(define m-datum '(m-datum has a literal))
