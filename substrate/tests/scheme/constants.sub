;; wasm's constants mean the same in a Scheme module, where bare literals are values.
(require-unqualified scheme "../../lib/scheme/scheme.sub")
(require substrate "../../compiler/substrate.sub")
(global limit i32 (i32.const 7))
(func (main)
  (substrate:write-int (i32.add (i32.const 40) (i32.const 2))) (substrate:newline)
  (substrate:write-i64 (i64.const -9000000000)) (substrate:newline)
  (substrate:write-int (i32.trunc_f64_s (f64.mul (f64.const 2.5) (f64.const 4)))) (substrate:newline)
  (substrate:write-int (i32.add limit (i32.trunc_f32_s (f32.const 1.5)))) (substrate:newline))
