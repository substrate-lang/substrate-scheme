;; wasm's constants mean the same in a Scheme module, where bare literals are values.
(require-unqualified scheme "../../lib/scheme/scheme.sub")
(require print "../../compiler/print.sub")
(global limit i32 (i32.const 7))
(func (main)
  (print:write-int (i32.add (i32.const 40) (i32.const 2))) (print:newline)
  (print:write-i64 (i64.const -9000000000)) (print:newline)
  (print:write-int (i32.trunc_f64_s (f64.mul (f64.const 2.5) (f64.const 4)))) (print:newline)
  (print:write-int (i32.add limit (i32.trunc_f32_s (f32.const 1.5)))) (print:newline))
