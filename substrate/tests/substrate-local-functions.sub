;; Known local functions (lib/substrate-core.sub, closure conversion): a
;; function a let, letrec or named let binds and only calls is called
;; directly, with the variables it captures as arguments. Each case's value
;; is the same when the function must stay a closure.
(require-unqualified substrate "../lib/substrate.sub")

;; A named let that captures n: a known function.
(define (sum-to n) (let loop ([i 0] [acc 0]) (if (> i n) acc (loop (+ i 1) (+ acc i)))))

;; It assigns count, which it captures: count is boxed, and the box passed.
(define (count-up)
  (let ([count 0])
    (let loop ([i 0]) (when (< i 3) (set! count (+ count 10)) (loop (+ i 1))))
    count))

;; A let-bound lambda, called twice.
(define (twice-doubled x) (let ([double (lambda (y) (* 2 y))]) (double (double x))))

;; Five arguments: the fifth goes in extra-args.
(define (five) (let loop ([a 1] [b 2] [c 3] [d 4] [e 5]) (if (> a 3) (list a b c d e) (loop (+ a 1) b c d (+ e 1)))))

;; n is shadowed where loop calls itself, so loop stays a closure.
(define (shadowed n) (let loop ([i 0]) (if (> i n) i (let ([n 100]) (loop (+ i n))))))

;; Called in another lambda: a closure.
(define (in-lambda xs) (let loop ([i 0]) (if (> i 2) i (car (map (lambda (x) (loop (+ i x))) xs)))))

;; Each calls the other in its lambda: closures.
(define (parity n)
  (letrec ([ev? (lambda (k) (if (= k 0) #t (od? (- k 1))))]
           [od? (lambda (k) (if (= k 0) #f (ev? (- k 1))))])
    (list (ev? n) (od? n))))

;; Used as a value: a closure.
(define (as-value xs) (let ([inc (lambda (x) (+ x 1))]) (map inc xs)))

(define (main)
  (display (list (sum-to 100) (count-up) (twice-doubled 5) (five) (shadowed 5) (in-lambda '(1))
                 (parity 7) (as-value '(1 2 3))))
  (newline))
