;; local-expand (spec 2.3): a macro expands part of its input to expanded
;; code (spec 6.4), looks at it, and can put it in its output.
(require print "../lib/print.sub" write-int newline)
(require wd "../lib/write-datum.sub" write-datum)
(begin-for-syntax (require s syntax))

(func (double [x i32]) -> i32 (i32.mul x 2))

;; (head-of e) => the head of e's fully expanded code, as a quoted symbol.
(begin-for-syntax
  (func (head-of [stx eqref]) -> eqref
    (let ([x (s:local-expand (s:cadr (s:syntax->list stx)))])
      #`(quote #,(s:car (s:syntax->list x))))))
(define-syntax head-of head-of)

;; (expanded e) => e's fully expanded code, which is expanded again.
(begin-for-syntax
  (func (expanded [stx eqref]) -> eqref
    (s:local-expand (s:cadr (s:syntax->list stx)))))
(define-syntax expanded expanded)

;; (with-tmp e) => (let ([tmp 1]) e'), where e' is e expanded. The macro's
;; tmp does not capture a tmp in e.
(begin-for-syntax
  (func (with-tmp [stx eqref]) -> eqref
    #`(let ([tmp 1]) #,(s:local-expand (s:cadr (s:syntax->list stx))))))
(define-syntax with-tmp with-tmp)

(func (main)
  (write-datum (head-of (double 5))) (newline)
  (write-datum (head-of 5)) (newline)
  (write-datum (head-of (let* ([a 1] [b a]) b))) (newline)
  (write-int (expanded (let ([a 20]) (i32.add a (double 11))))) (newline)
  (let ([k 5])
    (write-int (expanded (i32.mul k 2))) (newline))
  (let ([tmp 100])
    (write-int (with-tmp (i32.add tmp 1))) (newline)))
