;; A Substrate lambda in a kernel function shares a variable it assigns, in a box.
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(func (count-from [n i32]) -> i32 (let ([v (fixnum n)]) (lambda () (set! v (+ v v)) v)))
(define (run) (let ([c (count-from (i32.const 3))]) (c) (display (c)) (newline)))
(func (main) (run))
