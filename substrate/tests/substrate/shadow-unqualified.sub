;; A module-level definition shadows a name require-unqualified imports,
;; throughout the module (spec 3.1): here map, even? and odd? from
;; lib/substrate.sub.
(require-unqualified substrate "../../lib/languages/substrate/substrate.sub")

(define (run)
  (display (map (lambda (x) (* x x)) '(1 2 3))) (newline)
  (display (even? 3)) (newline))

(define (map f xs) (if (null? xs) '() (cons (f (car xs)) (cons 'mine (map f (cdr xs))))))
(define (even? n) (if (= n 0) #t (odd? (- n 1))))
(define (odd? n) (if (= n 0) #f (even? (- n 1))))

(func (main) (run))
