;; Exceptions in Substrate (lib/substrate/substrate.sub): raise, with-handlers,
;; error and the host's failures, which raise exceptions, and dynamic-wind.
(require-unqualified substrate "../../lib/substrate/substrate.sub")

(define (show x) (write x) (newline))

;; thunk's value, or (error message) if it raises an exception.
(define (safely thunk)
  (with-handlers ([exn? (lambda (e) (list 'error (exn-message e)))])
    (thunk)))

(define (run)
  ;; A raised value goes to the first handler whose predicate is true of it.
  (show (with-handlers ([string? (lambda (s) (list 'string s))]
                        [symbol? (lambda (s) (list 'symbol s))])
          (raise 'oops)))
  ;; error raises an exception, and so does a failure the host reports,
  ;; such as a file it cannot read. A mistake in the program, such as car
  ;; of a value that is not a pair, stops it instead (err-mistake).
  (show (safely (lambda () (error 'f "bad ~a" 1))))
  (show (with-handlers ([exn? (lambda (e) 'no-file)]) (file->string "no-such-file.txt")))
  (show (safely (lambda () (+ 1 2))))
  ;; A handler that does not take a value leaves it to one further out.
  (show (with-handlers ([symbol? (lambda (s) 'outer)])
          (with-handlers ([string? (lambda (s) 'inner)])
            (raise 'x))))
  ;; A handler runs once the body is left, so what it raises goes further out.
  (show (with-handlers ([symbol? (lambda (s) (list 'outer s))])
          (with-handlers ([symbol? (lambda (s) (raise 'again))])
            (raise 'first))))
  ;; dynamic-wind's post runs when the body returns, and when it raises.
  (let ([log '()])
    (dynamic-wind (lambda () (set! log (cons 'in log)))
                  (lambda () 'body)
                  (lambda () (set! log (cons 'out log))))
    (with-handlers ([symbol? (lambda (s) #f)])
      (dynamic-wind (lambda () (set! log (cons 'in log)))
                    (lambda () (raise 'up))
                    (lambda () (set! log (cons 'out log)))))
    (show (reverse log)))
  ;; Out of a closure called by a library function.
  (show (with-handlers ([number? (lambda (n) (* n 10))])
          (for-each (lambda (x) (when (> x 2) (raise x))) '(1 2 3 4))
          'none)))

(define (main) (run))
