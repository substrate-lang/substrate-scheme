;; Substrate frees what it is done with: each check prints the change in live nodes, 0.
(require-unqualified substrate "../../lib/substrate/substrate.sub")

(define (check name thunk)
  (let ([before (live-nodes)])
    (thunk)
    (display name) (display ": ") (display (- (live-nodes) before)) (newline)))

;; A thunk made where check is called would be freed inside it, as its
;; last owner, check, is done with it: each thunk is a definition.
(define (locals-10) (locals 10))

(define (lists)
  (let* ([xs (let loop ([i 0] [acc '()]) (if (= i 200) acc (loop (+ i 1) (cons i acc))))]
         [ys (map (lambda (x) (* x x)) xs)]
         [zs (filter even? ys)]
         [total (foldl + 0 zs)]
         [sorted (sort (reverse xs) <)])
    (display (list (length xs) (length zs) total (car sorted) (last sorted) (length (append xs ys zs))))
    (newline)))

(define (make-counter)
  (let ([count 0])
    (lambda () (set! count (+ count 1)) count)))

(define (compose f g) (lambda (x) (f (g x))))

(define (closures)
  (let ([c (make-counter)] [d (make-counter)])
    (c) (c) (d)
    (display (list (c) (d) ((compose (lambda (x) (+ x 1)) (lambda (x) (* x 2))) 20)))
    (newline)))

(define (locals n)
  (let ([count 0])
    (let loop ([i 0]) (when (< i n) (set! count (+ count i)) (loop (+ i 1))))
    (let ([double (lambda (y) (* 2 y))])
      (letrec ([ev? (lambda (k) (if (= k 0) #t (od? (- k 1))))]
               [od? (lambda (k) (if (= k 0) #f (ev? (- k 1))))])
        (display (list count (double (double n)) (ev? n) (od? n)))
        (newline)))))

(define (strings)
  (let* ([s (string-append "hello" ", " "world")]
         [parts (map (lambda (c) (string c)) (string->list s))]
         [back (apply string-append parts)])
    (display (list (string-utf-8-length s) (string=? s back) (symbol->string 'sym) (string->symbol "made")))
    (newline)))

(define (vectors)
  (let ([v (make-vector 5 '(shared))] [b (box '(a b))])
    (vector-set! v 0 (list 1 2 3))
    (set-box! b (vector-ref v 0))
    (display (list (vector->list (vector-copy v 0 2)) (unbox b) (bytes->list (bytes 1 2 3)) (vector-length v)))
    (newline)))

(define (tables)
  (let ([t (make-hash)] [e (make-hasheq)])
    (hash-set! t "one" (list 1))
    (hash-set! t "two" (list 2))
    (hash-set! t "one" (list 1 1))
    (hash-update! t "two" (lambda (v) (cons 2 v)))
    (hash-set! e 'a 1)
    (hash-remove! e 'a)
    (display (list (hash-ref t "one") (hash-ref t "two") (hash-count e) (sort (hash-keys t) string<?)))
    (newline)
    (hash-clear! t)))

(struct point (x [y #:mutable]))

(define (structs)
  (let ([p (point (list 1) (list 2))])
    (set-point-y! p (list 3 4))
    (display (list (point-x p) (point-y p) (point? p) (match p [(point a b) (append a b)])))
    (newline)))

(define (numbers)
  (let loop ([i 0] [big 1] [sum 0])
    (if (< i 38)
        (loop (+ i 1) (* big 3) (+ sum (* big 2)))
        (begin (display (list (> big 1000000000000) (quotient sum big) (string->number "2.5")
                              (number->string (string->number "1e3"))))
               (newline)))))

(define (many a b c d e f) (list a b c d e f))
(define (rest-args . xs) (length xs))

(define (calls)
  (display (list (apply many 1 2 3 4 '(5 6)) (rest-args (list 1) (list 2)) (apply + (list 1 2 3))))
  (newline))

(define (exceptions)
  (display (with-handlers ([pair? (lambda (v) (car v))]) (raise (list 'raised))))
  (newline))

(define (make-down)
  (letrec ([down (lambda (n) (if (= n 0) 'done (down (- n 1))))]) down))

(define (make-sum)
  (letrec ([sum (lambda (xs) (if (null? xs) 0 (+ (car xs) (sum (cdr xs)))))]) sum))

(define (make-loop) (let loop ([i 0]) (if (> i 0) i loop)))

(define (make-size)
  (letrec ([size (lambda (t) (if (pair? t) (apply + 1 (map (lambda (c) (size c)) t)) 0))]) size))

(define (recursive)
  (let ([down (make-down)] [sum (make-sum)] [loop (make-loop)] [size (make-size)])
    (display (list (down 10) (sum (list 1 2 3)) (loop 5) (size (list (list 1) 2))))
    (newline)))

(define (deep n)
  (let ([xs (list n n n)])
    (if (= n 0) (raise 'bottom) (begin (deep (- n 1)) (length xs)))))

(define (held n) (cons (list n n) (if (= n 0) (raise 'held) (held (- n 1)))))

(define (staged n)
  (let ([a (list n)] [b (list n n)] [c (if (= n 0) (raise 'staged) (staged (- n 1)))])
    (list a b c)))

(define (looped n)
  (let ([keep (list 'k)])
    (let loop ([i 0] [acc '()])
      (if (= i n) (begin (length (list (raise 'looped))) acc) (loop (+ i 1) (cons (list keep) acc))))))

(define (mapped xs) (map (lambda (x) (if (= x 3) (raise 'mapped) (list x x))) xs))

(define (library)
  (let ([t (make-hash)])
    (hash-set! t (list 'k) (list 1))
    (list (with-handlers ([symbol? (lambda (v) v)]) (hash-for-each t (lambda (k v) (raise 'each))))
          (with-handlers ([symbol? (lambda (v) v)]) (hash-update! t (list 'new) (lambda (v) (raise 'update)) (list 0)))
          (with-handlers ([symbol? (lambda (v) v)]) (call-with-output-bytes (lambda (p) (raise 'port)))))))

(define (unwound)
  (display (list (with-handlers ([symbol? (lambda (v) v)]) (deep 5))
                 (with-handlers ([symbol? (lambda (v) v)]) (held 5))
                 (with-handlers ([symbol? (lambda (v) v)]) (staged 5))
                 (with-handlers ([symbol? (lambda (v) v)]) (looped 5))
                 (with-handlers ([symbol? (lambda (v) v)]) (mapped (list 1 2 3 4)))
                 (library)))
  (newline))

(define (main)
  (check "lists" lists)
  (check "closures" closures)
  (check "locals" locals-10)
  (check "strings" strings)
  (check "vectors" vectors)
  (check "tables" tables)
  (check "structs" structs)
  (check "numbers" numbers)
  (check "calls" calls)
  (check "exceptions" exceptions)
  (check "recursive" recursive)
  (check "unwound" unwound))
