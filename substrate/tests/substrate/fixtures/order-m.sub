;; For order-a.sub and order-b.sub, which require this module and its
;; twin in either order: a module's bytes do not depend on what the run
;; compiled before it (spec 3.5). Its macro is compiled into C at phase
;; 1, and its literal is made when it starts.
(require-unqualified substrate "../../../lib/languages/substrate/substrate.sub")
(provide m-twice m-tag m-datum)
(define-syntax m-twice (syntax-rules () [(_ e) (let ([t e]) (list t t 'm))]))
(struct m-tag (v))
(define m-datum '(m-datum has a literal))
