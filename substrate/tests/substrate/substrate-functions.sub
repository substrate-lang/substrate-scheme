;; Functions defined with fixed parameters (lib/substrate.sub): a call
;; with that many arguments calls the function directly; the name used as
;; a value is one closure, the same in every module, whose code checks
;; the number of arguments; main can be one.
(require-unqualified substrate "../../lib/substrate/substrate.sub")
(require k "fixtures/known.sub")

(define (square x) (* x x))
(define hyp (lambda (a b) (+ (square a) (square b))))
(define (count-down n) (if (= n 0) 'done (count-down (- n 1))))

(define (main)
  (display (list (square 5) (hyp 3 4) (count-down 100000))) (newline)
  (display (map square '(1 2 3))) (newline)
  (display (apply hyp '(5 12))) (newline)
  (display (list (eq? square square) (eq? car car) (eq? k:add1 (k:add1-value)))) (newline)
  (display (list (procedure? square) (procedure? hyp) ((k:add1-value) 41))) (newline)
  (let ([f square]) (display (f 9))) (newline))
