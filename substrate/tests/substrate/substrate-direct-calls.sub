;; A function called by its name, which is compiled as a direct call where
;; it can be, does what a call of its value does (lib/substrate/substrate.sub):
;; case-lambda runs the first clause that takes the arguments either way,
;; and a call with the wrong number of arguments fails either way
;; (err-substrate-arity, err-substrate-arity-value).
(require-unqualified substrate "../../lib/substrate/substrate.sub")

(define f (case-lambda [args (list 'rest args)] [(x) (list 'one x)]))
(define g (case-lambda [(x) (list 'one x)] [args (list 'rest args)]))
(define h (case-lambda [(a b . r) (list 'two-or-more a b r)] [(x) (list 'one x)]))
(define (k x) x)

;; f called through its value.
(define (via f . args) (apply f args))

(define (show x) (write x) (newline))

(define (main)
  (show (list (f 42) (via f 42)))
  (show (list (g 42) (via g 42) (g 1 2) (via g 1 2)))
  (show (list (h 1) (via h 1) (h 1 2 3) (via h 1 2 3)))
  (show (list (k 1) (via k 1))))
