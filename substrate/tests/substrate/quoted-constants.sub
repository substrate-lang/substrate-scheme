;; Quoted data in kernel globals, as tests/quoted-constants.sub: quote
;; (lib/languages/substrate/values.sub) makes Substrate's values when the module
;; starts, so the globals are mutable.
(require print "../../lib/print.sub" newline)
(require sub "../../lib/languages/substrate/substrate.sub" write cons quote)
;; Quoted data is made in memory, values.sub's, which this module shares.
(memory from sub)

(global empty (mut i32) '())
(global yes (mut i32) '#t)
(global no (mut i32) '#f)
(global five (mut i32) '5)
(global built (mut i32) '(1 2))

(func (main)
  (write (cons five (cons yes (cons no empty)))) (print:newline)
  (write built) (print:newline))
