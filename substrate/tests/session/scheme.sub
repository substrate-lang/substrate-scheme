;; A session in Scheme: values printed, a trap reported, and syntax-rules macros.
(require-unqualified scheme "../../lib/scheme/scheme.sub")
(define (sq x) (* x x))
(sq 7)
(map sq '(1 2 3))
(display "hi")
(define counter (let ([n 0]) (lambda () (set! n (+ n 1)) n)))
(counter)
(counter)
(define-syntax swap! (syntax-rules () [(_ a b) (let ([t a]) (set! a b) (set! b t))]))
(define x 1)
(define y 2)
(swap! x y)
(list x y)
(car 5)
(error "my error" 42)
(list x y)
(define (sq x) (* x x x))
(sq 3)
"a string"
'sym
(= 1 2)
(nope)
(begin (define a 10) (define b (+ a 1)) (* a b))
(with-handlers ([exn? (lambda (e) (list 'caught (exn-message e)))]) (error "my error" 42))
(struct point (x y))
(point-x (point 3 4))
(let loop ([i 0] [acc '()]) (if (= i 5) (reverse acc) (loop (+ i 1) (cons (* i i) acc))))
