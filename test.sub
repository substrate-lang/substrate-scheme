;; What Scheme's test forms call: failures that write Scheme values, and output captured while a Scheme procedure runs.
(require-unqualified v "values.sub")
(require rt "runtime.sub")
(require-unqualified t std/test/test)

(provide test-done test-fail test-unequal test-output test-output-file)

;; test-done lets go of the value that a test's body gives.
(define (test-done [x datum]) (drop x))

(define (test-fail [message datum]) -> datum (throw test-failed (string-copy (datum->string message))))
(#%fact test-fail '(foreign diverges))

;; test-unequal fails with message and the two values, as write writes them.
(define (test-unequal [message datum] [got datum] [expected datum]) -> datum
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) (datum->string message))
    (buffer-add-string! (& b) "\n  got      ")
    (rt:write-value (& b) got #f)
    (buffer-add-string! (& b) "\n  expected ")
    (rt:write-value (& b) expected #f)
    (throw test-failed (buffer-string (& b)))))
(#%fact test-unequal '(foreign diverges))

;; test-output compares what the procedure thunk prints with text, and test-output-file compares it with a file
;; relative to the directory of module.
(define (test-output [text datum] [message datum] [thunk datum]) -> datum
  (compare-output! (captured thunk) (datum->string text) (datum->string message))
  (cast datum 0))
(#%fact test-output '(foreign free))

(define (test-output-file [module datum] [file datum] [message datum] [thunk datum]) -> datum
  (compare-output-file! (captured thunk) (datum->string module) (datum->string file) (datum->string message))
  (cast datum 0))
(#%fact test-output-file '(foreign free))

(define (captured [thunk datum]) -> string
  (let ([b (cast (ptr buffer) (malloc (sizeof buffer)))] [before (ptr buffer) 0])
    (rt:port-flush (rt:stdout-port))
    (set! (@ b) (make-buffer))
    (set! before (output-to! b))
    (drop (rt:call-closure thunk 0 (cast datum 0) (cast datum 0) (cast datum 0) (cast datum 0)))
    (rt:port-flush (rt:stdout-port))
    (output-to! before)
    (buffer-string b)))
