;; syntax-rules macros: literals, nested ellipses, dotted tails, data, and hygiene.
(language scheme)
(require-unqualified scheme/output)

(define-syntax swap!
  (syntax-rules ()
    [(_ a b) (let ([t a]) (set! a b) (set! b t))]))

(define-syntax my-let
  (syntax-rules ()
    [(_ ([name value] ...) body ...) ((lambda (name ...) body ...) value ...)]))

(define-syntax my-cond
  (syntax-rules (else)
    [(_ (else e ...)) (begin e ...)]
    [(_ (test e ...) clause ...) (if test (begin e ...) (my-cond clause ...))]))

(define-syntax flat
  (syntax-rules ()
    [(_ (x ...) ...) '((x ... end) ...)]
    [(_ first more ... last) (list 'head first 'tail last)]))

(define-syntax tail
  (syntax-rules ()
    [(_ a . rest) '(a rest)]))

(define-syntax tagged
  (syntax-rules ()
    [(_ 'point x y) (list 'point x y)]
    [(_ other x y) (list 'not-a-point 'other)]))

(define-syntax pairs
  (syntax-rules ()
    [(_ (k v) ...) (list (cons 'k v) ...)]))

(define (main)
  (let ([x 1] [t 2])
    (swap! x t)
    (write (list x t)) (newline))
  (write (my-let ([a 1] [b 2]) (+ a b))) (newline)
  (write (list (my-cond [#f 1] [else 2]) (my-cond [(= 1 1) 3] [else 4]))) (newline)
  (write (list (flat (1 2) (3)) (flat 1 2 3 4))) (newline)
  (write (tail 1 2 3)) (newline)
  (write (list (tagged point 1 2) (tagged 'box 1 2))) (newline)
  (write (pairs (a 1) (b 2))) (newline))

(test syntax-rules (expect-output-file "syntax-rules.out" (main)))
