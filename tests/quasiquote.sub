;; quasiquote in a Scheme module: splices, nesting and a dotted tail.
(language scheme scheme)
(require-unqualified output scheme/output)
(define (main)
  (let ([xs '(2 3)] [n 4])
    (write `(1 ,@xs ,n (nested ,(car xs)) `(deeper ,(n ,n)) . ,n)) (newline)))

(test quasiquote (expect-output-file "quasiquote.out" (main)))
