;; A module-level definition shadows an unqualified import throughout the module.
(language scheme scheme)
(require-unqualified output scheme/output)

(define (run)
  (display (map (lambda (x) (* x x)) '(1 2 3))) (newline)
  (display (even? 3)) (newline))

(define (map f xs) (if (null? xs) '() (cons (f (car xs)) (cons 'mine (map f (cdr xs))))))
(define (even? n) (if (= n 0) #t (odd? (- n 1))))
(define (odd? n) (if (= n 0) #f (even? (- n 1))))

(define (main) (run))

(test shadow-unqualified (expect-output-file "shadow-unqualified.out" (main)))
