;; Strings are immutable UTF-8, indexed by byte.
(language scheme)
(require-unqualified scheme/output)

(define (run)
  (let ([s "aλb€c😀"])
    (write (list (string-utf-8-length s) (string-utf-8-byte s 1) (string-ref/utf-8 s 1)
                 (string-ref/utf-8 s 4) (char-utf-8-length #\😀)))
    (newline)
    (write (list (substring/utf-8 s 1 4) (substring/utf-8 s 3) (string->list s)))
    (newline)
    (write (list (list->string (list #\x #\λ)) (string #\a #\b)
                 (bytes->string/utf-8 (bytes 104 105)) (bytes->string/utf-8 (bytes 97 206 187 98) #f 1 3)
                 (string->bytes/utf-8 "λ") (string-append "λ" "€")))
    (newline)))

(define (main) (run))

(test scheme-strings
  (expect-output "(12 206 #\\λ #\\€ 4)\n(\"λb\" \"b€c😀\" (#\\a #\\λ #\\b #\\€ #\\c #\\😀))\n(\"xλ\" \"ab\" \"hi\" \"λ\" #\"\\316\\273\" \"λ€\")" (main)))
