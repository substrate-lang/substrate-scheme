;; With order-b.sub: modules required in either order compile to the same bytes.
(language scheme)
(require-unqualified scheme/output)
(require m "fixtures/order-m.sub" m-twice m-tag m-datum)
(require n "fixtures/order-n.sub" n-twice n-tag n-datum)
(define (main)
  (write (list (m-twice 1) (n-twice 2) (m-tag 3) (n-tag 4) m-datum n-datum))
  (newline))

(test order-a
  (expect-output "((1 1 m) (2 2 n) #<m-tag> #<n-tag> (m-datum has a literal) (n-datum has a literal))" (main)))
