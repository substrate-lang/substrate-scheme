;; A match whose pattern fails leaves syntax-match's patterns as they were.
(language scheme scheme)
(require-unqualified output scheme/output)
(require macros compiler/macros syntax-match)
(struct pt (x y))

(begin-for-syntax
  (require-unqualified macros compiler/macros)
  (define (after-failure [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (try (local-expand (cadr parts)) [catch-all nil])
      (local-expand (caddr parts))
      (cadddr parts))))
(define-syntax after-failure after-failure)

(define (main)
  (write (after-failure (match 1 [(pt a) a]) (syntax-match (quote-syntax (pt 1 2)) [(pt a b) b]) 42))
  (newline))

(test match-after-error (expect-output "42" (main)))
