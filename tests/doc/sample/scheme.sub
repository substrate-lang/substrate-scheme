;; A module in Scheme: a function with a rest parameter, a value, a macro and a struct.
(language scheme std/languages/scheme)

(provide total limit)

;; total adds the numbers of its lists.
(define (total l . more)
  (apply + (append l (apply append more))))

(define limit 10)

(define-syntax unless-zero
  (syntax-rules () [(_ n e) (if (= n 0) 0 e)]))

(struct pair-of (left right))
