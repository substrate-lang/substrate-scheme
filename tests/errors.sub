(require-unqualified build std/test/build)

(test err-scheme-macro (expect-compile-error "fail/err-scheme-macro.sub" "err-scheme-macro.sub:4:15: error: for: expected (for x in list body ...)"))
(test err-scheme-struct-arity (expect-compile-error "fail/err-scheme-struct-arity.sub" "err-scheme-struct-arity.sub:4:15: error: pt takes 2 arguments, got 1"))
(test err-shadow-used (expect-compile-error "fail/err-shadow-used.sub" "error: define is defined here, but a macro use before this definition used the define it imports"))
(test err-spliced-location (expect-compile-error "fail/err-spliced-location.sub" "err-spliced-location.sub:4:1: error: expected i32, got void"))
(test err-substrate-form (expect-compile-error "fail/err-substrate-form.sub" "err-substrate-form.sub:4:25: error: scheme: a Scheme body cannot hold this Substrate form; write it in a define"))
(test err-syntax-rules-pattern (expect-compile-error "fail/err-syntax-rules-pattern.sub" "err-syntax-rules-pattern.sub:3:44: error: syntax-rules: this pattern variable appears twice in its pattern"))
