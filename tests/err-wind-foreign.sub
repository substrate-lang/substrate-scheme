;; dynamic-wind runs its after thunk for an exception that isn't Scheme's, a wasm tag's.
(language scheme scheme)
(require wasm compiler/wasm)
(wasm:tag foreign ())
(define (fail) (wasm:throw foreign) #f)
(define (run) (dynamic-wind (lambda () #f) fail (lambda () (display "the after thunk ran") (newline))))

(test err-wind-foreign #:traps "uncaught exception" #:output "the after thunk ran" (run))

