;; A lambda shares a variable it assigns with the function it is in, in a box.
(language scheme scheme)
(require-unqualified output scheme/output)
(define (count-from n) (let ([v n]) (lambda () (set! v (+ v v)) v)))
(define (run) (let ([c (count-from 3)]) (c) (display (c)) (newline)))
(define (main) (run))

(test scheme-capture (expect-output-file "scheme-capture.out" (main)))
