;; Pattern macros for other modules: while, and for x in list, whose in is a literal.
(language scheme)
(provide while for in)

(define-syntax while
  (syntax-rules ()
    [(_ test body ...) (let loop () (when test body ... (loop)))]))

(define-syntax in (syntax-rules ()))

(define-syntax for
  (syntax-rules (in)
    [(_ x in list body ...) (for-each (lambda (x) body ...) list)]))
