;; order-a.sub's modules, required in the other order.
(language scheme)
(require-unqualified scheme/output)
(require n "fixtures/order-n.sub" n-twice n-tag n-datum)
(require m "fixtures/order-m.sub" m-twice m-tag m-datum)
(define (main)
  (write (list (n-twice 2) (m-twice 1) (n-tag 4) (m-tag 3) n-datum m-datum))
  (newline))

(test order-b
  (expect-output "((2 2 n) (1 1 m) #<n-tag> #<m-tag> (n-datum has a literal) (m-datum has a literal))" (main)))
