;; Two modules that compile to the same bytes whichever order a program requires them in.
(require-unqualified host/fs)
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified std/test/run)
(require-unqualified std/string)

(test require-order #:grants ((toolchain))
  (let* ([d (scratch-directory)] [cache (shared-cache)])
    (expect-ran (sub "tests" "build" "order-a" "-o" (joined-path d "a") "-c" cache))
    (expect-ran (sub "tests" "build" "order-b" "-o" (joined-path d "b") "-c" cache))
    (expect-equal (compared-modules (joined-path d "a") (joined-path d "b")) 2)))

(define (compared-modules [a string] [b string]) -> u32
  (let ([names (slice string)] [n u32 0])
    (fs-list a (& names) 0)
    (for ([i u32 0]) (< i (-> names length)) (+= i 1)
      (let ([name (@ names i)])
        (when (and (or (string-prefix? name "order-m.") (string-prefix? name "order-n.")) (string-suffix? name ".wasm"))
          (+= n 1)
          (unless (== (text-in (joined-path a name)) (text-in (joined-path b name)))
            (throw test-failed (string-append 0 name " differs from order-a's"))))))
    n))

(define (text-in [path string]) -> string
  (let ([bytes (slice u8)]) (if (fs-read-file path (& bytes) 0) (cast string bytes) "")))

