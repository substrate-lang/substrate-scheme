(language scheme scheme)

;; A mistake in a tail call is located where the caller made it.
(define (first-of x)
  (car x))

(test err-backtrace #:traps "traps.sub:5:3" (first-of 5))

(test err-handler-not-taken #:traps "car: expected a pair, got 5"
  (with-handlers ([string? (lambda (s) s)])
    (car 5)))

;; A mistake such as car of a non-pair stops the program; handlers see only raised values.
(test err-mistake #:traps "car: expected a pair, got 5"
  (display (with-handlers ([(lambda (v) #t) (lambda (v) 'caught)]) (car 5))))

;; A raised value that no handler takes stops the program where it was raised.
(test err-raise-uncaught #:traps "uncaught exception: boom" (raise 'boom))

;; A call through a function's value with the wrong number of arguments names it.
(define (k x) x)
(define (via f . args) (apply f args))

(test err-scheme-arity-value #:traps "k: expected 1 argument, got 2" (via k 1 2))

(define (square x) (* x x))

(test err-scheme-arity #:traps "square: expected 1 argument, got 2" (display "before") (newline) (square 1 2))

;; A function checks how many arguments it was called with.
(test err-scheme-call #:traps "car: expected 1 argument, got 2" (car 1 2))

;; A case-lambda with no clause for the number of arguments given.
(define f (case-lambda [(a) a] [(a b c) c]))

(test err-scheme-clause #:traps "f: no clause takes 2 arguments" (f 1 2))

;; An eq? hash table's key must carry a hash; a pair does not.
(test err-scheme-eq-key
  #:traps "hash-set!: expected a key with a hash (a symbol, keyword, struct, number, character, boolean or ()); make-hash takes others, got (1 2)"
  (hash-set! (make-hasheq) (list 1 2) 'x))

;; (error 'who "format" v ...) stops with who and the format filled in.
(test err-scheme-error-format #:traps "parse: bad token \"}\" at 12" (error 'parse "bad token ~s at ~a" "}" 12))

;; error displays its message and writes its irritants.
(test err-scheme-error #:traps "bad things: x \"y\" 42 (1 #\\z)" (error "bad things:" 'x "y" 42 '(1 #\z)))

;; A format string ending in ~ is an error, its message written as it is.
(test err-scheme-format-tilde #:traps "format: the format string ends in ~" (format "abc~"))

;; hash-ref of a missing key with no default is an error.
(test err-scheme-hash-ref #:traps "hash-ref: no value found for key k" (hash-ref (make-hasheq) 'k))

;; An index outside a vector is an error that names the function.
(test err-scheme-index #:traps "vector-ref: index 2 is out of range" (vector-ref (vector 1 2) 2))

;; A byte index where a character is taken must be where one starts: byte 2 is inside λ.
(test err-scheme-inside-char #:traps "substring/utf-8: byte 2 is inside a character" (substring/utf-8 "aλb" 2 3))

;; map takes lists of one length.
(test err-scheme-map #:traps "map: all lists must have the same size" (map + '(1 2) '(1 2 3)))

;; A match with no clause for its subject is an error that shows it.
(test err-scheme-match #:traps "match: no clause matches (1 2 3)" (match '(1 2 3) [(a b) a] [(? string? s) s]))

;; Calling a value that is not a function is a run-time error.
(test err-scheme-not-function #:traps "called a value that is not a function" (let ([f 5]) (f 1)))

;; Scheme's integers are exact up to 64 bits.
(test err-scheme-overflow #:traps "integer overflow: integers are at most 64 bits" (* 9223372036854775807 2))

;; A function with a rest parameter still needs its required arguments.
(define (at-least-two a b . more) more)

(test err-scheme-rest #:traps "at-least-two: expected at least 2 arguments, got 1" (at-least-two 1))

;; A struct accessor takes only its own struct, even if another has the same fields.
(struct point (x y))
(struct vec2 (x y))

(test err-scheme-struct #:traps "point-x: expected a point, got #<vec2>" (point-x (vec2 1 2)))

;; A Scheme function names itself when given a value of the wrong type.
(test err-scheme-type #:traps "vector-ref: expected a vector, got (1 2)" (vector-ref '(1 2) 0))

;; bytes->string/utf-8 rejects bytes that are not UTF-8, unless given a replacement.
(test err-scheme-utf8 #:traps "bytes->string/utf-8: expected UTF-8 bytes, got #\"h\\300\\200\"" (bytes->string/utf-8 (bytes 104 192 128)))
