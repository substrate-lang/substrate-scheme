;; What substrate doc writes for a module in Scheme, whose definitions it finds through Scheme's doc-forms.
(require-unqualified host/fs)
(require-unqualified std/test/test)
(require-unqualified std/package/path)
(require-unqualified std/test/run)

(test doc #:grants ((toolchain))
  (let ([d (scratch-directory)])
    (expect-ran (sub "." "doc" "-o" d "tests/doc/sample"))
    (expect-equal (text-in (joined-path d "sample/scheme.txt")) (text-in "tests/doc/expected/scheme.txt"))))

(define (text-in [path string]) -> string
  (let ([bytes (slice u8)] [why error])
    (unless (fs-read-file path (& bytes) (& why)) (throw test-failed (error-text (& why))))
    (cast string bytes)))
