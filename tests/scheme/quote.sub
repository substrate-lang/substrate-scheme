;; quote and quasiquote on Scheme's data: nesting, interned symbols.
(language scheme std/languages/scheme)

(define (main)
  (write '(1 -2 (3 . 4) "five\n" #\x #\space sym #t #f ())) (newline)
  (let ([xs '(a b)] [n 7])
    (write `(list ,@xs ,n (nested ,(car xs)) end)) (newline)
    (write `(1 `(2 ,(3 ,n)))) (newline)
    (write `(dotted . ,n)) (newline))
  (write (eq? 'abc (string->symbol (symbol->string 'abc)))) (newline)
  (write (length '(1 2 3))) (newline)
  (write (append '(1 2) '(3))) (newline)
  (write (reverse '(1 2 3))) (newline)
  (write (string->symbol (string-append (symbol->string 'foo-) (symbol->string 'bar)))) (newline)
  (write "λ unicode ✓") (newline)
  (write (string-utf-8-length "λ")) (newline))
