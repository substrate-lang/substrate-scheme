;; append runs in constant stack, on a list of a million elements and a million lists.
(language scheme "../../lib/scheme/scheme.sub")

(define (count-up n)
  (let loop ([i n] [acc '()]) (if (= i 0) acc (loop (- i 1) (cons i acc)))))

(define (singletons l)
  (let loop ([l (reverse l)] [acc '()]) (if (null? l) acc (loop (cdr l) (cons (list (car l)) acc)))))

(define (run)
  (let ([long (count-up 1000000)])
    (write (list (length (append long '(end))) (length (apply append (singletons long)))
                 (car (apply append (singletons long)))))
    (newline)))
(define (main) (run))
