;; One of two modules required in either order: a macro in Substrate at phase 1, and a literal.
(language scheme std/languages/scheme)
(provide n-twice n-tag n-datum)
(define-syntax n-twice (syntax-rules () [(_ e) (let ([t e]) (list t t 'n))]))
(struct n-tag (v))
(define n-datum '(n-datum has a literal))
