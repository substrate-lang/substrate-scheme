;; One of two modules required in either order: a macro in Substrate at phase 1, and a literal.
(language scheme "../../../lib/languages/scheme/scheme.sub")
(provide m-twice m-tag m-datum)
(define-syntax m-twice (syntax-rules () [(_ e) (let ([t e]) (list t t 'm))]))
(struct m-tag (v))
(define m-datum '(m-datum has a literal))
