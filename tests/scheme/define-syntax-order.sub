;; Compile-time code runs at once, in source order.
(language scheme "../../lib/scheme/scheme.sub")
(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (define order datum nil)
  (define (note [x datum]) -> datum (set! order (cons x order)) x)
  (define (order-of [stx datum]) -> datum (datum->syntax stx `(quote ,(reverse order)) stx)))
(define-syntax a (note 'a))
(begin-for-syntax (note 'b))
(define-syntax c (note 'c))
(define-syntax order order-of)

(define (run) (write (order)) (newline))
(define (main) (run))
