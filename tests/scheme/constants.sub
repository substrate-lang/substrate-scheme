;; wasm's constants mean the same in a Scheme module, where bare literals are values.
(language scheme "../../lib/languages/scheme/scheme.sub")
(require substrate "../../compiler/substrate.sub")
(require wasm "../../compiler/wasm.sub")
(wasm:global limit i32 (wasm:i32.const 7))
(wasm:func (main)
  (substrate:printf "~a\n" (wasm:i32.add (wasm:i32.const 40) (wasm:i32.const 2)))
  (substrate:printf "~a\n" (wasm:i64.const -9000000000))
  (substrate:printf "~a\n" (wasm:i32.trunc_f64_s (wasm:f64.mul (wasm:f64.const 2.5) (wasm:f64.const 4))))
  (substrate:printf "~a\n" (wasm:i32.add limit (wasm:i32.trunc_f32_s (wasm:f32.const 1.5)))))
