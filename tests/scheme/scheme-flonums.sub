;; Flonums: write gives the fewest digits that read back; string->number reads decimals.
(language scheme "../../lib/languages/scheme/scheme.sub")

(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))

(define (run)
  (show 2.5 0.1 0.3 100.0 1234.5 0.001 0.0012345678 9999999999.0 -0.0 0.0)
  (show 1e10 1.5e10 1e-4 1e21 1e23 123456789012345680000.0 9007199254740993.0 123e-20)
  (show 1.7976931348623157e308 2.2250738585072014e-308 5e-324 +inf.0 -inf.0 +nan.0)
  (show (string->number "1.5") (string->number "-2e3") (string->number ".5e-1") (string->number "1e400")
        (string->number "-inf.0") (string->number "1.5.") (string->number "e5") (string->number "12x")
        (string->number "99999999999999999999x") (number->string 0.1) (number->string 1e100)))

(define (main) (run))
