;; A direct call of a function does what a call of its value does.
(language scheme std/languages/scheme)

(define f (case-lambda [args (list 'rest args)] [(x) (list 'one x)]))
(define g (case-lambda [(x) (list 'one x)] [args (list 'rest args)]))
(define h (case-lambda [(a b . r) (list 'two-or-more a b r)] [(x) (list 'one x)]))
(define (k x) x)

(define (via f . args) (apply f args))

(define (show x) (write x) (newline))

(define (main)
  (show (list (f 42) (via f 42)))
  (show (list (g 42) (via g 42) (g 1 2) (via g 1 2)))
  (show (list (h 1) (via h 1) (h 1 2 3) (via h 1 2 3)))
  (show (list (k 1) (via k 1))))
