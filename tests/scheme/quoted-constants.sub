;; Quoted data in wasm globals, made when the module starts.
(require scheme scheme write cons quote)
(require v scheme/values datum)
(require wasm compiler/wasm)
(wasm:memory from scheme)

(wasm:global empty (mut i32) '())
(wasm:global yes (mut i32) '#t)
(wasm:global no (mut i32) '#f)
(wasm:global five (mut i32) '5)
(wasm:global built (mut i32) '(1 2))

(define (main)
  (write (cons (cast datum five) (cons (cast datum yes) (cons (cast datum no) (cast datum empty))))) (printf "\n")
  (write (cast datum built)) (printf "\n"))
