;; Quoted data is made when the module starts; each kind survives; equal symbols are one.
(language scheme scheme)

(define (show x) (write x) (newline))

(define (main)
  (show '(a "b" #\c -7 1073741824 -9223372036854775808 18446744073709551615 (#t #f ()) 2.5))
  (show '(lambda (x) (f x "s" 3)))
  (show (eq? 'same 'same))
  (show (eqv? '2.5 2.5)))
