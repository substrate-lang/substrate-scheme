;; local-expand: a macro expands part of its input, looks at it, and uses it.
(require-unqualified std/test/test)
(require scheme scheme write quote)
(require wasm compiler/wasm)
(wasm:memory from scheme)
(begin-for-syntax (require-unqualified compiler/macros))

(define (double [x i32]) -> i32 (* x 2))

(begin-for-syntax
  (define (head-of [stx datum]) -> datum
    (let ([x (local-expand (cadr (syntax->list stx)))])
      #`(quote #,(car (syntax->list x))))))
(define-syntax head-of head-of)

(begin-for-syntax
  (define (expanded [stx datum]) -> datum
    (local-expand (cadr (syntax->list stx)))))
(define-syntax expanded expanded)

(begin-for-syntax
  (define (with-tmp [stx datum]) -> datum
    #`(let ([tmp 1]) #,(local-expand (cadr (syntax->list stx))))))
(define-syntax with-tmp with-tmp)

(define (main)
  (write (head-of (double 5))) (printf "\n")
  (write (head-of 5)) (printf "\n")
  (write (head-of (let* ([a 1] [b a]) b))) (printf "\n")
  (printf "~a\n" (expanded (let ([a 20]) (+ a (double 11)))))
  (let ([k 5])
    (printf "~a\n" (expanded (* k 2))))
  (let ([tmp 100])
    (printf "~a\n" (with-tmp (+ tmp 1)))))

(test local-expand (expect-output-file "local-expand.out" (main)))
