;; Scheme's forms and functions: numbers, characters, strings, vectors, lists, output.
(language scheme scheme)
(require-unqualified output scheme/output)

(define area
  (case-lambda
    [(side) (* side side)]
    [(w h) (* w h)]
    [(w h . more) (list w h more)]))

(define (counter)
  (let ([n 0])
    (case-lambda [() n] [(k) (set! n (+ n k)) n])))

(define (classify x)
  (case x
    [(1 2 3) 'small]
    [(#\a) 'letter-a]
    [(x y) 'letter]
    [else 'other]))

(define (sum-to n)
  (do ([i 0 (+ i 1)] [acc 0 (+ acc i)]) ((> i n) acc)))

(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))

(define (run)
  (show (area 3) (area 3 4) (area 1 2 3 4))
  (let ([c (counter)]) (c 5) (c 10) (show (c)))
  (show (classify 2) (classify #\a) (classify 'y) (classify "z"))
  (show (sum-to 100) (case (string-append "a" "b") [("ab") 'equal] [else 'not-equal]))
  (show (+) (+ 1) (+ 1 2 3 4 5) (- 5) (- 10 1 2) (*) (* 2 3 4))
  (show (< 1 2 3) (< 1 3 2) (= 2 2 2) (>= 3 3 1) (max 3 9 4) (min 3 9 4) (abs -7))
  (show (quotient -7 2) (remainder -7 2) (modulo -7 2) (modulo 7 -2))
  (show (bitwise-and 12 10) (bitwise-ior 12 10) (bitwise-xor 12 10) (bitwise-not 0))
  (show (arithmetic-shift 1 40) (arithmetic-shift -1024 -3) (arithmetic-shift 5 -70))
  (show (number->string 255) (number->string -255 16) (string->number "-9223372036854775808")
        (string->number "ff" 16) (string->number "12x"))
  (show (even? 10) (odd? 10) (zero? 0) (positive? -1) (negative? -1) (integer? 5) (number? 'a))
  (show (char->integer #\A) (integer->char 955) (char<? #\a #\b #\c) (char-upcase #\q)
        (char-alphabetic? #\1) (char-numeric? #\1) (char-whitespace? #\space) (char-utf-8-length #\λ))
  (show (string-append) (string-append "ab" "cd" "ef") (string=? "a" "a") (string<? "abc" "abd")
        (string->symbol "hello") (symbol->string 'world) (string->bytes/utf-8 "hé")
        (bytes->string/utf-8 (bytes 104 255 105) #\?) (string->keyword "key") (keyword? '#:key))
  (let ([v (make-vector 3 0)])
    (vector-set! v 1 'x)
    (show v (vector-length v) (vector-ref v 1) (vector->list (vector 1 2 3))
          (list->vector '(a b)) (vector-copy (vector 1 2 3 4) 1 3)))
  (let ([b (make-bytes 4 65)])
    (bytes-set! b 0 255)
    (bytes-copy! b 2 (bytes 34 92))
    (show b (bytes-ref b 0) (bytes-append (bytes 1) (bytes 2 3)) (subbytes b 1)
          (bytes->list (bytes 7 8)) (list->bytes '(104 105))))
  (show (map + '(1 2 3) '(10 20 30)) (map (lambda (x) (* x x)) '(1 2 3))
        (filter odd? '(1 2 3 4 5)) (foldl cons '() '(1 2 3)) (foldr cons '() '(1 2 3))
        (foldl (lambda (a b acc) (+ acc (* a b))) 0 '(1 2) '(3 4)))
  (show (andmap odd? '(1 3)) (andmap odd? '(1 2)) (ormap (lambda (x) (and (> x 1) x)) '(1 2 3))
        (andmap + '(1 2) '(3 4)))
  (show (memv 2 '(1 2 3)) (member "b" '("a" "b")) (assq 'b '((a 1) (b 2))) (assoc "b" '(("b" . 2)))
        (list-ref '(a b c) 2) (list-tail '(a b c) 1) (last-pair '(1 2 3)) (append '(1) '(2) '() '(3 4)))
  (show (cadr '(1 2 3)) (cddr '(1 2 3)) (caddr '(1 2 3)) (length '(1 2 3)) (apply max 1 '(5 2)))
  (show (eqv? 100 100) (eqv? #\a #\a) (equal? (list 1 "a" (vector 2)) (list 1 "a" (vector 2)))
        (eqv? 9223372036854775807 9223372036854775807))
  (show (format "~a is ~s~%" "x" "x") (format "~~ ~v" 'sym))
  (printf "~a + ~a = ~a~n" 1 2 (+ 1 2))
  (write "a \"quoted\" string") (display " ") (display "a displayed string") (display " ")
  (write #\a) (display #\a) (newline)
  (show "tab\there\r\x0;\x7f;" #\tab #\nul #\x1 #\delete (quote (quote x)) (quote (quote-syntax y)))
  (let ([p (open-output-bytes)])
    (write (list 'a "b") p) (write-byte 32 p) (write-bytes (bytes 99 100) p) (newline p)
    (show (file-position p) (get-output-bytes p) (call-with-output-bytes (lambda (q) (display "hi" q)))))
  (show (instantiate "empty" (bytes 0 97 115 109 1 0 0 0)) (string? (instantiate "bad" (bytes 1 2 3)))))

(define (main) (run))

(test scheme-library (expect-output-file "scheme-library.out" (main)))
