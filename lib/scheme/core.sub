;; The core of Scheme: its basic forms and its primitives.

(require rt "runtime.sub")
(require v "values.sub" quote quasiquote)
(require wasm "../../compiler/wasm.sub")

(provide [define scheme-define] [lambda scheme-lambda] [case-lambda scheme-case-lambda]
         [set! scheme-set!] [#%app app] [#%datum datum] [#%module-begin scheme-module-begin]
         [if scheme-if] [let scheme-let] [let* scheme-let*] letrec
         [struct scheme-struct] quote quasiquote scheme-body scheme-wrapper
         eq? eqv? equal? not boolean? procedure?
         live-nodes
         cons car cdr caar cadr cdar cddr caddr cdddr cadddr pair? null? list? list length unshared-pair?
         reverse append apply unsafe-car unsafe-cdr
         number? integer? fixnum? + - * quotient remainder modulo < > <= >= = zero? positive?
         negative? even? odd? abs min max bitwise-and bitwise-ior bitwise-xor bitwise-not
         arithmetic-shift number->string string->number fixnum fixnum-value
         char? char->integer integer->char char=? char<? char>? char<=? char>=?
         char-alphabetic? char-numeric? char-whitespace? char-upcase char-downcase
         char-utf-8-length
         string? string=? string<? string>? string<=? string>=? string-append string->list
         list->string string string->bytes/utf-8 bytes->string/utf-8
         string-utf-8-length string-utf-8-byte string-ref/utf-8 substring/utf-8
         symbol? symbol->string string->symbol symbol<? keyword? keyword->string string->keyword
         box box? unbox set-box!
         vector? vector make-vector vector-length vector-ref vector-set! vector->list
         list->vector vector-fill! vector-copy
         bytes? bytes make-bytes bytes-length bytes-ref bytes-set! subbytes bytes-copy
         bytes-copy! bytes-append bytes->list list->bytes
         make-hash make-hasheq make-hasheqv hash? hash-count hash-ref hash-has-key? hash-set!
         hash-update! hash-remove! hash-clear! hash-keys hash-values hash->list hash-for-each
         write display newline write-byte write-bytes open-output-bytes get-output-bytes
         call-with-output-bytes file-position printf eprintf format error interaction-value
         raise call-with-handlers dynamic-wind exn? exn-message
         file->bytes file->string file-exists? display-to-file current-command-line-arguments instantiate exit)

(wasm:memory from rt)
(wasm:table from rt)

;; ---- forms ----

(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")
  (require lower "lower.sub" convert-body convert-lambda infer-module! in-pass? closure-of)

  (define (core [name datum]) -> datum (core-syntax 0 name 0))

  (define (nth [l datum] [i u32]) -> datum (list-ref l i))

  (define (number [n i32]) -> datum (datum->syntax #'here (fixnum n) 0))

  ;; ---- fresh names ----

  (define counter i32 0)
  (define (fresh-name [prefix datum]) -> datum
    (+= counter 1)
    (datum->syntax #'here (string->symbol (format '"~a~a" `(,prefix ,(fixnum counter)))) 0))

  ;; ---- modules ----

  (define (scheme-module-begin [stx datum]) -> datum
    #`(begin #,(core-syntax #'here '(begin (require %rt "runtime.sub") (memory from %rt) (table from %rt)) #'here)
             #,@(cdr (syntax->list stx))))

  ;; ---- bodies ----

  (define (scheme-body [stx datum]) -> datum
    (let* ([parts (syntax->list stx)] [name (cadr parts)] [params (syntax->list (caddr parts))])
      (convert-body #'here params (borrowed-of name params (syntax->list (cadddr parts))) (cdr (cdddr parts)))))

  (define (scheme-expr [stx datum]) -> datum
    (ensure-inferred!)
    (convert-body #'here nil nil (cdr (syntax->list stx))))

  ;; ---- the module's functions ----
  (define functions datum nil)
  (define inferred datum nil)
  (define (record-function! [name datum] [params datum] [body datum] [bs datum])
    (set! functions (cons `(,name ,params ,body ,(fixnum defined-free) ,bs) functions)))

  (define (ensure-inferred!) -> datum
    (unless (null? functions)
      (let* ([waiting functions] [flags (begin (set! functions nil) (infer-module! #'here waiting))])
        (set! inferred (append flags inferred))
        (for/each ([f flags])
          (syntax-local-lift-definition #`(#%fact #,(car f) '(scheme-function #,@(for/list ([x (cdr f)]) (if (== (fixnum-value x) 1) #'1 #'0))))))))
    inferred)

  (define (flags-for [name datum] [l datum]) -> datum
    (cond [(null? l) nil]
          [(== (syntax-e (car (car l))) (syntax-e name)) (cdr (car l))]
          [else (flags-for name (cdr l))]))

  (define (borrowed-of [name datum] [params datum] [bs datum]) -> datum
    (let ([flags (flags-for name (ensure-inferred!))])
      (for/each ([p params])
        (when (and (pair? flags) (== (fixnum-value (car flags)) 1) (not (borrowed? p bs))) (set! bs (cons p bs)))
        (set! flags (if (pair? flags) (cdr flags) nil)))
      bs))

  (define (recorded-function? [f datum]) -> i32 (ormap (lambda ([r datum]) -> i32 (free-identifier=? f (car r))) functions))

  ;; ---- define, lambda, calls, literals ----

  ;; ((required ...) . rest), rest a name or #f.
  (define (parse-params [ps datum]) -> datum
    (when (identifier? ps) (return (cons nil ps)))
    (let ([l (splice-list ps)] [required nil])
      (while (pair? l)
        (unless (identifier? (car l)) (raise-syntax-error 0 '"expected a parameter name" (car l)))
        (set! required (cons (car l) required))
        (set! l (cdr l)))
      (unless (or (null? l) (identifier? l)) (raise-syntax-error 0 '"expected a parameter name after the dot" ps))
      (cons (reverse required) (if (null? l) 0 l))))

  (define slots datum (syntax->list #'(a0 a1 a2 a3)))

  (define (argument [i u32]) -> datum (if (< i 4) (nth slots i) #`(rt:extra-arg #,(number (- i 4)))))

  (define (param-inits [ps datum] [i u32]) -> datum
    (if (null? ps) nil (cons #`[#,(car ps) v:datum #,(argument i)] (param-inits (cdr ps) (+ i 1)))))

  (define (slots-from [n u32]) -> datum
    (for/list ([s slots] [i (numbers-below 4)]) (if (< (cast u32 (fixnum-value i)) n) #'0 s)))

  (define (dispatch [cs datum] [name datum] [single i32]) -> datum
    (when (null? cs) (return #`(rt:no-clause-error '#,name nargs)))
    (let* ([c (car cs)] [p (parse-params (car c))] [rest (cdr p)] [n (length (car p))]
           [inits (append (param-inits (car p) 0)
                          (if rest `(,#`[#,rest v:datum (rt:rest-arguments #,(number n) nargs #,@(slots-from n))]) nil))])
      #`(if #,(if rest #`(wasm:i32.ge_u nargs #,(number n)) #`(wasm:i32.eq nargs #,(number n)))
            (let (#,@inits) #,@(cdr c))
            #,(if single
                  #`(rt:arity-error '#,name #,(number n) #,(number (if rest 1 0)) nargs)
                  (dispatch (cdr cs) name 0)))))

  (define (marked-lambda [cs datum] [name datum] [single i32] [where datum]) -> datum
    (syntax-rewrap
     where
     (syntax-e #`(#%app (quote-syntax #%scheme-lambda)
                        (#,(core 'let) ([nargs i32 0] [a0 i32 0] [a1 i32 0] [a2 i32 0] [a3 i32 0])
                          #,(dispatch cs (if name name #'#f) single))))))

  (define (case-lambda-clauses [clauses datum]) -> datum
    (for/list ([c clauses])
      (let ([l (syntax->list c)])
        (when (or (not l) (null? l)) (raise-syntax-error 'case-lambda '"expected a clause: [params body ...]" c))
        l)))

  (define (headed? [e datum] [id datum]) -> datum
    (let ([parts (syntax->list e)])
      (if (and parts (pair? parts) (identifier? (car parts)) (free-identifier=? (car parts) id)) parts 0)))

  (define (marked-lambda-of [e datum] [name datum]) -> datum
    (let ([l (headed? e #'scheme-lambda)] [cl (headed? e #'scheme-case-lambda)])
      (cond [l (marked-lambda `(,(cdr l)) name 1 e)]
            [cl (marked-lambda (case-lambda-clauses (cdr cl)) name 0 e)]
            [else 0])))

  (define (placed-lambda [m datum]) -> datum (if (in-pass?) m (convert-lambda #'here m)))

  ;; #:borrow (x ...): read without being owned.
  (define (scheme-define [stx datum]) -> datum
    (set! defined-free 0)
    (let* ([parts (syntax->list stx)] [opts (define-options (cddr parts))]
           [inline (fixnum-value (car opts))] [borrowed (cadr opts)] [body (caddr opts)])
      (if (identifier? (cadr parts))
          (let* ([name (cadr parts)] [e (car body)] [fixed (fixed-lambda e)] [clauses (case-lambda-of e)]
                 [k (if clauses (first-fixed clauses) 0)])
            (when fixed (return (known-function name (car fixed) (cdr fixed) 0 inline borrowed)))
            (when k (return (known-case-lambda name clauses k inline borrowed e)))
            (when inline (raise-syntax-error 'define '"only a function with fixed parameters can be #:inline" stx))
            (when borrowed (raise-syntax-error 'define '"only a function with fixed parameters can borrow them" stx))
            (let ([f (marked-lambda-of e name)])
              #`(#,(core 'global) #,name (mut i32) (scheme-expr #,(if f f e)))))
          (let* ([head (splice-list (cadr parts))] [name (car head)] [p (parse-params (cdr head))])
            (unless (cdr p) (return (known-function name (car p) body 0 inline borrowed)))
            (when inline (raise-syntax-error 'define '"only a function with fixed parameters can be #:inline" stx))
            (when borrowed (raise-syntax-error 'define '"only a function with fixed parameters can borrow them" stx))
            #`(#,(core 'global) #,name (mut i32) (scheme-expr #,(marked-lambda `((,(cdr head) ,@body)) name 1 stx)))))))

  ;; #:free: the function's value needs no counting: a fixnum, a boolean or ().
  (define defined-free i32 0)

  ;; (inline borrowed body), inline a fixnum.
  (define (define-options [forms datum]) -> datum
    (let ([inline 0] [borrowed datum 0])
      (while (pair? forms)
        (let ([o (syntax-e (car forms))])
          (cond [(== o '#:inline) (set! inline 1) (set! forms (cdr forms))]
                [(== o '#:free) (set! defined-free 1) (set! forms (cdr forms))]
                [(== o '#:borrow)
                 (unless (and (pair? (cdr forms)) (syntax->list (cadr forms)))
                   (raise-syntax-error 'define '"expected the borrowed parameters, (x ...), after #:borrow"
                                       (if (pair? (cdr forms)) (cadr forms) (car forms))))
                 (set! borrowed (cadr forms))
                 (set! forms (cddr forms))]
                [else (break)])))
      `(,(fixnum inline) ,borrowed ,forms)))

  (define (case-lambda-of [e datum]) -> datum
    (let ([parts (headed? e #'scheme-case-lambda)]) (if parts (case-lambda-clauses (cdr parts)) 0)))

  (define (first-fixed [cs datum]) -> datum
    (let ([fewest-rest -1])
      (for/each ([c cs])
        (let* ([p (parse-params (car c))] [n (cast i32 (length (car p)))])
          (if (cdr p)
              (when (or (< fewest-rest 0) (< n fewest-rest)) (set! fewest-rest n))
              (when (or (< fewest-rest 0) (> fewest-rest n)) (return c)))))
      0))

  (define (known-case-lambda [name datum] [cs datum] [k datum] [inline i32] [borrowed datum] [where datum]) -> datum
    (let* ([params (car (parse-params (car k)))]
           [calling (for/list ([c cs]) (if (== c k) `(,(car k) ,#`(#,name #,@params)) c))])
      (known-function name params (cdr k) (marked-lambda calling name 0 where) inline borrowed)))

  (define (fixed-lambda [e datum]) -> datum
    (let ([parts (headed? e #'scheme-lambda)])
      (if (and parts (pair? (cdr parts)))
          (let ([p (parse-params (cadr parts))]) (if (cdr p) 0 (cons (car p) (cddr parts))))
          0)))

  (define (known-function [name datum] [params datum] [body datum] [closure datum] [inline i32] [borrowed datum]) -> datum
    (let ([n (length params)] [value (hidden-name name '".value")] [code (hidden-name name '".code")]
          [maker (hidden-name name '".closure")] [bs (if borrowed (syntax->list borrowed) nil)])
      (for/each ([b bs])
        (unless (borrowed? b params) (raise-syntax-error 'define '"#:borrow names a parameter the function does not have" b)))
      (record-function! name params body bs)
      #`(begin
          (define (#,name #,@(for/list ([p params]) #`[#,p v:datum])) #,@(if inline (syntax->list #'(#:inline)) nil)
            -> v:datum (scheme-body #,name (#,@params) (#,@bs) #,@body))
          #,@(if defined-free `(,#`(#%fact #,name '(result free))) nil)
          #,@(if closure
                 nil
                 `(,#`(define (#,code [self v:datum] [nargs i32] [a0 v:datum] [a1 v:datum] [a2 v:datum] [a3 v:datum]) -> v:datum
                        (if (wasm:i32.eq nargs #,(number n))
                            (scheme-wrapper #,name (#,@params) (#,@bs) #,@(for/list ([i (numbers-below n)]) (argument (cast u32 (fixnum-value i)))))
                            (rt:arity-error '#,name #,(number n) 0 nargs)))))
          (#,(core 'global) #,value (mut i32) 0)
          (define (#,maker) -> v:datum
            (if (wasm:i32.eqz #,value)
                (#,(core 'set!) #,value (cast i32 (v:permanent! #,(if closure #`(scheme-expr #,closure) #`(rt:make-closure (wasm:func-index #,code) 0))))))
            (cast v:datum #,value))
          (closure-fact #,name #,value #,maker))))

  (define (closure-fact [stx datum]) -> datum
    (syntax-match stx
      [(_ name value maker)
       #`(#%fact #,name '(scheme-closure #,(datum->syntax stx (identifier-name value) stx) #,(datum->syntax stx (identifier-name maker) stx)))]))

  (define (numbers-below [n u32]) -> datum
    (let ([l nil])
      (while (> n 0) (-= n 1) (set! l (cons (fixnum n) l)))
      l))

  (define (borrowed? [x datum] [l datum]) -> i32 (ormap (lambda ([y datum]) -> i32 (== (syntax-e x) (syntax-e y))) l))

  (define (scheme-wrapper [stx datum]) -> datum
    (let* ([parts (syntax->list stx)] [name (cadr parts)] [params (syntax->list (caddr parts))]
           [bs (borrowed-of name params (syntax->list (cadddr parts)))] [args (cdr (cdddr parts))]
           [call #`(#,name #,@args)])
      (if (null? bs)
          call
          #`(let ([r v:datum #,call])
              #,@(for/list ([p params] [a args] #:when (borrowed? p bs)) #`(drop-value #,a))
              r))))

  (define (hidden-name [id datum] [suffix datum]) -> datum
    (datum->syntax #'here (string->symbol (string-append (symbol->string (syntax-e id)) suffix)) id))

  (define (scheme-lambda [stx datum]) -> datum (placed-lambda (marked-lambda-of stx 0)))

  (define (scheme-case-lambda [stx datum]) -> datum (placed-lambda (marked-lambda-of stx 0)))

  (define (scheme-set! [stx datum]) -> datum
    #`(begin (#,(core 'set!) #,@(cdr (syntax->list stx))) '#f))

  (define (app [stx datum]) -> datum
    (let* ([parts (cdr (syntax->list stx))] [f (car parts)] [args (cdr parts)])
      (when (and (not (in-pass?)) (or (not (function-name? f)) (recorded-function? f) (scheme-function? f)))
        (return #`(scheme-expr #,stx)))
      (cond [(function-name? f) (if (takes? f (length args)) #`(#%app #,f #,@args) (call-value #`(cast v:datum #,(closure-of f)) args))]
            [(identifier? f) (call-value (if (local-binding (local-expand f)) f #`(cast v:datum #,f)) args)]
            [else #`(let ([fv v:datum #,f]) #,(call-value #'fv args))])))

  (define (call-value [head datum] [args datum]) -> datum
    (let ([n (length args)])
      (if (<= n 4)
          #`(wasm:call-indirect (i32 i32 i32 i32 i32 i32 -> i32) (closure-code* #,head) #,head #,(number n)
                                #,@(append args (list-tail (syntax->list #'(0 0 0 0)) n)))
          (let ([ts (for/list ([a args]) (fresh-name 't))])
            #`(let (#,@(for/list ([t ts] [a args]) #`[#,t v:datum #,a]))
                #,@(for/list ([t (list-tail ts 4)] [i (numbers-below (- n 4))]) #`(rt:set-extra-arg! #,(number (fixnum-value i)) #,t))
                (wasm:call-indirect (i32 i32 i32 i32 i32 i32 -> i32) (closure-code* #,head) #,head #,(number n) #,@(take ts 4)))))))

  (define (function-name? [f datum]) -> i32 (and (identifier? f) (== (identifier-binding-kind f) 'function)))

  (define (scheme-function? [f datum]) -> i32
    (let ([fs (try (syntax-local-facts f) [catch compile-error (m x l) nil])])
      (ormap (lambda ([entry datum]) -> i32
               (let ([v (syntax->datum (caddr entry))]) (and (pair? v) (== (car v) 'scheme-function))))
             fs)))

  (define (takes? [f datum] [n u32]) -> i32
    (let ([sig (identifier-function-signature f)] [k u32 0])
      (while (!= (car sig) '->) (+= k 1) (set! sig (cdr sig)))
      (== k n)))

  (define (datum-form [stx datum]) -> datum #`(quote #,(cadr (syntax->list stx))))

  (define (list-form [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (if parts (for/fold ([l #''()]) ([e (reverse (cdr parts))]) #`(cons #,e #,l)) #'list-function)))

  ;; ---- control ----

  (define (scheme-if [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      #`(if #,(cadr parts) #,(caddr parts) #,(if (== (length parts) 4) (car (cdddr parts)) #''#f))))

  (define (binding-names [bs datum]) -> datum (for/list ([b bs]) (car (syntax->list b))))

  (define (datum-bindings [bs datum]) -> datum
    (for/list ([b bs]) (let ([l (syntax->list b)]) (if (== (length l) 2) #`[#,(car l) v:datum #,(cadr l)] b))))

  (define (scheme-let [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      (if (identifier? (cadr parts))
          (let* ([bs (syntax->list (caddr parts))]
                 [f (datum->syntax 0 (syntax-e #`(scheme-lambda (#,@(binding-names bs)) #,@(cdddr parts))) stx)])
            #`(letrec ([#,(cadr parts) #,f]) (app #,(cadr parts) #,@(for/list ([b bs]) (cadr (syntax->list b))))))
          #`(let (#,@(datum-bindings (syntax->list (cadr parts)))) #,@(cddr parts)))))

  (define (scheme-let* [stx datum]) -> datum
    (let ([parts (syntax->list stx)])
      #`(let* (#,@(datum-bindings (syntax->list (cadr parts)))) #,@(cddr parts))))

  (define (letrec [stx datum]) -> datum
    (let* ([parts (syntax->list stx)] [bs (syntax->list (cadr parts))])
      #`(let (#,@(for/list ([x (binding-names bs)]) #`[#,x v:datum '#f]))
          #,@(for/list ([b bs]) (let ([l (syntax->list b)]) #`(#,(core 'set!) #,(car l) #,(cadr l))))
          (let () #,@(cddr parts)))))

  (define (scheme-struct [stx datum]) -> datum
    (let* ([parts (syntax->list stx)]
           [name (cadr parts)]
           [specs (syntax->list (caddr parts))]
           [all-mutable (struct-options (cdddr parts))]
           [fields (for/list ([s specs]) (field-name s))]
           [make (datum->syntax #'here (syntax-e name) name)]
           [pred (named-after name '"" '"?")])
      (unless (identifier? name) (raise-syntax-error 0 '"expected (struct name (field ...) option ...)" stx))
      (unless specs (raise-syntax-error 'struct '"expected a list of fields" (caddr parts)))
      #`(begin
          (#,(core 'global) D (mut i32) (rt:make-struct-type '#,name '(#,@fields)))
          (scheme-define (#,make #,@fields)
            (let ([s v:datum (struct-inline (cast v:datum D) #,(number (length fields)))])
              #,@(for/list ([f fields] [i (numbers-below (length fields))]) #`(rt:struct-init! s #,(number (fixnum-value i)) #,f))
              s))
          (define-syntax #,name
            (struct-transformer
             (quote-syntax (struct-info #,name #,make #,pred (#,@(for/list ([s specs]) (accessor-name name s))) (#,@fields)))))
          (scheme-define (#,pred v) (bool (struct-is? v (cast v:datum D))))
          #,@(accessors name specs all-mutable 0))))

  (define (struct-use [info datum] [stx datum]) -> datum
    (let ([make (caddr (syntax->list info))])
      (if (identifier? stx) make (datum->syntax make (cons make (cdr (syntax->list stx))) stx))))
  (define (struct-transformer [info datum]) -> datum (make-transformer (cast u32 struct-use) info))

  (define (struct-options [opts datum]) -> i32
    (for/each ([o opts])
      (unless (== (syntax-e o) '#:mutable) (raise-syntax-error 'struct '"the only option is #:mutable" o)))
    (pair? opts))

  (define (field-name [spec datum]) -> datum
    (when (identifier? spec) (return spec))
    (let ([l (syntax->list spec)])
      (unless (and l (== (length l) 2) (identifier? (car l)) (== (syntax-e (cadr l)) '#:mutable))
        (raise-syntax-error 'struct '"expected a field: id or [id #:mutable]" spec))
      (car l)))

  (define (named-after [id datum] [prefix datum] [suffix datum]) -> datum
    (datum->syntax id (string->symbol (string-append prefix (string-append (symbol->string (syntax-e id)) suffix))) id))

  (define (accessor-name [name datum] [spec datum]) -> datum
    (named-after (field-name spec) (string-append (symbol->string (syntax-e name)) '"-") '""))

  (define (accessors [name datum] [specs datum] [all-mutable i32] [i i32]) -> datum
    (when (null? specs) (return nil))
    (let* ([spec (car specs)]
           [field (field-name spec)]
           [prefix (string-append (symbol->string (syntax-e name)) '"-")]
           [get (accessor-name name spec)]
           [rest (accessors name (cdr specs) all-mutable (+ i 1))]
           [getter #`(scheme-define (#,get v) #:borrow (v)
                       (if (struct-is? v (cast v:datum D)) (struct-field v #,(number i)) (rt:not-a-struct v (cast v:datum D) '#,get)))])
      (if (not (or all-mutable (not (identifier? spec))))
          (cons getter rest)
          (let ([set (named-after field (string-append '"set-" prefix) '"!")])
            (cons getter
                  (cons #`(scheme-define (#,set v x) #:borrow (v)
                            (if (struct-is? v (cast v:datum D))
                                (begin (rt:struct-set! v #,(number i) x) '#f)
                                (rt:not-a-struct v (cast v:datum D) '#,set)))
                        rest))))))
)

(define-syntax scheme-module-begin scheme-module-begin)
(define-syntax scheme-define scheme-define)
(define-syntax scheme-lambda scheme-lambda)
(define-syntax scheme-case-lambda scheme-case-lambda)
(define-syntax scheme-set! scheme-set!)
(define-syntax app app)
(define-syntax datum datum-form)
(define-syntax list list-form)
(define-syntax scheme-if scheme-if)
(define-syntax scheme-let scheme-let)
(define-syntax scheme-let* scheme-let*)
(define-syntax letrec letrec)
(define-syntax scheme-struct scheme-struct)
(define-syntax scheme-body scheme-body)
(define-syntax scheme-expr scheme-expr)
(define-syntax scheme-wrapper scheme-wrapper)
(define-syntax closure-fact closure-fact)

;; ---- functions ----
;; A value is a datum, a word; a literal is a wasm number unless quoted.

(define (dup-value [d v:datum]) #:inline -> v:datum (v:dup-inline d))
(#%fact dup-value '(foreign owned))
(define (drop-value [d v:datum]) #:inline (v:drop-inline d))

;; ---- fixnums inline ----
;; A fixnum n is stored as 2n + 1. Adding two stored values and subtracting 1 gives the stored sum,
;; and the i32 addition overflows exactly when the sum is out of fixnum range. The encoding
;; preserves order, so comparisons can compare the stored words directly.

(define (bool [x i32]) #:inline -> v:datum (if x (v:true-value) 0))
(#%fact bool '(foreign free))

(define (both-fixnums? [a v:datum] [b v:datum]) #:inline -> i32 (wasm:i32.and (wasm:i32.and a b) 1))

(define (fixnum-word [w i32]) #:inline -> v:datum (cast v:datum w))
(#%fact fixnum-word '(foreign owned))

(define (add-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (if (both-fixnums? a b)
      (let ([r (wasm:i32.add a (wasm:i32.sub b 1))])
        (if (wasm:i32.lt_s (wasm:i32.and (wasm:i32.xor a r) (wasm:i32.xor (wasm:i32.sub b 1) r)) 0) (rt:add a b) (cast v:datum r)))
      (rt:add a b)))
(#%fact add-values '(foreign owned))

(define (sub-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (if (both-fixnums? a b)
      (let ([d (wasm:i32.sub a b)])
        (if (wasm:i32.lt_s (wasm:i32.and (wasm:i32.xor a b) (wasm:i32.xor a d)) 0) (rt:sub a b) (cast v:datum (wasm:i32.add d 1))))
      (rt:sub a b)))
(#%fact sub-values '(foreign owned))

(define (mul-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (if (both-fixnums? a b)
      (let ([m (wasm:i64.mul (wasm:i64.extend_i32_s (wasm:i32.shr_s a 1)) (wasm:i64.extend_i32_s (wasm:i32.sub b 1)))])
        (if (wasm:i64.eq (wasm:i64.extend_i32_s (wasm:i32.wrap_i64 m)) m) (cast v:datum (wasm:i32.add (wasm:i32.wrap_i64 m) 1)) (rt:mul a b)))
      (rt:mul a b)))
(#%fact mul-values '(foreign owned))

(define (quo-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (if (wasm:i32.and (both-fixnums? a b) (wasm:i32.ne b 1))
      (let ([q (wasm:i32.div_s (wasm:i32.shr_s a 1) (wasm:i32.shr_s b 1))])
        (if (wasm:i32.eq q 1073741824) (rt:quo a b) (cast v:datum (wasm:i32.or (wasm:i32.shl q 1) 1))))
      (rt:quo a b)))
(#%fact quo-values '(foreign owned))

(define (rem-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (if (wasm:i32.and (both-fixnums? a b) (wasm:i32.ne b 1))
      (cast v:datum (wasm:i32.or (wasm:i32.shl (wasm:i32.rem_s (wasm:i32.shr_s a 1) (wasm:i32.shr_s b 1)) 1) 1))
      (rt:rem a b)))
(#%fact rem-values '(foreign owned))

(define (mod-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (if (wasm:i32.and (both-fixnums? a b) (wasm:i32.ne b 1))
      (let ([r (wasm:i32.rem_s (wasm:i32.shr_s a 1) (wasm:i32.shr_s b 1))])
        (cast v:datum (wasm:i32.or (wasm:i32.shl (if (wasm:i32.and (wasm:i32.ne r 0) (wasm:i32.lt_s (wasm:i32.xor r b) 0)) (wasm:i32.add r (wasm:i32.shr_s b 1)) r) 1) 1)))
      (rt:floor-remainder a b)))
(#%fact mod-values '(foreign owned))

(define (lt-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (bool (if (both-fixnums? a b) (wasm:i32.lt_s a b) (rt:compare 0 a b))))
(#%fact lt-values '(foreign owned))
(define (gt-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (bool (if (both-fixnums? a b) (wasm:i32.gt_s a b) (rt:compare 1 a b))))
(#%fact gt-values '(foreign owned))
(define (le-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (bool (if (both-fixnums? a b) (wasm:i32.le_s a b) (rt:compare 2 a b))))
(#%fact le-values '(foreign owned))
(define (ge-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (bool (if (both-fixnums? a b) (wasm:i32.ge_s a b) (rt:compare 3 a b))))
(#%fact ge-values '(foreign owned))
(define (eq-values [a v:datum] [b v:datum]) #:inline -> v:datum
  (bool (if (both-fixnums? a b) (wasm:i32.eq a b) (rt:compare 4 a b))))
(#%fact eq-values '(foreign owned))

;; A closure is a node of kind 9 (runtime.sub's kind-closure): code, a count, the values.
(define (closure-code* [c v:datum]) #:inline -> i32
  (if (v:node-tagged? c 9) (wasm:i32.load c 4) (cast i32 (rt:closure-code c))))
(#%fact closure-code* '(foreign raw))
(define (closure-cap [c v:datum] [i i32]) #:inline -> v:datum (cast v:datum (wasm:i32.load (wasm:i32.add c (wasm:i32.shl i 2)) 12)))
(#%fact closure-cap '(foreign borrowed))
(define (closure-inline [code i32] [n i32]) #:inline -> v:datum
  (let ([c (v:alloc-inline (wasm:i32.add 12 (wasm:i32.shl n 2)) 9)])
    (wasm:i32.store c code 4)
    (wasm:i32.store c n 8)
    c))
(#%fact closure-inline '(foreign owned))
(define (closure-set-inline! [c v:datum] [i i32] [v v:datum]) #:inline (wasm:i32.store (wasm:i32.add c (wasm:i32.shl i 2)) v 12))
(#%fact closure-set-inline! '(foreign void 2))

;; A struct is a node of kind 14 (runtime.sub's kind-struct): type, hash, count, fields.
(define (struct-is? [v v:datum] [t v:datum]) #:inline -> i32
  (if (v:node-tagged? v 14) (wasm:i32.eq (wasm:i32.load v 4) t) 0))
(#%fact struct-is? '(foreign raw))
(define (struct-field [v v:datum] [i i32]) #:inline -> v:datum
  (v:dup-inline (cast v:datum (wasm:i32.load (wasm:i32.add v (wasm:i32.shl i 2)) 16))))
(#%fact struct-field '(foreign owned))
(define (struct-inline [t v:datum] [n i32]) #:inline -> v:datum
  (let ([s (v:alloc-inline (wasm:i32.add 16 (wasm:i32.shl n 2)) 14)])
    (wasm:i32.store s t 4)
    (wasm:i32.store s (rt:fresh-hash) 8)
    (wasm:i32.store s n 12)
    s))
(#%fact struct-inline '(foreign owned 0))
(define (fix [n i32]) #:inline -> v:datum (v:make-integer (wasm:i64.extend_i32_s n)))
(#%fact fix '(foreign owned))

(define (fixnum [n i32]) -> v:datum (fix n))
(#%fact fixnum '(foreign owned))
(define (fixnum-value [v v:datum]) -> i32 (rt:fixnum-value-of v))
(#%fact fixnum-value '(foreign raw))

(scheme-define (live-nodes) (fix (v:live-nodes)))

;; ---- equivalence and predicates ----

(scheme-define (eq? a b) #:free #:inline #:borrow (a b) (bool (wasm:i32.eq a b)))
(scheme-define (eqv? a b) #:free #:borrow (a b) (bool (rt:eqv? a b)))
(scheme-define (equal? a b) #:free #:borrow (a b) (bool (rt:equal-values? a b)))
(scheme-define (not x) #:free #:inline #:borrow (x) (bool (wasm:i32.eqz x)))
(scheme-define (boolean? x) #:free #:inline #:borrow (x) (bool (v:boolean-datum? x)))
(scheme-define (procedure? x) #:free #:borrow (x) (bool (rt:procedure? x)))

;; ---- pairs and lists ----

(define (list-length [l v:datum] [who v:datum]) -> i32
  (let ([n 0] [t l])
    (wasm:block done
      (wasm:loop next
        (wasm:br-if done (wasm:i32.eqz (v:pair-cell? t)))
        (set! n (wasm:i32.add n 1))
        (set! t (v:pair-cdr t))
        (wasm:br next)))
    (if (wasm:i32.eqz (v:null-cell? t)) (rt:wrong-type who '"a list" l))
    n))
(#%fact list-length '(foreign raw))

(define (reverse-list [l v:datum] [who v:datum]) -> v:datum
  (let ([acc '()] [t l])
    (wasm:block done
      (wasm:loop next
        (wasm:br-if done (wasm:i32.eqz (v:pair-cell? t)))
        (set! acc (v:cons-inline (dup-value (v:pair-car t)) acc))
        (set! t (v:pair-cdr t))
        (wasm:br next)))
    (if (wasm:i32.eqz (v:null-cell? t)) (rt:wrong-type who '"a list" l))
    acc))
(#%fact reverse-list '(foreign owned))

(define (append-2 [a v:datum] [b v:datum]) -> v:datum
  (let ([r (reverse-list a '"append")] [t v:datum 0])
    (set! t r)
    (wasm:block done
      (wasm:loop next
        (wasm:br-if done (wasm:i32.eqz (v:pair-cell? t)))
        (set! b (v:cons-inline (dup-value (v:pair-car t)) b))
        (set! t (v:pair-cdr t))
        (wasm:br next)))
    (drop-value r)
    b))
(#%fact append-2 '(foreign owned 1))

(scheme-define (cons a d) #:inline (v:cons-inline a d))
(define (car-read [p v:datum]) #:inline -> v:datum (if (v:pair-cell? p) (v:pair-car p) (rt:wrong-type 'car '"a pair" p)))
(#%fact car-read '(foreign borrowed))
(define (cdr-read [p v:datum]) #:inline -> v:datum (if (v:pair-cell? p) (v:pair-cdr p) (rt:wrong-type 'cdr '"a pair" p)))
(#%fact cdr-read '(foreign borrowed))
(scheme-define (car p) #:inline #:borrow (p) (if (v:pair-cell? p) (v:pair-car p) (rt:wrong-type 'car '"a pair" p)))
(scheme-define (cdr p) #:inline #:borrow (p) (if (v:pair-cell? p) (v:pair-cdr p) (rt:wrong-type 'cdr '"a pair" p)))
(define (car-of [p v:datum] [who v:datum]) #:inline -> v:datum (if (v:pair-cell? p) (v:pair-car p) (rt:wrong-type who '"a pair" p)))
(#%fact car-of '(foreign borrowed))
(define (cdr-of [p v:datum] [who v:datum]) #:inline -> v:datum (if (v:pair-cell? p) (v:pair-cdr p) (rt:wrong-type who '"a pair" p)))
(#%fact cdr-of '(foreign borrowed))
(scheme-define (caar p) #:borrow (p) (car-of (car-of p 'caar) 'caar))
(scheme-define (cadr p) #:borrow (p) (car-of (cdr-of p 'cadr) 'cadr))
(scheme-define (cdar p) #:borrow (p) (cdr-of (car-of p 'cdar) 'cdar))
(scheme-define (cddr p) #:borrow (p) (cdr-of (cdr-of p 'cddr) 'cddr))
(scheme-define (caddr p) #:borrow (p) (car-of (cdr-of (cdr-of p 'caddr) 'caddr) 'caddr))
(scheme-define (cdddr p) #:borrow (p) (cdr-of (cdr-of (cdr-of p 'cdddr) 'cdddr) 'cdddr))
(scheme-define (cadddr p) #:borrow (p) (car-of (cdr-of (cdr-of (cdr-of p 'cadddr) 'cadddr) 'cadddr) 'cadddr))
(scheme-define (pair? x) #:free #:inline #:borrow (x) (bool (v:pair-cell? x)))
(scheme-define (unshared-pair? x) #:free #:inline #:borrow (x) (bool (if (v:pair-cell? x) (v:unique-cell? x) 0)))
(scheme-define (null? x) #:free #:inline #:borrow (x) (bool (v:null-cell? x)))
(scheme-define (list? x) #:free #:borrow (x) (bool (v:list? x)))
(scheme-define (list-function . xs) xs)
(scheme-define (length l) #:free #:borrow (l) (fix (list-length l '"length")))
(scheme-define (reverse l) #:borrow (l) (reverse-list l '"reverse"))
(define (unsafe-car [p v:datum]) #:inline -> v:datum (v:pair-car p))
(#%fact unsafe-car '(foreign borrowed))
(define (unsafe-cdr [p v:datum]) #:inline -> v:datum (v:pair-cdr p))
(#%fact unsafe-cdr '(foreign borrowed))

(define (append-all [ls v:datum]) -> v:datum
  (let ([l (reverse-list ls '"append")] [acc v:datum 0] [t v:datum 0])
    (set! acc (dup-value (v:pair-car l)))
    (set! t (v:pair-cdr l))
    (wasm:block done
      (wasm:loop next
        (wasm:br-if done (v:null-cell? t))
        (set! acc (append-2 (v:pair-car t) acc))
        (set! t (v:pair-cdr t))
        (wasm:br next)))
    (drop-value l)
    acc))
(#%fact append-all '(foreign owned))

(scheme-define append #:borrow (a)
  (scheme-case-lambda
    [(a b) (append-2 a b)]
    [() '()]
    [(a . rest) (append-all (v:cons-inline a rest))]))

(scheme-define (apply f first . more) (rt:apply-list f (rt:spread (v:cons-inline first more))))

;; ---- numbers ----

(scheme-define (number? x) #:free #:inline #:borrow (x) (bool (wasm:i32.or (v:integer-datum? x) (v:node-tagged? x 7))))
(scheme-define (integer? x) #:free #:inline #:borrow (x) (bool (v:integer-datum? x)))
(scheme-define (fixnum? x) #:free #:inline #:borrow (x) (bool (wasm:i32.and x 1)))

(define (fold-op [op i32] [a v:datum] [l v:datum]) -> v:datum
  (wasm:block done
    (wasm:loop next
      (wasm:br-if done (wasm:i32.eqz (v:pair-cell? l)))
      (let ([r (arith op a (v:pair-car l))])
        (drop-value a)
        (set! a r))
      (set! l (v:pair-cdr l))
      (wasm:br next)))
  a)
(#%fact fold-op '(foreign owned 1))

(define (arith [op i32] [a v:datum] [b v:datum]) -> v:datum
  (if (wasm:i32.eq op 0) (return (rt:add a b)))
  (if (wasm:i32.eq op 1) (return (rt:sub a b)))
  (if (wasm:i32.eq op 2) (return (rt:mul a b)))
  (rt:bitwise op a b))
(#%fact arith '(foreign owned))

(define (chain [kind i32] [op i32] [a v:datum] [l v:datum]) -> v:datum
  (let ([ok 1])
    (wasm:block done
      (wasm:loop next
        (wasm:br-if done (wasm:i32.eqz (v:pair-cell? l)))
        (if (wasm:i32.eqz (if (wasm:i32.eqz kind)
                              (rt:compare op a (v:pair-car l))
                              (if (wasm:i32.eq kind 1) (rt:char-compare op a (v:pair-car l)) (rt:string-compare op a (v:pair-car l)))))
            (set! ok 0))
        (set! a (v:pair-car l))
        (set! l (v:pair-cdr l))
        (wasm:br next)))
    (bool ok)))
(#%fact chain '(foreign owned))

(scheme-define + #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (add-values a b)]
    [(a b c) (add-values (add-values a b) c)]
    [() '0]
    [(a) (rt:add a '0)]
    [(a b . more) (fold-op 0 (add-values a b) more)]))

(scheme-define - #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (sub-values a b)]
    [(a b c) (sub-values (sub-values a b) c)]
    [(a) (sub-values '0 a)]
    [(a b . more) (fold-op 1 (sub-values a b) more)]))

(scheme-define * #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (mul-values a b)]
    [(a b c) (mul-values (mul-values a b) c)]
    [() '1]
    [(a) (rt:mul a '1)]
    [(a b . more) (fold-op 2 (mul-values a b) more)]))

(scheme-define (quotient a b) #:inline #:borrow (a b) (quo-values a b))
(scheme-define (remainder a b) #:inline #:borrow (a b) (rem-values a b))
(scheme-define (modulo a b) #:inline #:borrow (a b) (mod-values a b))

(scheme-define < #:free #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (lt-values a b)]
    [(a . more) (chain 0 0 a more)]))
(scheme-define > #:free #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (gt-values a b)]
    [(a . more) (chain 0 1 a more)]))
(scheme-define <= #:free #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (le-values a b)]
    [(a . more) (chain 0 2 a more)]))
(scheme-define >= #:free #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (ge-values a b)]
    [(a . more) (chain 0 3 a more)]))
(scheme-define = #:free #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (eq-values a b)]
    [(a . more) (chain 0 4 a more)]))

(scheme-define (zero? a) #:free #:inline #:borrow (a)
  (bool (if (wasm:i32.and a 1) (wasm:i32.eq a 1) (wasm:i64.eqz (rt:int-value a 'zero?)))))
(scheme-define (positive? a) #:free #:inline #:borrow (a)
  (bool (if (wasm:i32.and a 1) (wasm:i32.gt_s a 1) (wasm:i64.gt_s (rt:int-value a 'positive?) (wasm:i64.const 0)))))
(scheme-define (negative? a) #:free #:inline #:borrow (a)
  (bool (if (wasm:i32.and a 1) (wasm:i32.lt_s a 0) (wasm:i64.lt_s (rt:int-value a 'negative?) (wasm:i64.const 0)))))
(scheme-define (even? a) #:free #:inline #:borrow (a)
  (bool (if (wasm:i32.and a 1) (wasm:i32.eqz (wasm:i32.and a 2)) (wasm:i64.eqz (wasm:i64.and (rt:int-value a 'even?) (wasm:i64.const 1))))))
(scheme-define (odd? a) #:free #:inline #:borrow (a)
  (bool (if (wasm:i32.and a 1) (wasm:i32.and a 2) (wasm:i64.ne (wasm:i64.and (rt:int-value a 'odd?) (wasm:i64.const 1)) (wasm:i64.const 0)))))
(scheme-define (abs a) #:borrow (a) (if (wasm:i64.lt_s (rt:int-value a '"abs") (wasm:i64.const 0)) (rt:sub '0 a) a))

(define (extreme [a v:datum] [l v:datum] [op i32]) -> v:datum
  (rt:int-value a (if (wasm:i32.eq op 0) '"min" '"max"))
  (wasm:block done
    (wasm:loop next
      (wasm:br-if done (wasm:i32.eqz (v:pair-cell? l)))
      (if (rt:compare (if (wasm:i32.eq op 0) 1 0) a (v:pair-car l)) (set! a (v:pair-car l)))
      (set! l (v:pair-cdr l))
      (wasm:br next)))
  (dup-value a))
(#%fact extreme '(foreign owned))

(scheme-define (min a . more) (extreme a more 0))
(scheme-define (max a . more) (extreme a more 1))

(scheme-define bitwise-and #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (if (both-fixnums? a b) (fixnum-word (wasm:i32.and a b)) (rt:bitwise 3 a b))]
    [() '-1]
    [(a . more) (fold-op 3 (rt:bitwise 3 a '-1) more)]))
(scheme-define bitwise-ior #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (if (both-fixnums? a b) (fixnum-word (wasm:i32.or a b)) (rt:bitwise 4 a b))]
    [() '0]
    [(a . more) (fold-op 4 (rt:bitwise 4 a '0) more)]))
(scheme-define bitwise-xor #:inline #:borrow (a b)
  (scheme-case-lambda
    [(a b) (if (both-fixnums? a b) (fixnum-word (wasm:i32.or (wasm:i32.xor a b) 1)) (rt:bitwise 5 a b))]
    [() '0]
    [(a . more) (fold-op 5 (rt:bitwise 5 a '0) more)]))
(scheme-define (bitwise-not a) #:borrow (a) (v:make-integer (wasm:i64.xor (rt:int-value a '"bitwise-not") (wasm:i64.const -1))))
(scheme-define (arithmetic-shift a k) #:borrow (a k) (rt:shift a k))

(scheme-define number->string #:borrow (n)
  (scheme-case-lambda
    [(n) (rt:number-string-of n '10)]
    [(n radix) (rt:number-string-of n radix)]))

(scheme-define string->number #:borrow (s)
  (scheme-case-lambda
    [(s) (rt:parse-number (rt:string-arg s '"string->number") (wasm:i64.const 10))]
    [(s radix) (rt:parse-number (rt:string-arg s '"string->number") (rt:radix-value radix '"string->number"))]))

;; ---- characters ----

(scheme-define (char? x) #:free #:inline #:borrow (x) (bool (v:char-datum? x)))
(scheme-define (char->integer c) #:free #:borrow (c) (fix (rt:char-arg c '"char->integer")))
(scheme-define (integer->char n) #:borrow (n)
  (let ([x (rt:int-value n '"integer->char")])
    (if (wasm:i32.or (wasm:i64.gt_u x (wasm:i64.const 1114111))
                     (wasm:i32.and (wasm:i64.ge_u x (wasm:i64.const 55296)) (wasm:i64.le_u x (wasm:i64.const 57343))))
        (return (rt:wrong-type '"integer->char" '"a Unicode scalar value" n)))
    (v:integer->char (wasm:i32.wrap_i64 x))))
(scheme-define char=? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:char-compare 4 a b))] [(a . more) (chain 1 4 a more)]))
(scheme-define char<? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:char-compare 0 a b))] [(a . more) (chain 1 0 a more)]))
(scheme-define char>? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:char-compare 1 a b))] [(a . more) (chain 1 1 a more)]))
(scheme-define char<=? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:char-compare 2 a b))] [(a . more) (chain 1 2 a more)]))
(scheme-define char>=? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:char-compare 3 a b))] [(a . more) (chain 1 3 a more)]))

(define (ascii-letter? [c i32]) -> i32
  (wasm:i32.or (wasm:i32.and (wasm:i32.ge_u c 65) (wasm:i32.le_u c 90)) (wasm:i32.and (wasm:i32.ge_u c 97) (wasm:i32.le_u c 122))))
(#%fact ascii-letter? '(foreign raw))

(scheme-define (char-alphabetic? c) #:free #:borrow (c) (bool (ascii-letter? (rt:char-arg c '"char-alphabetic?"))))
(scheme-define (char-numeric? c) #:free #:borrow (c)
  (let ([x (rt:char-arg c '"char-numeric?")]) (bool (wasm:i32.and (wasm:i32.ge_u x 48) (wasm:i32.le_u x 57)))))
(scheme-define (char-whitespace? c) #:free #:borrow (c)
  (let ([x (rt:char-arg c '"char-whitespace?")])
    (bool (wasm:i32.or (wasm:i32.eq x 32) (wasm:i32.and (wasm:i32.ge_u x 9) (wasm:i32.le_u x 13))))))
(scheme-define (char-upcase c) #:borrow (c)
  (let ([x (rt:char-arg c '"char-upcase")])
    (if (wasm:i32.and (wasm:i32.ge_u x 97) (wasm:i32.le_u x 122)) (v:integer->char (wasm:i32.sub x 32)) c)))
(scheme-define (char-downcase c) #:borrow (c)
  (let ([x (rt:char-arg c '"char-downcase")])
    (if (wasm:i32.and (wasm:i32.ge_u x 65) (wasm:i32.le_u x 90)) (v:integer->char (wasm:i32.add x 32)) c)))
(scheme-define (char-utf-8-length c) #:free #:borrow (c) (fix (rt:utf8-length (rt:char-arg c '"char-utf-8-length"))))

;; ---- strings and symbols ----

(scheme-define (symbol<? a b) #:free #:borrow (a b)
  (bool (wasm:i32.lt_s (rt:string-order (v:symbol->string (rt:symbol-arg a '"symbol<?"))
                                        (v:symbol->string (rt:symbol-arg b '"symbol<?")))
                       0)))

(scheme-define (string? x) #:free #:inline #:borrow (x) (bool (v:node-tagged? x 5)))
(scheme-define (symbol? x) #:free #:inline #:borrow (x) (bool (v:node-tagged? x 3)))
(scheme-define string=? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:string-compare 4 a b))] [(a . more) (chain 2 4 a more)]))
(scheme-define string<? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:string-compare 0 a b))] [(a . more) (chain 2 0 a more)]))
(scheme-define string>? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:string-compare 1 a b))] [(a . more) (chain 2 1 a more)]))
(scheme-define string<=? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:string-compare 2 a b))] [(a . more) (chain 2 2 a more)]))
(scheme-define string>=? #:free #:borrow (a b)
  (scheme-case-lambda [(a b) (bool (rt:string-compare 3 a b))] [(a . more) (chain 2 3 a more)]))

(scheme-define (string-append . strings) (rt:string-append-list strings '"string-append"))

(scheme-define (symbol->string x) #:borrow (x) (v:symbol->string (rt:symbol-arg x '"symbol->string")))
(scheme-define (string->symbol x) #:borrow (x) (v:string->symbol (rt:string-arg x '"string->symbol")))
(scheme-define (keyword? x) #:free #:inline #:borrow (x) (bool (v:node-tagged? x 4)))
(scheme-define (keyword->string k) #:borrow (k)
  (if (wasm:i32.eqz (v:node-tagged? k 4)) (return (rt:wrong-type '"keyword->string" '"a keyword" k)))
  (v:keyword->string k))
(scheme-define (string->keyword x) #:borrow (x) (v:string->keyword (rt:string-arg x '"string->keyword")))

(scheme-define string->bytes/utf-8 #:borrow (s)
  (scheme-case-lambda
    [(s) (rt:string->bytes-of s '"string->bytes/utf-8")]
    [(s err-byte) (rt:string->bytes-of s '"string->bytes/utf-8")]))
(scheme-define bytes->string/utf-8 #:borrow (v)
  (scheme-case-lambda
    [(v) (rt:bytes->string-of v '#f '#f '#f '"bytes->string/utf-8")]
    [(v err) (rt:bytes->string-of v err '#f '#f '"bytes->string/utf-8")]
    [(v err start) (rt:bytes->string-of v err start '#f '"bytes->string/utf-8")]
    [(v err start end) (rt:bytes->string-of v err start end '"bytes->string/utf-8")]))
(scheme-define (string->list s) #:borrow (s) (rt:string->list-of s '"string->list"))
(scheme-define (list->string chars) #:borrow (chars) (rt:list->string-of chars '"list->string"))
(scheme-define (string . chars) (rt:list->string-of chars '"string"))

(scheme-define (string-utf-8-length s) #:free #:inline #:borrow (s)
  (fix (v:string-length (rt:string-arg s 'string-utf-8-length))))
(scheme-define (string-utf-8-byte s k) #:free #:inline #:borrow (s k)
  (rt:string-arg s 'string-utf-8-byte)
  (fix (v:string-byte s (rt:index-of k (v:string-length s) 'string-utf-8-byte))))
(scheme-define (string-ref/utf-8 s k) #:borrow (s k) (rt:string-ref-char s k))
(scheme-define substring/utf-8 #:borrow (s start end)
  (scheme-case-lambda
    [(s start end) (rt:substring-of s start end '"substring/utf-8")]
    [(s start) (rt:substring-of s start '#f '"substring/utf-8")]))

;; ---- boxes ----

(scheme-define (box v) (rt:make-box v))
(scheme-define (box? x) #:free #:borrow (x) (bool (rt:box? x)))
(scheme-define (unbox b) #:borrow (b) (if (rt:box? b) (rt:unbox b) (rt:wrong-type '"unbox" '"a box" b)))
(scheme-define (set-box! b v) #:borrow (b)
  (if (rt:box? b) (rt:set-box! b v) (wasm:drop (rt:wrong-type '"set-box!" '"a box" b)))
  '#f)

;; ---- vectors ----

(scheme-define (vector? x) #:free #:borrow (x) (bool (rt:vector? x)))
(scheme-define (vector . xs) (rt:list->vector xs '"vector"))
(scheme-define make-vector #:borrow (n)
  (scheme-case-lambda
    [(n fill) (rt:make-vector (rt:count-of n '"make-vector") fill)]
    [(n) (rt:make-vector (rt:count-of n '"make-vector") '#f)]))
(scheme-define (vector-length v) #:free #:borrow (v) (fix (rt:vector-length (rt:vector-arg v '"vector-length"))))
(scheme-define (vector-ref v k) #:borrow (v k)
  (rt:vector-arg v '"vector-ref")
  (rt:vector-ref v (rt:index-of k (rt:vector-length v) '"vector-ref")))
(scheme-define (vector-set! v k x) #:borrow (v k)
  (rt:vector-arg v '"vector-set!")
  (rt:vector-set! v (rt:index-of k (rt:vector-length v) '"vector-set!") x)
  '#f)
(scheme-define (vector->list v) #:borrow (v) (rt:vector->list (rt:vector-arg v '"vector->list")))
(scheme-define (list->vector l) #:borrow (l) (rt:list->vector l '"list->vector"))
(scheme-define (vector-fill! v x) #:borrow (v) (rt:vector-fill! (rt:vector-arg v '"vector-fill!") x) '#f)
(scheme-define vector-copy #:borrow (v)
  (scheme-case-lambda
    [(v) (rt:vector-copy v '#f '#f '"vector-copy")]
    [(v start) (rt:vector-copy v start '#f '"vector-copy")]
    [(v start end) (rt:vector-copy v start end '"vector-copy")]))

;; ---- byte strings ----

(scheme-define (bytes? x) #:free #:borrow (x) (bool (rt:bytes? x)))
(scheme-define (bytes . bs) (rt:bytes-of-list bs '"bytes"))
(scheme-define make-bytes #:borrow (n)
  (scheme-case-lambda
    [(n) (rt:make-bytes (rt:count-of n '"make-bytes") 0)]
    [(n fill) (rt:make-bytes (rt:count-of n '"make-bytes") (rt:byte-arg fill '"make-bytes"))]))
(scheme-define (bytes-length v) #:free #:borrow (v) (fix (rt:bytes-length (rt:bytes-arg v '"bytes-length"))))
(scheme-define (bytes-ref v k) #:free #:borrow (v k)
  (rt:bytes-arg v '"bytes-ref")
  (fix (rt:bytes-ref v (rt:index-of k (rt:bytes-length v) '"bytes-ref"))))
(scheme-define (bytes-set! v k b) #:borrow (v k b)
  (rt:bytes-arg v '"bytes-set!")
  (rt:bytes-set! v (rt:index-of k (rt:bytes-length v) '"bytes-set!") (rt:byte-arg b '"bytes-set!"))
  '#f)
(scheme-define (bytes-copy v) #:borrow (v) (rt:subbytes v '#f '#f '"bytes-copy"))
(scheme-define subbytes #:borrow (v start)
  (scheme-case-lambda
    [(v start) (rt:subbytes v start '#f '"subbytes")]
    [(v start end) (rt:subbytes v start end '"subbytes")]))
(scheme-define (bytes->list v) #:borrow (v) (rt:bytes->list (rt:bytes-arg v '"bytes->list")))
(scheme-define (list->bytes l) #:borrow (l) (rt:list->bytes l))
(scheme-define bytes-copy! #:borrow (to at from)
  (scheme-case-lambda
    [(to at from) (rt:bytes-copy! to at from '#f '#f)]
    [(to at from start) (rt:bytes-copy! to at from start '#f)]
    [(to at from start end) (rt:bytes-copy! to at from start end)]))
(scheme-define (bytes-append . vs) (rt:bytes-append-list vs))

;; ---- hash tables ----

(scheme-define make-hasheq
  (scheme-case-lambda [() (rt:make-hash-table 0)] [(assocs) (rt:make-table-from 0 assocs '"make-hasheq")]))
(scheme-define make-hasheqv
  (scheme-case-lambda [() (rt:make-hash-table 1)] [(assocs) (rt:make-table-from 1 assocs '"make-hasheqv")]))
(scheme-define make-hash
  (scheme-case-lambda [() (rt:make-hash-table 2)] [(assocs) (rt:make-table-from 2 assocs '"make-hash")]))
(scheme-define (hash? x) #:free #:borrow (x) (bool (rt:table? x)))
(scheme-define (hash-count t) #:free #:borrow (t) (fix (rt:hash-count t '"hash-count")))

(scheme-define hash-ref #:borrow (t k failure)
  (scheme-case-lambda
    [(t k failure) (rt:hash-ref-value t k failure 1 '"hash-ref")]
    [(t k) (rt:hash-ref-value t k '#f 0 '"hash-ref")]))

(scheme-define (hash-has-key? t k) #:free #:borrow (t k) (bool (rt:hash-has-key? t k '"hash-has-key?")))
(scheme-define (hash-set! t k v) #:borrow (t) (rt:hash-set-value! t k v '"hash-set!") '#f)

(define (hash-update* [t v:datum] [k v:datum] [updater v:datum] [failure v:datum] [has-failure i32]) -> v:datum
  (rt:hash-update-value! t (dup-value k) updater failure has-failure '"hash-update!")
  '#f)
(#%fact hash-update* '(foreign owned))
(#%fact hash-update* '(raises))

(scheme-define hash-update! #:borrow (t k updater)
  (scheme-case-lambda
    [(t k updater) (hash-update* t k updater '#f 0)]
    [(t k updater failure) (hash-update* t k updater failure 1)]))

(scheme-define (hash-remove! t k) #:borrow (t k) (rt:hash-remove! t k '"hash-remove!") '#f)
(scheme-define (hash-clear! t) #:borrow (t) (rt:hash-clear! t '"hash-clear!") '#f)
(scheme-define (hash-keys t) #:borrow (t) (rt:table-walk t 0 '"hash-keys"))
(scheme-define (hash-values t) #:borrow (t) (rt:table-walk t 1 '"hash-values"))
(scheme-define (hash->list t) #:borrow (t) (rt:table-walk t 2 '"hash->list"))

(define (hash-for-each* [t v:datum] [f v:datum]) -> v:datum
  (let ([l (rt:table-walk t 2 '"hash-for-each")] [p v:datum 0])
    (set! p l)
    (try (wasm:block done
           (wasm:loop next
             (wasm:br-if done (wasm:i32.eqz (v:pair-cell? p)))
             (drop-value (rt:call-closure f 2 (dup-value (v:pair-car (v:pair-car p))) (dup-value (v:pair-cdr (v:pair-car p))) 0 0))
             (set! p (v:pair-cdr p))
             (wasm:br next)))
      [catch rt:exn (v) (drop-value l) (throw rt:exn v)])
    (drop-value l)
    '#f))
(#%fact hash-for-each* '(foreign owned))
(#%fact hash-for-each* '(raises))

(scheme-define (hash-for-each t f) #:borrow (t f) (hash-for-each* t f))

;; ---- exceptions ----

(scheme-define (raise v) (rt:raise-value v))
(scheme-define (call-with-handlers preds procs thunk) #:borrow (preds procs thunk) (rt:call-with-handlers preds procs thunk))
(scheme-define (dynamic-wind pre thunk post) #:borrow (pre thunk post) (rt:dynamic-wind pre thunk post))
(scheme-define (exn? v) #:free #:borrow (v) (bool (rt:exn? v)))
(scheme-define (exn-message v) #:borrow (v) (rt:exn-message v))

;; ---- output and errors ----

(scheme-define write #:borrow (x)
  (scheme-case-lambda
    [(x) (rt:write-to-port x (rt:stdout-port) 0) '#f]
    [(x p) (rt:write-to-port x (rt:port-arg p '"write") 0) '#f]))
(scheme-define display #:borrow (x)
  (scheme-case-lambda
    [(x) (rt:write-to-port x (rt:stdout-port) 1) '#f]
    [(x p) (rt:write-to-port x (rt:port-arg p '"display") 1) '#f]))
(scheme-define newline
  (scheme-case-lambda
    [() (rt:write-byte-to (rt:stdout-port) 10) (rt:port-flush (rt:stdout-port)) '#f]
    [(p) (rt:port-arg p '"newline") (rt:write-byte-to p 10) (rt:port-flush p) '#f]))

(scheme-define (interaction-value v) #:borrow (v)
  (if (wasm:i32.eqz (rt:line-start?)) (rt:write-byte-to (rt:stdout-port) 10))
  (rt:write-value-to (rt:stdout-port) v 0)
  (rt:write-byte-to (rt:stdout-port) 10)
  (rt:port-flush (rt:stdout-port))
  '#f)

(define (write-byte* [b v:datum] [p v:datum]) -> v:datum
  (rt:write-byte-to p (rt:byte-arg b '"write-byte"))
  (rt:port-flush p)
  '#f)
(#%fact write-byte* '(foreign owned))

(define (write-bytes* [v v:datum] [p v:datum]) -> v:datum
  (rt:write-to-port (rt:bytes-arg v '"write-bytes") p 1)
  '#f)
(#%fact write-bytes* '(foreign owned))

(scheme-define write-byte #:borrow (b p)
  (scheme-case-lambda
    [(b p) (write-byte* b (rt:port-arg p '"write-byte"))]
    [(b) (write-byte* b (rt:stdout-port))]))
(scheme-define write-bytes #:borrow (v p)
  (scheme-case-lambda
    [(v p) (write-bytes* v (rt:port-arg p '"write-bytes"))]
    [(v) (write-bytes* v (rt:stdout-port))]))

(scheme-define (open-output-bytes) (rt:new-port -1))
(scheme-define (get-output-bytes p) #:borrow (p) (rt:port-bytes (rt:port-arg p '"get-output-bytes")))
(scheme-define (file-position p) #:borrow (p) (fix (rt:port-length (rt:port-arg p '"file-position"))))

(define (call-with-output-bytes* [proc v:datum]) -> v:datum
  (let ([p (rt:new-port -1)])
    (drop-value (try (rt:call-closure proc 1 (dup-value p) 0 0 0)
                     [catch rt:exn (v) (drop-value p) (throw rt:exn v)]))
    (let ([r (rt:port-bytes p)])
      (drop-value p)
      r)))
(#%fact call-with-output-bytes* '(foreign owned))
(#%fact call-with-output-bytes* '(raises))

(scheme-define (call-with-output-bytes proc) #:borrow (proc) (call-with-output-bytes* proc))

(scheme-define (format form . args) (rt:format-value form args))
(scheme-define (printf form . args) (rt:write-format-to (rt:stdout-port) '"printf" form args) '#f)
(scheme-define (eprintf form . args) (rt:write-format-to (rt:stderr-port) '"eprintf" form args) '#f)

(scheme-define (error first . rest) (rt:error-value first rest))

;; ---- the host: files, the command line, instantiating code ----

(scheme-define (file->bytes path) #:borrow (path) (rt:file->bytes path))
(scheme-define (file-exists? path) #:free #:borrow (path) (bool (rt:file-exists? path)))
(scheme-define (file->string path) #:borrow (path) (rt:file->string path))
(scheme-define (display-to-file v path) #:borrow (v path) (rt:display-to-file v path))
(scheme-define (current-command-line-arguments) (rt:command-line-arguments))
(scheme-define instantiate #:borrow (name code imports)
  (scheme-case-lambda
    [(name code imports) (rt:instantiate-code name code imports)]
    [(name code) (rt:instantiate-code name code '())]))
(scheme-define exit
  (scheme-case-lambda
    [() (rt:exit-with '0) '#f]
    [(v) (rt:exit-with v) '#f]))
