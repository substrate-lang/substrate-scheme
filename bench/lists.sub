;; Lists built, mapped, filtered, folded, sorted, searched and dropped.
(language scheme "../../lib/scheme/scheme.sub")

(define (range n) (let loop ([i (- n 1)] [acc '()]) (if (< i 0) acc (loop (- i 1) (cons i acc)))))

(define (round xs)
  (let* ([ys (map (lambda (x) (+ x 1)) xs)]
         [zs (filter (lambda (x) (= (remainder x 3) 0)) ys)]
         [total (foldl + 0 zs)]
         [sorted (sort (reverse zs) <)]
         [found (assq 'c (list (cons 'a 1) (cons 'b 2) (cons 'c total)))])
    (+ (length sorted) (cdr found) (car (list-tail sorted (quotient (length sorted) 2))))))

(define (main)
  (let ([xs (range 20000)])
    (let loop ([i 0] [acc 0])
      (if (< i 60)
          (loop (+ i 1) (+ acc (round xs)))
          (begin (display acc) (newline))))))
