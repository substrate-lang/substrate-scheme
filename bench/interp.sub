;; A tiny interpreter: assoc-list environments, closures as lists.
(language scheme "../../lib/languages/scheme/scheme.sub")
(define (lookup x env)
  (let ([p (assq x env)]) (if p (cdr p) (error 'lookup "unbound ~s" x))))
(define (ev e env)
  (cond [(number? e) e]
        [(symbol? e) (lookup e env)]
        [(eq? (car e) 'quote) (cadr e)]
        [(eq? (car e) 'if) (if (ev (cadr e) env) (ev (caddr e) env) (ev (cadddr e) env))]
        [(eq? (car e) 'lambda) (list 'closure (cadr e) (caddr e) env)]
        [else (ap (ev (car e) env) (map (lambda (a) (ev a env)) (cdr e)))]))
(define (ap f args)
  (if (procedure? f) (apply f args) (ev (caddr f) (bind (cadr f) args (cadddr f)))))
(define (bind ps as env)
  (if (null? ps) env (bind (cdr ps) (cdr as) (cons (cons (car ps) (car as)) env))))
(define global (list (cons '+ +) (cons '- -) (cons '< <) (cons '* *)))
(define prog '((lambda (fib) (fib fib 27))
               (lambda (self n) (if (< n 2) n (+ (self self (- n 1)) (self self (- n 2)))))))
(define (main) (display (ev prog global)) (newline))
